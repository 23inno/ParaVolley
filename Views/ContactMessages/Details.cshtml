@model ContactMessage

@{
    ViewData["Title"] = "Contact Message";

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows()
            ? "South Africa Standard Time"
            : "Africa/Johannesburg");

    var submittedSa = TimeZoneInfo
        .ConvertTimeFromUtc(Model.SubmittedAtUtc, saTimeZone)
        .ToString("dd MMMM yyyy 'at' HH:mm");
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <a asp-controller="ContactMessages"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Messages

        </a>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-4">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                <div>

                    <span class="badge bg-success mb-2">
                        @Model.Subject
                    </span>

                    <h2 class="fw-bold mb-1">
                        @Model.Name
                    </h2>

                    <p class="text-muted mb-0">
                        Submitted
                        @submittedSa
                    </p>

                </div>

                <div>

                    @if (Model.EmailSent)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle-fill me-1"></i>
                            Message Saved · Email Notification Sent
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Message Saved · Email Notification Unavailable
                        </span>
                    }
}

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="text-muted small">
                        EMAIL ADDRESS
                    </label>

                    <div class="fw-semibold">

                        <a href="mailto:@Model.Email">
                            @Model.Email
                        </a>

                    </div>

                </div>


                <div class="col-md-6">

                    <label class="text-muted small">
                        PHONE NUMBER
                    </label>

                    <div class="fw-semibold">

                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                        {
                            <a href="tel:@Model.Phone">
                                @Model.Phone
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                </div>


                <div class="col-12">

                    <hr />

                    <label class="text-muted small mb-2">
                        MESSAGE
                    </label>

                    <div class="p-4 bg-light rounded">

                        <p class="mb-0"
                           style="white-space: pre-wrap;">@Model.Message</p>

                    </div>

                </div>

            </div>

        </div>


        <div class="card-footer bg-white py-3">

            <a href="mailto:@Model.Email?subject=Re:%20@Uri.EscapeDataString(Model.Subject)"
               class="btn btn-success">

                <i class="bi bi-reply-fill me-1"></i>
                Reply by Email

            </a>

        </div>

    </div>

</div>