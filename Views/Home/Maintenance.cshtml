@model OrganisationSettings
@{
    ViewData["Title"] = "Maintenance";
}

<div class="container py-5">
    <div class="row justify-content-center py-5">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm text-center p-4 p-md-5">
                <div class="mb-3" style="font-size:3rem;color:#0B6E4F;">
                    <i class="bi bi-tools"></i>
                </div>

                <h1 class="fw-bold mb-3">We'll be back shortly</h1>
                <p class="lead text-muted mb-4">
                    @Model.MaintenanceMessage
                </p>

                <div class="small text-muted">
                    @if (!string.IsNullOrWhiteSpace(Model.OfficeLocation))
                    {
                        <div><i class="bi bi-geo-alt me-1"></i>@Model.OfficeLocation</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OfficialEmail))
                    {
                        <div class="mt-2">
                            <i class="bi bi-envelope me-1"></i>
                            <a href="mailto:@Model.OfficialEmail">@Model.OfficialEmail</a>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OfficialPhone))
                    {
                        <div class="mt-2"><i class="bi bi-telephone me-1"></i>@Model.OfficialPhone</div>
                    }
                </div>

                <div class="mt-4">
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary btn-sm">
                        Admin Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
