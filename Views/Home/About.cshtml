@{
    ViewData["Title"] = "About Us";
}

<div class="about-page">

    <!-- =========================
         HERO SECTION
    ========================== -->

    <section class="about-hero-modern">

        <div class="container">

            <div class="about-hero-grid">

                <!-- LEFT: Hero Content -->
                <div class="about-hero-content">

                    <span class="about-hero-label">
                        ABOUT PARAVOLLEY MPUMALANGA
                    </span>

                    <h1>
                        Sport Without
                        <span>Barriers.</span>
                    </h1>

                    <p>
                        ParaVolley Mpumalanga is committed to creating inclusive
                        sporting opportunities where athletes can develop their
                        abilities, build confidence and experience the power of
                        competition and community.
                    </p>

                    <div class="about-hero-actions">

                        <a href="#who-we-are"
                           class="btn btn-pv-gold">
                            <i class="bi bi-arrow-down-circle-fill me-2"></i>
                            Learn More
                        </a>

                        <a asp-controller="Home"
                           asp-action="Contact"
                           asp-fragment="send-message"
                           class="btn btn-about-outline">
                            <i class="bi bi-people-fill me-2"></i>
                            Get Involved
                        </a>

                    </div>

                </div>

                <!-- RIGHT: About Hero Slideshow -->
                <div class="about-hero-slider">

                    <div class="about-slide active">
                        <img src="~/images/about-slide-1.png"
                             asp-append-version="true"
                             alt="ParaVolley Mpumalanga athletes playing sitting volleyball" />
                    </div>

                    <div class="about-slide">
                        <img src="~/images/about-slide-2.png"
                             asp-append-version="true"
                             alt="ParaVolley athletes during training" />
                    </div>

                    <div class="about-slide">
                        <img src="~/images/about-slide-3.png"
                             asp-append-version="true"
                             alt="ParaVolley Mpumalanga community and athletes" />
                    </div>

                    <!-- Previous Button -->
                    <button type="button"
                            class="about-slider-button about-slider-prev"
                            aria-label="Previous image">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <!-- Next Button -->
                    <button type="button"
                            class="about-slider-button about-slider-next"
                            aria-label="Next image">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <!-- Slide Indicators -->
                    <div class="about-slider-dots">

                        <button type="button"
                                class="about-slider-dot active"
                                aria-label="Show slide 1"></button>

                        <button type="button"
                                class="about-slider-dot"
                                aria-label="Show slide 2"></button>

                        <button type="button"
                                class="about-slider-dot"
                                aria-label="Show slide 3"></button>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         WHO WE ARE
    ========================== -->
    <section id="who-we-are" class="about-modern-section about-who-section">
        <div class="container">

            <div class="about-modern-heading">
                <span class="about-modern-label">WHO WE ARE</span>

                <h2>
                    Creating Opportunities
                    <span>Through Sport</span>
                </h2>

                <div class="about-modern-line"></div>
            </div>

            <div class="row align-items-center g-5">

                <div class="col-lg-7">
                    <div class="about-story-content">

                        <p class="about-story-lead">
                            ParaVolley Mpumalanga is a sporting organisation committed
                            to creating meaningful opportunities for athletes with
                            disabilities to participate, develop and excel in volleyball.
                        </p>

                        <p>
                            Through training, competitions, coaching and community
                            engagement, we aim to create an environment where every
                            athlete can develop their abilities, build confidence and
                            experience the benefits of sport.
                        </p>

                        <p>
                            Our work is built around inclusion, teamwork, discipline
                            and the belief that disability should never prevent an
                            athlete from pursuing their sporting dreams.
                        </p>

                        <div class="about-story-points">

                            <div class="about-story-point">
                                <div class="about-story-point-icon">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div>
                                    <strong>Inclusive Participation</strong>
                                    <span>Sporting opportunities for everyone</span>
                                </div>
                            </div>

                            <div class="about-story-point">
                                <div class="about-story-point-icon">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <div>
                                    <strong>Athlete Development</strong>
                                    <span>Supporting athletes to reach their potential</span>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <div class="col-lg-5">

                    <div class="about-feature-card">

                        <div class="about-feature-icon">
                            <i class="bi bi-universal-access"></i>
                        </div>

                        <span class="about-feature-label">
                            OUR BELIEF
                        </span>

                        <h3>
                            <span class="who-sport-white">Sport Without</span>
                            <span>Barriers.</span>
                        </h3>

                        <p>
                            Everyone deserves the opportunity to participate in sport,
                            develop their talents and belong to a supportive sporting
                            community.
                        </p>

                        <div class="about-feature-footer">
                            <i class="bi bi-arrow-right-circle-fill"></i>
                            <span>Inclusion through sport</span>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </section>


    <!-- =========================
         MISSION & VISION
    ========================== -->
    <section class="about-purpose-section">

        <div class="container">

            <div class="about-modern-heading centered-heading light-heading">
                <span class="about-modern-label">OUR PURPOSE</span>

                <h2>
                    What Drives
                    <span>Our Work</span>
                </h2>

                <div class="about-modern-line"></div>
            </div>

            <div class="row g-4">

                <!-- Mission -->
                <div class="col-lg-6">

                    <div class="about-purpose-card">

                        <div class="about-purpose-top">
                            <div class="about-purpose-icon">
                                <i class="bi bi-bullseye"></i>
                            </div>

                            <span>OUR MISSION</span>
                        </div>

                        <h3>
                            <span class="mission-white-text">Creating Opportunities</span>
                            <span>Through Sport</span>
                        </h3>

                        <p>
                            To promote and develop ParaVolley in Mpumalanga by
                            providing athletes with opportunities to train, compete,
                            develop their skills and participate meaningfully in
                            their communities.
                        </p>

                        <div class="about-card-number">01</div>

                    </div>

                </div>

                <!-- Vision -->
                <div class="col-lg-6">

                    <div class="about-purpose-card about-purpose-card-gold">

                        <div class="about-purpose-top">
                            <div class="about-purpose-icon">
                                <i class="bi bi-eye-fill"></i>
                            </div>

                            <span>OUR VISION</span>
                        </div>

                        <h3>
                            A More Inclusive
                            <span>Sporting Community</span>
                        </h3>

                        <p>
                            To build a recognised and sustainable ParaVolley
                            community where athletes with disabilities are
                            empowered to reach their full sporting potential
                            and inspire future generations.
                        </p>

                        <div class="about-card-number">02</div>

                    </div>

                </div>

            </div>

        </div>

    </section>


