@{
ViewData["Title"] = "About Us";
}

<div class="about-page">

<!-- Hero Section -->
<section class="about-hero">
    <div class="about-hero-content">
        <span class="about-eyebrow">PARAVOLLEY MPUMALANGA</span>

        <h1>Empowering Athletes.<br />
            <span>Building Champions.</span>
        </h1>

        <p>
            Promoting inclusive sport, developing athletes and creating
            opportunities for people with disabilities through ParaVolley.
        </p>

        <div class="about-hero-actions">
            <a href="#who-we-are" class="btn btn-pv-gold">Discover Our Story</a>
            <a href="#get-involved" class="btn btn-about-outline">Get Involved</a>
        </div>
    </div>

    <div class="about-hero-decoration">
        <div class="about-ball"><i class="bi bi-trophy-fill"></i></div>
    </div>
</section>

<!-- Who We Are -->
<section id="who-we-are" class="about-section">
    <div class="about-section-heading">
        <span class="about-section-label">WHO WE ARE</span>
        <h2>About ParaVolley Mpumalanga</h2>
        <div class="about-heading-line"></div>
    </div>

    <div class="about-two-column">
        <div>
            <p class="about-lead">ParaVolley Mpumalanga is a sporting organisation committed to creating opportunities for athletes with disabilities to participate, develop and excel in volleyball.</p>
            <p>Through training, competitions, coaching and community engagement, we aim to create an environment where every athlete can develop their abilities, build confidence and experience the benefits of sport.</p>
            <p>Our work is built around inclusion, teamwork, discipline and the belief that disability should never prevent an athlete from pursuing their sporting dreams.</p>
        </div>
        <div class="about-highlight-card">
            <div class="about-highlight-icon"><i class="bi bi-universal-access"></i></div>
            <h3>Sport Without Barriers</h3>
            <p>We believe that everyone deserves the opportunity to participate in sport, develop their talents and belong to a supportive sporting community.</p>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="about-mission-section">
    <div class="about-mission-card">
        <div class="about-card-icon"><i class="bi bi-bullseye"></i></div>
        <span>OUR MISSION</span>
        <h3>Creating Opportunities Through Sport</h3>
        <p>To promote and develop ParaVolley in Mpumalanga by providing athletes with opportunities to train, compete, develop their skills and participate meaningfully in their communities.</p>
    </div>
    <div class="about-vision-card">
        <div class="about-card-icon gold-icon"><i class="bi bi-eye-fill"></i></div>
        <span>OUR VISION</span>
        <h3>A More Inclusive Sporting Community</h3>
        <p>To build a recognised and sustainable ParaVolley community where athletes with disabilities are empowered to reach their full sporting potential and inspire future generations.</p>
    </div>
</section>

<!-- Values -->
<section class="about-section about-values-section">
    <div class="about-section-heading">
        <span class="about-section-label">WHAT GUIDES US</span>
        <h2>Our Core Values</h2>
        <div class="about-heading-line"></div>
    </div>
    <div class="about-values-grid">
        <div class="about-value-card"><div class="value-icon"><i class="bi bi-people-fill"></i></div><h3>Inclusion</h3><p>Creating an environment where every athlete feels welcomed, respected and valued.</p></div>
        <div class="about-value-card"><div class="value-icon"><i class="bi bi-heart-fill"></i></div><h3>Passion</h3><p>Encouraging athletes and volunteers to pursue sport with commitment, enthusiasm and purpose.</p></div>
        <div class="about-value-card"><div class="value-icon"><i class="bi bi-shield-check"></i></div><h3>Integrity</h3><p>Promoting honesty, fairness, accountability and respect throughout our sporting community.</p></div>
        <div class="about-value-card"><div class="value-icon"><i class="bi bi-people"></i></div><h3>Teamwork</h3><p>Working together to support athletes, coaches, volunteers and the wider community.</p></div>
    </div>
</section>

<!-- What We Do -->
<section class="about-activities-section">
    <div class="about-section-heading light-heading">
        <span class="about-section-label">OUR WORK</span><h2>What We Do</h2><div class="about-heading-line"></div>
    </div>
    <div class="about-activities-grid">
        <div class="about-activity"><i class="bi bi-person-arms-up"></i><h3>Athlete Development</h3><p>Supporting athletes as they develop their volleyball skills, confidence and competitive abilities.</p></div>
        <div class="about-activity"><i class="bi bi-person-video3"></i><h3>Training & Coaching</h3><p>Providing structured training and coaching opportunities to help athletes improve their performance.</p></div>
        <div class="about-activity"><i class="bi bi-trophy"></i><h3>Competitions</h3><p>Creating opportunities for athletes and teams to compete and showcase their talent.</p></div>
        <div class="about-activity"><i class="bi bi-globe-africa"></i><h3>Community Development</h3><p>Using sport as a platform to promote inclusion, participation and positive community development.</p></div>
    </div>
</section>

<!-- Why ParaVolley -->
<section class="about-section">
    <div class="about-two-column about-why">
        <div>
            <span class="about-section-label">WHY PARAVOLLEY?</span>
            <h2>More Than Just A Sport</h2>
            <p>ParaVolley creates opportunities that extend beyond the volleyball court. It helps athletes develop confidence, friendships, leadership skills, discipline and a strong sense of belonging.</p>
            <p>By growing ParaVolley in Mpumalanga, we are working towards a sporting environment where athletes with disabilities are visible, supported and given the opportunity to succeed.</p>
        </div>
        <div class="about-stat-panel">
            <div class="about-stat"><i class="bi bi-universal-access"></i><div><strong>Inclusive</strong><span>Sporting opportunities</span></div></div>
            <div class="about-stat"><i class="bi bi-trophy"></i><div><strong>Competitive</strong><span>Athlete development</span></div></div>
            <div class="about-stat"><i class="bi bi-people-fill"></i><div><strong>Community</strong><span>Stronger together</span></div></div>
        </div>
    </div>
</section>

<!-- Get Involved -->
<section id="get-involved" class="about-cta">
    <div>
        <span class="about-section-label">JOIN THE MOVEMENT</span>
        <h2>Be Part of the ParaVolley Community</h2>
        <p>Whether you are an athlete, coach, volunteer, supporter or community member, there is a place for you in our journey.</p>
    </div>
    <div class="about-cta-actions">
        <a href="/Home/Contact" class="btn btn-pv-gold">Contact Us</a>
        <a href="/Home/Index" class="btn btn-about-outline">Explore ParaVolley</a>
    </div>
</section>

</div>
