<!-- =========================================
     UPCOMING EVENTS + LATEST NEWS
     REAL DATABASE DATA
========================================= -->
<section class="home-dynamic-section">

    <div class="container">

        <div class="home-section-heading text-center">

            <span class="home-section-label">
                STAY CONNECTED
            </span>

            <h2 class="home-section-title">
                Latest From
                <span>ParaVolley.</span>
            </h2>

            <p>
                Keep up with upcoming activities, competitions and
                announcements from ParaVolley Mpumalanga.
            </p>

        </div>


        <div class="row g-4">

            <!-- Upcoming Events -->
            <div class="col-lg-6">

                <div class="home-dynamic-card h-100">

                    <div class="home-dynamic-header">

                        <div>
                            <span class="home-dynamic-label">
                                SCHEDULE
                            </span>

                            <h3>
                                Upcoming Events
                            </h3>
                        </div>

                        <div class="home-dynamic-header-icon">
                            <i class="bi bi-calendar-event-fill"></i>
                        </div>

                    </div>


                    @if (events.Any())
                    {
                        <div class="home-dynamic-list">

                            @foreach (var item in events)
                            {
                                <div class="home-event-item">

                                    <div class="home-event-date">

                                        <span>
                                            @item.Date.ToString("dd")
                                        </span>

                                        <strong>
                                            @item.Date.ToString("MMM")
                                        </strong>

                                    </div>

                                    <div class="home-event-content">

                                        <h4>
                                            @item.Title
                                        </h4>

                                        <div class="home-event-meta">

                                            <span>
                                                <i class="bi bi-calendar3"></i>
                                                @item.Date.ToString("d MMM yyyy")
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(item.Location))
                                            {
                                                <span>
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                    @item.Location
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="home-empty-state">

                            <i class="bi bi-calendar2-x"></i>

                            <h4>
                                No Upcoming Events
                            </h4>

                            <p>
                                New events will appear here once they
                                have been published.
                            </p>

                        </div>
                    }


                    <div class="home-dynamic-footer">

                        <a asp-controller="Events"
                           asp-action="Index"
                           class="home-green-btn">

                            View All Events
                            <i class="bi bi-arrow-right ms-2"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- Latest News -->
            <div class="col-lg-6">

                <div class="home-dynamic-card h-100">

                    <div class="home-dynamic-header">

                        <div>
                            <span class="home-dynamic-label">
                                NEWS
                            </span>

                            <h3>
                                Latest Announcements
                            </h3>
                        </div>

                        <div class="home-dynamic-header-icon">
                            <i class="bi bi-megaphone-fill"></i>
                        </div>

                    </div>


                    @if (news.Any())
                    {
                        <div class="home-dynamic-list">

                            @foreach (var item in news)
                            {
                                var modalId = $"announcementModal{item.Id}";

                                <button type="button"
                                        class="home-news-item border-0 text-start w-100 bg-transparent"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">

                                    <div class="home-news-icon">
                                        <i class="bi bi-newspaper"></i>
                                    </div>

                                    <div class="home-news-content">

                                        <span class="home-news-date">
                                            @item.Date.ToString("d MMM yyyy")
                                        </span>

                                        <h4>
                                            @item.Title
                                        </h4>

                                        <span class="home-news-link">
                                            Read Announcement
                                            <i class="bi bi-arrow-right"></i>
                                        </span>

                                    </div>

                                </button>


                                <!-- Announcement Details Modal -->
                                <div class="modal fade"
                                     id="@modalId"
                                     tabindex="-1"
                                     aria-labelledby="@($"{modalId}Label")"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered modal-lg">

                                        <div class="modal-content home-announcement-modal">

                                            <div class="modal-header">

                                                <div>

                                                    <span class="home-announcement-modal-label">
                                                        @item.Category
                                                    </span>

                                                    <h5 class="modal-title"
                                                        id="@($"{modalId}Label")">

                                                        @item.Title

                                                    </h5>

                                                </div>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Close">
                                                </button>

                                            </div>


                                            <div class="modal-body">

                                                <div class="home-announcement-meta">

                                                    <span>
                                                        <i class="bi bi-calendar3 me-1"></i>
                                                        @item.Date.ToString("d MMMM yyyy")
                                                    </span>

                                                    @if (!string.IsNullOrWhiteSpace(item.Author))
                                                    {
                                                        <span>
                                                            <i class="bi bi-person-fill me-1"></i>
                                                            @item.Author
                                                        </span>
                                                    }

                                                    @if (item.IsPinned)
                                                    {
                                                        <span class="home-announcement-pinned">
                                                            <i class="bi bi-pin-angle-fill me-1"></i>
                                                            Pinned
                                                        </span>
                                                    }

                                                </div>


                                                <div class="home-announcement-text">

                                                    @if (!string.IsNullOrWhiteSpace(item.Excerpt))
                                                    {
                                                        <p>
                                                            @item.Excerpt
                                                        </p>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted mb-0">
                                                            No additional announcement details are available.
                                                        </p>
                                                    }

                                                </div>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">

                                                    Close

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="home-empty-state">

                            <i class="bi bi-megaphone"></i>

                            <h4>
                                No Announcements Yet
                            </h4>

                            <p>
                                The latest ParaVolley news and
                                announcements will appear here.
                            </p>

                        </div>
                    }


                    <div class="home-dynamic-footer">

                        <a asp-controller="Announcements"
                           asp-action="Index"
                           class="home-green-btn">

                            View All News
                            <i class="bi bi-arrow-right ms-2"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


