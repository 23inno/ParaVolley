@{
    ViewData["Title"] = "Home";

    var events = (List<Event>)ViewBag.UpcomingEvents;
    var news = (List<Announcement>)ViewBag.RecentAnnouncements;
    var sponsors = (List<Sponsor>)ViewBag.Sponsors;
}

<!-- =========================================
     HERO BANNER
     ========================================= -->


<section class="paravolley-hero">
    <div class="container-fluid px-0">
        <div class="paravolley-hero-image-wrapper">
            <img src="~/images/home/paravolley-hero.png"
                 alt="ParaVolley Mpumalanga seated volleyball athletes"
                 class="paravolley-hero-image" />
        </div>
    </div>
</section>

<!-- Contact / Social Links -->
<section class="paravolley-contact-bar">
    <div class="container">
        <div class="row align-items-center justify-content-center g-3">

            <div class="col-md-4 text-center">
                <a href="mailto:paravolleympumalanga@gmail.com"
                   class="paravolley-contact-link">
                    <span class="contact-icon">✉</span>
                    <span>
                        <strong>Email Us</strong><br />
                        paravolleympumalanga@gmail.com
                    </span>
                </a>
            </div>

            <div class="col-md-4 text-center">
                <a href="https://paravolley-production.up.railway.app/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="paravolley-contact-link">
                    <span class="contact-icon">🌐</span>
                    <span>
                        <strong>Visit Our Website</strong><br />
                        ParaVolley Mpumalanga
                    </span>
                </a>
            </div>

            <div class="col-md-4 text-center">
                <a href="https://www.facebook.com/profile.php?id=61571467720896"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="paravolley-contact-link">
                    <span class="contact-icon">f</span>
                    <span>
                        <strong>Follow Us on Facebook</strong><br />
                        ParaVolley Mpumalanga
                    </span>
                </a>
            </div>

        </div>
    </div>
</section>


<!-- =========================================
     WELCOME SECTION
     ========================================= -->

<section class="container py-5">

    <div class="row align-items-center g-4">

        <div class="col-lg-8">

            <p class="text-uppercase fw-bold mb-2"
               style="color: var(--pv-green);">
                Welcome to ParaVolley Mpumalanga
            </p>

            <h2 class="display-6 fw-bold">
                Sport. Inclusion. Community.
            </h2>

            <p class="lead text-muted">
                ParaVolley Mpumalanga promotes opportunities for people with
                disabilities to participate in volleyball, develop their skills,
                compete at different levels and become part of a supportive
                sporting community.
            </p>

            <p class="text-muted">
                Through athlete development, competitions, coaching and community
                programmes, we work to create an environment where everyone has
                the opportunity to play, compete and belong.
            </p>

            <div class="mt-4">

                <a asp-controller="Home"
                   asp-action="About"
                   class="btn btn-success fw-semibold me-2">
                    Learn More About Us
                </a>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-warning fw-semibold">
                    View Events
                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     WHAT WE DO
     ========================================= -->

<section class="py-5"
         style="background-color: #f7f9f8;">

    <div class="container">

        <div class="text-center mb-5">

            <p class="text-uppercase fw-bold mb-2"
               style="color: var(--pv-green);">
                What We Do
            </p>

            <h2 class="fw-bold">
                Creating Opportunities Through Sport
            </h2>

            <p class="text-muted mx-auto"
               style="max-width: 700px;">
                ParaVolley Mpumalanga supports athletes, coaches and volunteers
                while promoting participation, development and inclusion through
                seated volleyball.
            </p>

        </div>


        <div class="row g-4">

            <!-- Athlete Development -->

            <div class="col-md-6 col-lg-3">

                <div class="pv-card h-100 text-center p-4">

                    <div class="mb-3">

                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                              style="width: 70px;
                                     height: 70px;
                                     background-color: #0B6E4F;
                                     color: #FFC72C;
                                     font-size: 30px;">
                            🏐
                        </span>

                    </div>

                    <h3 class="h5 fw-bold">
                        Athlete Development
                    </h3>

                    <p class="text-muted mb-0">
                        Helping athletes develop their volleyball skills,
                        confidence and competitive experience.
                    </p>

                </div>

            </div>


            <!-- Competitions -->

            <div class="col-md-6 col-lg-3">

                <div class="pv-card h-100 text-center p-4">

                    <div class="mb-3">

                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                              style="width: 70px;
                                     height: 70px;
                                     background-color: #0B6E4F;
                                     color: #FFC72C;
                                     font-size: 30px;">
                            🏆
                        </span>

                    </div>

                    <h3 class="h5 fw-bold">
                        Competitions
                    </h3>

                    <p class="text-muted mb-0">
                        Creating opportunities for athletes to participate
                        in matches, tournaments and sporting events.
                    </p>

                </div>

            </div>


            <!-- Coaching -->

            <div class="col-md-6 col-lg-3">

                <div class="pv-card h-100 text-center p-4">

                    <div class="mb-3">

                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                              style="width: 70px;
                                     height: 70px;
                                     background-color: #0B6E4F;
                                     color: #FFC72C;
                                     font-size: 30px;">
                            👥
                        </span>

                    </div>

                    <h3 class="h5 fw-bold">
                        Coaches & Volunteers
                    </h3>

                    <p class="text-muted mb-0">
                        Supporting coaches and volunteers who contribute
                        to athlete development and ParaVolley programmes.
                    </p>

                </div>

            </div>


            <!-- Community -->

            <div class="col-md-6 col-lg-3">

                <div class="pv-card h-100 text-center p-4">

                    <div class="mb-3">

                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle"
                              style="width: 70px;
                                     height: 70px;
                                     background-color: #0B6E4F;
                                     color: #FFC72C;
                                     font-size: 30px;">
                            🤝
                        </span>

                    </div>

                    <h3 class="h5 fw-bold">
                        Community
                    </h3>

                    <p class="text-muted mb-0">
                        Building an inclusive sporting community where
                        athletes can play, compete and belong.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     UPCOMING EVENTS + LATEST NEWS
     ========================================= -->

<section class="container py-5">

    <div class="row g-4">

        <!-- Upcoming Events -->

        <div class="col-lg-6">

            <div class="pv-card h-100 p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h2 class="h4 fw-bold mb-0">
                        Upcoming Events
                    </h2>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="small fw-semibold"
                       style="color: var(--pv-green);">
                        View All
                    </a>

                </div>


                @foreach (var item in events)
                {
                    <div class="border-bottom py-3">

                        <h3 class="h6 fw-bold mb-1">
                            @item.Title
                        </h3>

                        <div class="text-muted small">
                            @item.Date.ToString("d MMM yyyy")
                            ·
                            @item.Location
                        </div>

                    </div>
                }


                @if (!events.Any())
                {
                    <div class="py-4 text-center">

                        <p class="text-muted mb-0">
                            No upcoming events have been published.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- Latest News -->

        <div class="col-lg-6">

            <div class="pv-card h-100 p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h2 class="h4 fw-bold mb-0">
                        Latest News
                    </h2>

                </div>


                @foreach (var item in news)
                {
                    <div class="border-bottom py-3">

                        <a asp-controller="Announcements"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="fw-semibold text-decoration-none">

                            @item.Title

                        </a>

                        <div class="text-muted small mt-1">
                            @item.Date.ToString("d MMM yyyy")
                        </div>

                    </div>
                }


                @if (!news.Any())
                {
                    <div class="py-4 text-center">

                        <p class="text-muted mb-0">
                            No news has been published.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     GET INVOLVED
     ========================================= -->

<section class="container pb-5">

    <div class="rounded-4 p-5 text-center text-white"
         style="background: linear-gradient(135deg, var(--pv-green), var(--pv-green-dark));">

        <h2 class="fw-bold">
            Get Involved With ParaVolley Mpumalanga
        </h2>

        <p class="lead mx-auto mb-4"
           style="max-width: 750px;">

            Whether you are an athlete, coach, volunteer, supporter or community
            member, there is a place for you in the ParaVolley Mpumalanga family.

        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="btn btn-warning btn-lg fw-bold">

            Contact Us

        </a>

    </div>

</section>


<!-- =========================================
     SPONSORS
     ========================================= -->

@if (sponsors.Any())
{
    <section class="py-5"
             style="background-color: #f7f9f8;">

        <div class="container text-center">

            <p class="text-uppercase fw-bold mb-2"
               style="color: var(--pv-green);">

                Supporting ParaVolley

            </p>

            <h2 class="h4 fw-bold mb-4">
                Our Sponsors & Partners
            </h2>

            <div class="d-flex flex-wrap justify-content-center gap-3">

                @foreach (var sponsor in sponsors)
                {
                    <div class="pv-card px-4 py-3">

                        <span class="fw-semibold">
                            @sponsor.Name
                        </span>

                    </div>
                }

            </div>

        </div>

    </section>
}


<!-- =========================================
     FINAL MESSAGE
     ========================================= -->

<section class="container py-5 text-center">

    <h2 class="fw-bold">
        Play. Compete. Belong.
    </h2>

    <p class="text-muted mx-auto"
       style="max-width: 700px;">

        ParaVolley Mpumalanga is committed to building a stronger,
        more inclusive sporting environment through seated volleyball.

    </p>

</section>
