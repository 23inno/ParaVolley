@model ContactMessage
@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-page">

    <!-- Contact Hero -->
    <section class="contact-hero">
        <div class="container">
            <div class="contact-hero-content text-center">

                <span class="contact-hero-icon">
                    <i class="bi bi-chat-dots-fill"></i>
                </span>

                <h1>Contact Us</h1>

                <p>
                    We'd love to hear from you. Get in touch with ParaVolley
                    Mpumalanga for enquiries, player registration, volunteering,
                    events, partnerships and general information.
                </p>

            </div>
        </div>
    </section>


    <!-- Contact Content -->
    <section class="contact-main-section">
        <div class="container">

            <div class="row g-4 g-lg-5">

                <!-- Contact Information -->
                <div class="col-lg-5">

                    <div class="contact-info-card">

                        <div class="contact-section-heading">

                            <span class="contact-heading-icon">
                                <i class="bi bi-info-circle-fill"></i>
                            </span>

                            <div>
                                <h2>Get In Touch</h2>
                                <p>We're here to help.</p>
                            </div>

                        </div>


                        <!-- Location -->
                        <div class="contact-info-item">

                            <div class="contact-info-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>

                            <div>
                                <h3>Location</h3>
                                <p>Mpumalanga, South Africa</p>
                            </div>

                        </div>


                        <!-- Email -->
                        <div class="contact-info-item">

                            <div class="contact-info-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </div>

                            <div>
                                <h3>Email</h3>

                                <a href="mailto:paravolleympumalanga@gmail.com">
                                    paravolleympumalanga@gmail.com
                                </a>
                            </div>

                        </div>


                        <!-- General Enquiries -->
                        <div class="contact-info-item">

                            <div class="contact-info-icon">
                                <i class="bi bi-question-circle-fill"></i>
                            </div>

                            <div>
                                <h3>General Enquiries</h3>

                                <p>
                                    Contact us for information about ParaVolley
                                    activities, participation, events,
                                    volunteering and partnerships.
                                </p>
                            </div>

                        </div>


                        <!-- Website -->
                        <div class="contact-info-item">

                            <div class="contact-info-icon">
                                <i class="bi bi-globe2"></i>
                            </div>

                            <div>
                                <h3>Website</h3>

                                <a href="https://paravolley-production.up.railway.app/"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Visit ParaVolley Mpumalanga
                                </a>
                            </div>

                        </div>


                        <div class="contact-info-note">

                            <i class="bi bi-heart-fill"></i>

                            <span>
                                Together, we can help grow inclusive volleyball
                                opportunities in Mpumalanga.
                            </span>

                        </div>


                        <!-- ParaVolley Slideshow -->
                        <div id="contactSlideshow"
                             class="carousel slide contact-slideshow"
                             data-bs-ride="carousel"
                             data-bs-interval="4000"
                             data-bs-wrap="true">

                            <!-- Indicators -->
                            <div class="carousel-indicators">

                                <button type="button"
                                        data-bs-target="#contactSlideshow"
                                        data-bs-slide-to="0"
                                        class="active"
                                        aria-current="true"
                                        aria-label="Slide 1">
                                </button>

                                <button type="button"
                                        data-bs-target="#contactSlideshow"
                                        data-bs-slide-to="1"
                                        aria-label="Slide 2">
                                </button>

                                <button type="button"
                                        data-bs-target="#contactSlideshow"
                                        data-bs-slide-to="2"
                                        aria-label="Slide 3">
                                </button>

                                <button type="button"
                                        data-bs-target="#contactSlideshow"
                                        data-bs-slide-to="3"
                                        aria-label="Slide 4">
                                </button>

                                <button type="button"
                                        data-bs-target="#contactSlideshow"
                                        data-bs-slide-to="4"
                                        aria-label="Slide 5">
                                </button>

                            </div>


                            <!-- Slides -->
                            <div class="carousel-inner">

                                <div class="carousel-item active">
                                    <img src="~/images/paravolley-1.png"
                                         asp-append-version="true"
                                         alt="ParaVolley Mpumalanga"
                                         class="d-block w-100" />
                                </div>

                                <div class="carousel-item">
                                    <img src="~/images/paravolley-2.png"
                                         asp-append-version="true"
                                         alt="ParaVolley Mpumalanga volleyball"
                                         class="d-block w-100" />
                                </div>

                                <div class="carousel-item">
                                    <img src="~/images/paravolley-3.png"
                                         asp-append-version="true"
                                         alt="ParaVolley Mpumalanga community"
                                         class="d-block w-100" />
                                </div>

                                <div class="carousel-item">
                                    <img src="~/images/paravolley-4.png"
                                         asp-append-version="true"
                                         alt="ParaVolley Mpumalanga athletes"
                                         class="d-block w-100" />
                                </div>

                                <div class="carousel-item">
                                    <img src="~/images/paravolley-5.png"
                                         asp-append-version="true"
                                         alt="ParaVolley Mpumalanga training"
                                         class="d-block w-100" />
                                </div>

                            </div>


                            <!-- Previous -->
                            <button class="carousel-control-prev"
                                    type="button"
                                    data-bs-target="#contactSlideshow"
                                    data-bs-slide="prev">

                                <span class="carousel-control-prev-icon"
                                      aria-hidden="true"></span>

                                <span class="visually-hidden">Previous</span>

                            </button>


                            <!-- Next -->
                            <button class="carousel-control-next"
                                    type="button"
                                    data-bs-target="#contactSlideshow"
                                    data-bs-slide="next">

                                <span class="carousel-control-next-icon"
                                      aria-hidden="true"></span>

                                <span class="visually-hidden">Next</span>

                            </button>

                        </div>

                    </div>

                </div>


                <!-- Send a Message -->
                <div class="col-lg-7">

                    <div id="send-message" class="contact-form-card">

                        <div class="contact-form-header">

                            <span class="contact-heading-icon">
                                <i class="bi bi-send-fill"></i>
                            </span>

                            <div>
                                <h2>Send Us a Message</h2>

                                <p>
                                    Complete the form below and we'll get back
                                    to you as soon as possible.
                                </p>
                            </div>

                        </div>


                        <form asp-controller="Home"
                              asp-action="Contact"
                              method="post"
                              id="contactForm">

                            @Html.AntiForgeryToken()

                            @if (TempData["ContactSuccess"] != null)
                            {
                                <div class="alert alert-success mb-4"
                                     role="alert">

                                    <i class="bi bi-check-circle-fill me-2"></i>

                                    @TempData["ContactSuccess"]

                                </div>
                            }

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <!-- Name -->
                            <div class="mb-4">

                                <label asp-for="Name" class="contact-form-label">
                                    Full Name
                                </label>

                                <div class="contact-input-wrapper">
                                    <i class="bi bi-person-fill"></i>

                                    <input asp-for="Name"
                                           class="form-control contact-input"
                                           placeholder="Enter your full name" />
                                </div>

                                <span asp-validation-for="Name"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Email -->
                            <div class="mb-4">

                                <label asp-for="Email" class="contact-form-label">
                                    Email Address
                                </label>

                                <div class="contact-input-wrapper">
                                    <i class="bi bi-envelope-fill"></i>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control contact-input"
                                           placeholder="Enter your email address" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Phone -->
                            <div class="mb-4">

                                <label asp-for="Phone" class="contact-form-label">
                                    Phone Number
                                    <span class="optional-label">(Optional)</span>
                                </label>

                                <div class="contact-input-wrapper">
                                    <i class="bi bi-telephone-fill"></i>

                                    <input asp-for="Phone"
                                           type="tel"
                                           class="form-control contact-input"
                                           placeholder="Enter your phone number" />
                                </div>

                                <span asp-validation-for="Phone"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Subject -->
                            <div class="mb-4">

                                <label asp-for="Subject" class="contact-form-label">
                                    Subject
                                </label>

                                <div class="contact-input-wrapper">
                                    <i class="bi bi-chat-square-text-fill"></i>

                                    <select asp-for="Subject"
                                            class="form-select contact-input">

                                        <option value="">
                                            Select an enquiry type
                                        </option>

                                        <option value="General Enquiry">
                                            General Enquiry
                                        </option>

                                        <option value="Player Registration">
                                            Player Registration
                                        </option>

                                        <option value="Volunteering">
                                            Volunteering
                                        </option>

                                        <option value="Events">
                                            Events
                                        </option>

                                        <option value="Partnership">
                                            Partnership
                                        </option>

                                        <option value="Other">
                                            Other
                                        </option>

                                    </select>
                                </div>

                                <span asp-validation-for="Subject"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Message -->
                            <div class="mb-4">

                                <label asp-for="Message" class="contact-form-label">
                                    Message
                                </label>

                                <div class="contact-textarea-wrapper">
                                    <i class="bi bi-pencil-square"></i>

                                    <textarea asp-for="Message"
                                              class="form-control contact-textarea"
                                              rows="6"
                                              placeholder="Write your message here..."></textarea>
                                </div>

                                <span asp-validation-for="Message"
                                      class="text-danger small"></span>

                            </div>


                            <!-- Privacy note -->
                            <div class="contact-form-note">

                                <i class="bi bi-shield-check"></i>

                                <span>
                                    Your information will only be used to respond
                                    to your enquiry.
                                </span>

                            </div>


                            <!-- Submit -->
                            <button type="submit"
                                    class="btn contact-submit-btn w-100">

                                <i class="bi bi-send-fill me-2"></i>

                                Send Message

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- Bottom CTA -->
    <section class="contact-bottom-section">

        <div class="container">

            <div class="contact-bottom-card">

                <div class="contact-bottom-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="contact-bottom-content">

                    <h2>Join the ParaVolley Community</h2>

                    <p>
                        Whether you are a player, coach, volunteer, supporter
                        or organisation, ParaVolley Mpumalanga welcomes
                        opportunities to connect and grow inclusive volleyball
                        in Mpumalanga.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="Join"
                   class="btn contact-email-btn">

                    <i class="bi bi-person-plus-fill me-2"></i>

                    Join Us

                </a>

            </div>

        </div>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}