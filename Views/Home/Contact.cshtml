@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="pv-card mx-auto" style="max-width: 900px;">
        <div class="text-center mb-5">
            <h1 class="fw-bold">Contact Us</h1>
            <p class="lead text-muted">We'd love to hear from you. Get in touch with ParaVolley Mpumalanga for enquiries, player registration, volunteering, events and general information.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-5">
                <div class="p-4 h-100 rounded" style="background-color:#f8f9fa;">
                    <h3 class="fw-bold mb-4">Get In Touch</h3>
                    <div class="mb-4"><h6 class="fw-bold">📍 Location</h6><p class="text-muted mb-0">Mpumalanga, South Africa</p></div>
                    <div class="mb-4"><h6 class="fw-bold">✉️ Email</h6><p class="text-muted mb-0"><a href="mailto:paravolleympumalanga@gmail.com" class="text-decoration-none">paravolleympumalanga@gmail.com</a></p></div>
                    <div><h6 class="fw-bold">🏐 General Enquiries</h6><p class="text-muted mb-0">Contact us for information about ParaVolley activities, participation, events, volunteering and partnerships.</p></div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="p-4">
                    <h3 class="fw-bold mb-4">Send Us a Message</h3>
                    <p class="text-muted">Use the button below to email ParaVolley Mpumalanga directly. This avoids collecting personal information on the website while the contact-message feature is still being tested.</p>
                    <a class="btn w-100 fw-bold" style="background-color:#0B6E4F;color:white;" href="mailto:paravolleympumalanga@gmail.com?subject=ParaVolley%20Mpumalanga%20Enquiry">Email ParaVolley Mpumalanga</a>
                </div>
            </div>
        </div>

        <div class="text-center mt-5 pt-4 border-top">
            <h3 class="fw-bold">Join the ParaVolley Community</h3>
            <p class="text-muted">Whether you are a player, coach, volunteer, supporter or organisation, ParaVolley Mpumalanga welcomes opportunities to connect and grow inclusive volleyball in Mpumalanga.</p>
            <div class="mt-3"><a href="https://www.facebook.com/profile.php?id=61571467720896" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">Facebook</a></div>
        </div>
    </div>
</div>
