@{
ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="pv-card mx-auto" style="max-width: 900px;">


    <div class="text-center mb-5">
        <h1 class="fw-bold">Contact Us</h1>
        <p class="lead text-muted">
            We'd love to hear from you. Get in touch with ParaVolley Mpumalanga
            for enquiries, player registration, volunteering, events and general information.
        </p>
    </div>

    <div class="row g-4">

        <!-- Contact Information -->
        <div class="col-md-5">
            <div class="p-4 h-100 rounded"
                 style="background-color: #f8f9fa;">

                <h3 class="fw-bold mb-4">Get In Touch</h3>

                <div class="mb-4">
                    <h6 class="fw-bold">📍 Address</h6>
                    <p class="text-muted mb-0">
                        ParaVolley Mpumalanga<br />
                        Mpumalanga, South Africa
                    </p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold">📞 Phone / WhatsApp</h6>
                    <p class="text-muted mb-0">
                        <a href="tel:+27000000000"
                           class="text-decoration-none">
                            +27 XX XXX XXXX
                        </a>
                    </p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold">✉️ Email</h6>
                    <p class="text-muted mb-0">
                        <a href="mailto:info@paravolleympumalanga.org"
                           class="text-decoration-none">
                            info@paravolleympumalanga.org
                        </a>
                    </p>
                </div>

                <div>
                    <h6 class="fw-bold">🏐 General Enquiries</h6>
                    <p class="text-muted mb-0">
                        Contact us for information about ParaVolley activities,
                        participation, events, volunteering and partnerships.
                    </p>
                </div>

            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-md-7">
            <div class="p-4">

                <h3 class="fw-bold mb-4">Send Us a Message</h3>

                <form method="post">

                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">
                            Full Name
                        </label>
                        <input type="text"
                               class="form-control"
                               id="name"
                               name="Name"
                               placeholder="Enter your full name"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">
                            Email Address
                        </label>
                        <input type="email"
                               class="form-control"
                               id="email"
                               name="Email"
                               placeholder="Enter your email address"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="subject" class="form-label fw-semibold">
                            Subject
                        </label>
                        <input type="text"
                               class="form-control"
                               id="subject"
                               name="Subject"
                               placeholder="What would you like to contact us about?"
                               required />
                    </div>

                    <div class="mb-4">
                        <label for="message" class="form-label fw-semibold">
                            Message
                        </label>
                        <textarea class="form-control"
                                  id="message"
                                  name="Message"
                                  rows="5"
                                  placeholder="Type your message here..."
                                  required></textarea>
                    </div>

                    <button type="submit"
                            class="btn w-100 fw-bold"
                            style="background-color: #0B6E4F; color: white;">
                        Send Message
                    </button>

                </form>

            </div>
        </div>

    </div>

    <!-- Additional Information -->
    <div class="text-center mt-5 pt-4 border-top">

        <h3 class="fw-bold">Join the ParaVolley Community</h3>

        <p class="text-muted">
            Whether you are a player, coach, volunteer, supporter or organisation,
            ParaVolley Mpumalanga welcomes opportunities to connect and grow
            inclusive volleyball in Mpumalanga.
        </p>

        <div class="mt-3">
            <a href="#"
               class="btn btn-outline-dark me-2">
                Facebook
            </a>

            <a href="#"
               class="btn btn-outline-dark me-2">
                WhatsApp
            </a>

            <a href="#"
               class="btn btn-outline-dark">
                Instagram
            </a>
        </div>

    </div>

</div>


</div>
