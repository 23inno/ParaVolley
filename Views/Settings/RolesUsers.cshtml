@model List<AppUser>
@{
    ViewData["Title"] = "Roles & Users";
}

<h2 class="settings-page-title">Roles &amp; Users</h2>
<p class="settings-page-subtitle mb-3">
    Manage authenticated Admin and Coach accounts. Roles are assigned by the server.
</p>

<div class="settings-layout">
    <partial name="_SettingsNav" />

    <div class="settings-content-card">
        <div class="settings-section-header d-flex justify-content-between align-items-start">
            <div>
                <h5>Authentication accounts</h5>
                <p>Coach accounts created here can sign in immediately.</p>
            </div>
            <button type="button" class="btn btn-pv flex-shrink-0"
                    data-bs-toggle="modal" data-bs-target="#provisionCoachModal">
                <i class="bi bi-plus-lg"></i> Create Coach account
            </button>
        </div>

        <div class="settings-section-body pt-3 pb-3">
            <div class="table-responsive">
                <table class="table pv-table align-middle">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@user.Email</td>
                                <td>
                                    <span class="role-pill @(user.Role == AppUserRole.Admin ? "role-admin" : "role-coach")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="status-pill @(user.IsActive ? "active" : "inactive")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleAppUserActive" asp-route-id="@user.Id" method="post">
                                        <button type="submit"
                                                class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-secondary")">
                                            @(user.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="provisionCoachModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ProvisionCoach" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create Coach account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        This operation always creates a Coach. It cannot create an Admin account.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" name="email" class="form-control"
                               autocomplete="off" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Initial Password</label>
                        <input type="password" name="password" class="form-control"
                               minlength="8" autocomplete="new-password" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pv">Create Coach</button>
                </div>
            </form>
        </div>
    </div>
</div>
