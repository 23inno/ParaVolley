@using System.Security.Claims
@model List<AppUser>

@{
    ViewData["Title"] = "Roles & Users";

    var currentUserIdValue =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    int.TryParse(
        currentUserIdValue,
        out var currentUserId);
}

<h2 class="settings-page-title">
    Roles &amp; Users
</h2>

<p class="settings-page-subtitle mb-3">
    Manage authenticated Admin and Coach accounts.
    Roles are assigned securely by the server.
</p>

<div class="settings-layout">

    <partial name="_SettingsNav" />

    <div class="settings-content-card">

        <div class="settings-section-header
                    d-flex
                    justify-content-between
                    align-items-start
                    gap-3">

            <div>
                <h5>Authentication Accounts</h5>

                <p>
                    Manage the accounts that can sign in to the
                    ParaVolley administration system.
                </p>
            </div>

            <button type="button"
                    class="btn btn-pv flex-shrink-0"
                    data-bs-toggle="modal"
                    data-bs-target="#provisionCoachModal">

                <i class="bi bi-person-plus"></i>
                Create Coach Account

            </button>

        </div>


        <div class="settings-section-body pt-3 pb-3">

            <div class="table-responsive">

                <table class="table pv-table align-middle">

                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center
                                               text-muted
                                               py-4">

                                    No Admin or Coach accounts
                                    were found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var account in Model)
                            {
                                var isCurrentAccount =
                                account.Id ==
                                currentUserId;

                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @account.Email
                                        </div>

                                        @if (isCurrentAccount)
                                        {
                                            <div class="small text-muted">
                                                Signed-in account
                                            </div>
                                        }

                                </td>


                                <td>

                                    <span class="role-pill
                                                @(account.Role ==
                                                                                          AppUserRole.Admin
                                                                                          ? "role-admin"
                                                                                          : "role-coach")">

                                        @account.Role

                                    </span>

                                </td>


                                <td>

                                    <span class="status-pill
                                                @(account.IsActive
                                                                                          ? "active"
                                                                                          : "inactive")">

                                        @(account.IsActive
                                                                            ? "Active"
                                                                            : "Inactive")

                                </span>

                                    </td>


                                    <td class="text-end">

                                @if (isCurrentAccount)
                                        {
                                            <span class="badge
                                                                     bg-light
                                                                     text-dark
                                                                     border">

                                                <i class="bi bi-person-check me-1"></i>
                                                Current account

                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleAppUserActive"
                                                  asp-route-id="@account.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @if (account.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn
                                                                                   btn-sm
                                                                                   btn-outline-danger"
                                                            onclick="return confirm('Deactivate this account? The user will no longer be able to sign in until the account is activated again.');">

                                                        <i class="bi bi-person-x"></i>
                                                        Deactivate

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn
                                                                                   btn-sm
                                                                                   btn-outline-success"
                                                            onclick="return confirm('Activate this account? The user will be able to sign in again.');">

                                                        <i class="bi bi-person-check"></i>
                                                        Activate

                                                    </button>
                                                }

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="provisionCoachModal"
     tabindex="-1"
     aria-labelledby="provisionCoachModalLabel"
     aria-hidden="true">

    <div class="modal-dialog
                modal-dialog-centered">

        <div class="modal-content
                    border-0
                    rounded-4
                    overflow-hidden">

            <form asp-action="ProvisionCoach"
                  method="post">

                <div class="modal-header">

                    <div>

                        <h5 class="modal-title"
                            id="provisionCoachModalLabel">

                            <i class="bi bi-person-plus
                                      text-success
                                      me-1"></i>

                            Create Coach Account

                        </h5>

                        <div class="small text-muted mt-1">
                            Create authentication access for a Coach.
                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="alert
                                alert-light
                                border
                                small">

                        <i class="bi bi-shield-lock
                                  text-success
                                  me-1"></i>

                        Accounts created here are always assigned
                        the <strong>Coach</strong> role.
                        This form cannot create an Administrator.

                    </div>


                    <div class="mb-3">

                        <label for="coachAccountEmail"
                               class="form-label fw-semibold">

                            Email Address

                        </label>

                        <input type="email"
                               id="coachAccountEmail"
                               name="email"
                               class="form-control"
                               maxlength="200"
                               autocomplete="email"
                               placeholder="coach@example.com"
                               required />

                    </div>


                    <div class="mb-2">

                        <label for="coachAccountPassword"
                               class="form-label fw-semibold">

                            Initial Password

                        </label>

                        <input type="password"
                               id="coachAccountPassword"
                               name="password"
                               class="form-control"
                               minlength="8"
                               maxlength="128"
                               autocomplete="new-password"
                               placeholder="At least 8 characters"
                               required />

                        <div class="form-text">
                            The Coach should change this password
                            after receiving access.
                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-pv">

                        <i class="bi bi-person-check"></i>
                        Create Coach

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>