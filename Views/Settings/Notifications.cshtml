@{
    ViewData["Title"] = "Notifications";
}

<h2 class="settings-page-title">Notifications</h2>

<p class="settings-page-subtitle mb-3">
    View the notification capabilities currently available in the system.
</p>

<div class="settings-layout">

    <partial name="_SettingsNav" />

    <div>

        <div class="settings-content-card">

            <div class="settings-section-header">
                <h5>Notification Delivery</h5>

                <p>
                    Notification channel preferences will be available
                    when the relevant delivery services are connected.
                </p>
            </div>

            <div class="settings-section-body pt-4 pb-4">

                <div class="alert alert-light border mb-4">

                    <div class="d-flex gap-3 align-items-start">

                        <div class="fs-4 text-success">
                            <i class="bi bi-bell"></i>
                        </div>

                        <div>
                            <div class="fw-semibold mb-1">
                                Notification preferences are not yet configurable
                            </div>

                            <div class="text-muted small">
                                Email, SMS and push notification preferences are
                                currently unavailable because these channels are
                                not connected to the system-wide event workflow.
                            </div>
                        </div>

                    </div>

                </div>


                <div class="settings-row">

                    <div>
                        <div class="fw-semibold">
                            Email Notifications
                        </div>

                        <div class="text-muted small">
                            Requires integration with application event
                            notifications and an email delivery service.
                        </div>
                    </div>

                    <div class="ms-auto">
                        <span class="badge bg-secondary">
                            Not configured
                        </span>
                    </div>

                </div>


                <div class="settings-row">

                    <div>
                        <div class="fw-semibold">
                            SMS Notifications
                        </div>

                        <div class="text-muted small">
                            Requires an SMS provider before messages can
                            be delivered automatically.
                        </div>
                    </div>

                    <div class="ms-auto">
                        <span class="badge bg-secondary">
                            Not configured
                        </span>
                    </div>

                </div>


                <div class="settings-row">

                    <div>
                        <div class="fw-semibold">
                            Push Notifications
                        </div>

                        <div class="text-muted small">
                            Requires push-notification registration and
                            delivery support for the mobile application.
                        </div>
                    </div>

                    <div class="ms-auto">
                        <span class="badge bg-secondary">
                            Not configured
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>