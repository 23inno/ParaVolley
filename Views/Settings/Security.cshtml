@model UserProfile

@{
    ViewData["Title"] = "Security";
}

<h2 class="settings-page-title">Security</h2>

<p class="settings-page-subtitle mb-3">
    Keep your account secure with a strong password.
</p>

<div class="settings-layout">

    <partial name="_SettingsNav" />

    <div>

        <div class="settings-content-card">

            <div class="settings-section-header">
                <h5>Change Password</h5>

                <p>
                    Update the password used to sign in to your
                    ParaVolley administrator account.
                </p>
            </div>

            <div class="settings-section-body pt-4 pb-4">

                <form asp-action="ChangePassword"
                      method="post"
                      autocomplete="off">

                    <div class="settings-row">

                        <div class="settings-row-label">
                            Current Password
                        </div>

                        <div class="settings-row-control position-relative">

                            <input type="password"
                                   name="currentPassword"
                                   id="pwCurrent"
                                   class="form-control pe-5"
                                   placeholder="Enter current password"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="btn btn-sm position-absolute top-50 end-0 translate-middle-y me-1 border-0 text-muted toggle-pw"
                                    data-target="pwCurrent"
                                    aria-label="Show current password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>


                    <div class="settings-row">

                        <div class="settings-row-label">
                            New Password
                        </div>

                        <div class="settings-row-control position-relative">

                            <input type="password"
                                   name="newPassword"
                                   id="pwNew"
                                   class="form-control pe-5"
                                   placeholder="At least 8 characters"
                                   autocomplete="new-password"
                                   minlength="8"
                                   required />

                            <button type="button"
                                    class="btn btn-sm position-absolute top-50 end-0 translate-middle-y me-1 border-0 text-muted toggle-pw"
                                    data-target="pwNew"
                                    aria-label="Show new password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>


                    <div class="settings-row">

                        <div class="settings-row-label">
                            Confirm Password
                        </div>

                        <div class="settings-row-control position-relative">

                            <input type="password"
                                   name="confirmPassword"
                                   id="pwConfirm"
                                   class="form-control pe-5"
                                   placeholder="Repeat new password"
                                   autocomplete="new-password"
                                   minlength="8"
                                   required />

                            <button type="button"
                                    class="btn btn-sm position-absolute top-50 end-0 translate-middle-y me-1 border-0 text-muted toggle-pw"
                                    data-target="pwConfirm"
                                    aria-label="Show confirmed password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>


                    <div class="alert alert-light border mt-4 mb-0">

                        <div class="d-flex gap-2">

                            <i class="bi bi-shield-lock text-success"></i>

                            <div class="small">

                                <strong>Password security</strong>

                                <div class="text-muted">
                                    Use at least 8 characters and avoid
                                    reusing a password from another account.
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="text-end pt-4">

                        <button type="submit"
                                class="btn btn-pv">

                            <i class="bi bi-shield-check"></i>
                            Update Password

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document
            .querySelectorAll('.toggle-pw')
            .forEach(function (button) {

                button.addEventListener(
                    'click',
                    function () {

                        var targetId =
                            button.getAttribute(
                                'data-target');

                        var input =
                            document.getElementById(
                                targetId);

                        if (!input) {
                            return;
                        }


                        var icon =
                            button.querySelector('i');


                        if (input.type === 'password') {

                            input.type = 'text';

                            if (icon) {
                                icon.className =
                                    'bi bi-eye-slash';
                            }

                            button.setAttribute(
                                'aria-label',
                                'Hide password');

                        }
                        else {

                            input.type = 'password';

                            if (icon) {
                                icon.className =
                                    'bi bi-eye';
                            }

                            button.setAttribute(
                                'aria-label',
                                'Show password');
                        }
                    });
            });

    </script>
}