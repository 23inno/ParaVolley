@model List<BackupRecord>
@{
    ViewData["Title"] = "Backup & Data";
}

<h2 class="settings-page-title">Backup &amp; Data</h2>
<p class="settings-page-subtitle mb-3">Manage your data backups and exports.</p>

<div class="settings-layout">
    <partial name="_SettingsNav" />

    <div>
        <div class="settings-content-card mb-3">
            <div class="settings-section-header">
                <h5>Data Backup</h5>
                <p>Download or manage backups of your system data.</p>
            </div>

            <div class="settings-section-body pt-4 pb-4">
                <div class="d-flex gap-2 mb-4 flex-wrap">
                    <form asp-action="CreateBackup" method="post">
                        <button type="submit" class="btn btn-pv"><i class="bi bi-server"></i> Create Backup Now</button>
                    </form>

                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#restoreModal">
                        <i class="bi bi-upload"></i> Restore from File
                    </button>
                </div>

                <h6 class="fw-bold mb-2">Backup History</h6>
                <div class="table-responsive">
                    <table class="table pv-table align-middle">
                        <thead>
                            <tr>
                                <th>Date &amp; Time</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td>@b.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(b.SizeBytes >= 1024 * 1024 ? $"{b.SizeBytes / 1024.0 / 1024.0:0.0} MB" : $"{b.SizeBytes / 1024.0:0.0} KB")</td>
                                    <td>
                                        @if (b.Success)
                                        {
                                            <span class="backup-status-success">Success</span>
                                        }
                                        else
                                        {
                                            <span class="backup-status-failed">Failed</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (b.Success)
                                        {
                                            <a asp-action="DownloadBackup" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Download</a>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No backups yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="settings-content-card danger-zone-card">
            <div class="settings-section-header" style="border-color:#f5c2c7;">
                <h5 class="text-danger">Danger Zone</h5>
                <p>Irreversible actions that affect all system data.</p>
            </div>
            <div class="settings-section-body pt-3 pb-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">Reset to Demo Data</div>
                        <div class="text-muted small">Wipes everything and reloads the original demo dataset. Safe to use freely - this is an in-memory demo database.</div>
                    </div>
                    <form asp-action="ResetDemoData" method="post" onsubmit="return confirm('This will erase all current data and reload the original demo dataset. Continue?');">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-arrow-counterclockwise"></i> Reset All Data</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="restoreModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RestoreFromFile" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Restore from File</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label fw-semibold">Backup file (.json)</label>
                    <input type="file" name="file" accept=".json" class="form-control" required />
                    <div class="form-text">Upload a .json backup previously downloaded from this system.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-pv">Restore</button>
                </div>
            </form>
        </div>
    </div>
</div>
