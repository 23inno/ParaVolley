@model Player
@{
    ViewData["Title"] = "Player Profile";
    var initials = string.Concat(Model.Name.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    var profileDetails = ViewBag.ProfileDetails as SportsManagementMVC.Models.PlayerProfileDetails;
}

<div class="topbar">
    <h2 class="page-title">Player Profile</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="pv-card" style="max-width:760px;">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="pv-avatar position-relative overflow-hidden" style="width:64px;height:64px;font-size:1.25rem;">
            <span>@initials</span>
            <img src="/Players/ProfilePhoto/@Model.Id"
                 alt="@Model.Name profile photo"
                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
                 onerror="this.style.display='none';" />
        </div>
        <div>
            <h4 class="fw-bold mb-0">@Model.Name</h4>
            <span class="badge @(Model.Status == PlayerStatus.Active ? "badge-active" : "badge-inactive")">@Model.Status</span>
        </div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Position</dt>
        <dd class="col-sm-8">@Model.Position</dd>

        <dt class="col-sm-4 text-muted">Team</dt>
        <dd class="col-sm-8">@Model.Team</dd>

        <dt class="col-sm-4 text-muted">Age</dt>
        <dd class="col-sm-8">@Model.Age</dd>

        <dt class="col-sm-4 text-muted">Joined</dt>
        <dd class="col-sm-8">@(profileDetails?.JoinedDate.ToString("dd MMM yyyy") ?? "Not recorded")</dd>

        <dt class="col-sm-4 text-muted">Matches Played</dt>
        <dd class="col-sm-8">@Model.Matches</dd>

        <dt class="col-sm-4 text-muted">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4 text-muted">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>

        <dt class="col-sm-4 text-muted">Emergency Contact</dt>
        <dd class="col-sm-8">
            @if (profileDetails != null &&
                 (!string.IsNullOrWhiteSpace(profileDetails.EmergencyContactName) ||
                  !string.IsNullOrWhiteSpace(profileDetails.EmergencyContactPhone)))
            {
                <span>@profileDetails.EmergencyContactName</span>
                @if (!string.IsNullOrWhiteSpace(profileDetails.EmergencyContactPhone))
                {
                    <span> — @profileDetails.EmergencyContactPhone</span>
                }
            }
            else
            {
                <span>Not recorded</span>
            }
        </dd>

        <dt class="col-sm-4 text-muted">Disability Classification</dt>
        <dd class="col-sm-8">@Model.Disability</dd>
    </dl>

    <partial name="_MobileAccessCard" model="Model" />

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>
