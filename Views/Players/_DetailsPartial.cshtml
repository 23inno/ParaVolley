@model Player

<div class="modal-header">
    <h5 class="modal-title fw-bold">Player Profile</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="pv-avatar" style="width:64px;height:64px;font-size:1.25rem;">
            @(string.Concat(Model.Name.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper())
        </div>
        <div>
            <h4 class="fw-bold mb-0">@Model.Name</h4>
            <span class="badge @(Model.Status == PlayerStatus.Active ? "badge-active" : "badge-inactive")">@Model.Status</span>
        </div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Position</dt>
        <dd class="col-sm-8">@Model.Position</dd>

        <dt class="col-sm-4 text-muted">Team</dt>
        <dd class="col-sm-8">@Model.Team</dd>

        <dt class="col-sm-4 text-muted">Age</dt>
        <dd class="col-sm-8">@Model.Age</dd>

        <dt class="col-sm-4 text-muted">Matches Played</dt>
        <dd class="col-sm-8">@Model.Matches</dd>

        <dt class="col-sm-4 text-muted">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4 text-muted">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>

        <dt class="col-sm-4 text-muted">Disability Classification</dt>
        <dd class="col-sm-8">@Model.Disability</dd>
    </dl>
</div>
<div class="modal-footer">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv js-player-modal"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger js-player-modal"><i class="bi bi-trash"></i> Delete</a>
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
</div>
