@model IEnumerable<CoachPlayerViewModel>
@{ ViewData["Title"] = "Players & Teams"; }
<div class="pm-header-card mb-3"><h1 class="pm-title">Players &amp; Teams</h1><p class="pm-subtitle">Coaching roster (private contact and medical profile details are excluded)</p></div>
<div class="pm-table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Team</th><th>Position</th><th>Matches</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Team</td><td>@p.Position</td><td>@p.Matches</td><td>@p.Status</td><td><a asp-action="Details" asp-route-id="@p.Id">View</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4">No players found.</td></tr>}
</tbody></table></div></div>

<partial name="_Pagination" />
