@model Player
@using SportsManagementMVC.Infrastructure

@{
    var mobileAccount = ViewBag.MobileAppUser as AppUser;
    var hasMobileAccount = mobileAccount != null;
    var normalizedPhone =
        LoginIdentifierHelper.NormalizePhone(Model.Phone);
    var displayPhone =
        LoginIdentifierHelper.DisplayPhone(Model.Phone);
    var displayEmail =
        LoginIdentifierHelper.IsPlaceholderEmail(Model.Email)
            ? "Not provided"
            : Model.Email;
}

<div class="mt-4 pt-3 border-top">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
            <h5 class="fw-bold mb-1">
                <i class="bi bi-phone me-1"></i>
                Player App Access
            </h5>
            <p class="text-muted small mb-0">
                Players can use their WhatsApp/mobile number to sign in
                after creating their own password.
            </p>
        </div>

        @if (hasMobileAccount)
        {
            <span class="badge @(mobileAccount!.IsActive ? "text-bg-success" : "text-bg-secondary")">
                @(mobileAccount.IsActive ? "Account active" : "Account inactive")
            </span>
        }
        else
        {
            <span class="badge text-bg-warning">
                Account not created
            </span>
        }
    </div>

    @if (Model.Status != PlayerStatus.Active)
    {
        <div class="alert alert-warning py-2 small">
            This player record is inactive. Activate the player before
            sending a Player App setup link.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="small text-muted">Player App login</div>
            <div class="fw-semibold">@displayPhone</div>
        </div>

        <div class="col-md-6">
            <div class="small text-muted">Email</div>
            <div class="fw-semibold text-break">@displayEmail</div>
        </div>
    </div>

    <div class="alert alert-light border small">
        <i class="bi bi-whatsapp me-1 text-success"></i>
        The button below opens WhatsApp with a secure 48-hour password
        setup/reset link already included. The player chooses their own
        password; the admin never needs to know it.
    </div>

    <form asp-action="SendMobileSetupWhatsApp"
          asp-route-id="@Model.Id"
          method="post"
          target="_blank"
          class="d-inline">
        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-success"
                @(Model.Status != PlayerStatus.Active ||
                  normalizedPhone == null
                    ? "disabled"
                    : null)>
            <i class="bi bi-whatsapp me-1"></i>
            Send Password Setup / Reset on WhatsApp
        </button>
    </form>

    @if (normalizedPhone == null)
    {
        <div class="text-danger small mt-2">
            Add a valid WhatsApp/mobile number before sending a setup link.
        </div>
    }

    @if (hasMobileAccount)
    {
        <form asp-action="ToggleMobileAccess"
              asp-route-id="@Model.Id"
              method="post"
              class="mt-3">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-sm @(mobileAccount!.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                    onclick="return confirm('@(mobileAccount.IsActive ? "Deactivate this player\'s mobile app access?" : "Activate this player\'s mobile app access?")');">
                <i class="bi @(mobileAccount.IsActive ? "bi-person-lock" : "bi-person-check") me-1"></i>
                @(mobileAccount.IsActive
                    ? "Deactivate Player App Access"
                    : "Activate Player App Access")
            </button>
        </form>
    }
</div>
