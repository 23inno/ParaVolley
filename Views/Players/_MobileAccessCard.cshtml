@model Player

@{
    var mobileAccount = ViewBag.MobileAppUser as AppUser;
    var hasMobileAccount = mobileAccount != null;
}

<div class="mt-4 pt-3 border-top">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3">
        <div>
            <h5 class="fw-bold mb-1">
                <i class="bi bi-phone me-1"></i>
                Mobile App Access
            </h5>
            <p class="text-muted small mb-0">
                Create, activate or reset this player's Android login.
            </p>
        </div>

        @if (hasMobileAccount)
        {
            <span class="badge @(mobileAccount!.IsActive ? "text-bg-success" : "text-bg-secondary")">
                @(mobileAccount.IsActive ? "Active" : "Inactive")
            </span>
        }
        else
        {
            <span class="badge text-bg-warning">
                Not configured
            </span>
        }
    </div>

    @if (Model.Status != PlayerStatus.Active)
    {
        <div class="alert alert-warning py-2 small">
            This player record is inactive. Activate the player before enabling mobile app access.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="small text-muted">Login email</div>
            <div class="fw-semibold text-break">@Model.Email</div>
        </div>

        <div class="col-md-6">
            <div class="small text-muted">Mobile account</div>
            <div class="fw-semibold">
                @(hasMobileAccount ? "Linked to player" : "No AppUser linked")
            </div>
        </div>
    </div>

    <form asp-action="SaveMobileAccess"
          asp-route-id="@Model.Id"
          method="post"
          class="row g-3">

        <div class="col-md-6">
            <label for="mobilePassword-@Model.Id" class="form-label fw-semibold">
                @(hasMobileAccount ? "New mobile password" : "Mobile password")
            </label>
            <input id="mobilePassword-@Model.Id"
                   name="password"
                   type="password"
                   class="form-control"
                   minlength="8"
                   maxlength="128"
                   autocomplete="new-password"
                   required />
        </div>

        <div class="col-md-6">
            <label for="mobilePasswordConfirm-@Model.Id" class="form-label fw-semibold">
                Confirm password
            </label>
            <input id="mobilePasswordConfirm-@Model.Id"
                   name="confirmPassword"
                   type="password"
                   class="form-control"
                   minlength="8"
                   maxlength="128"
                   autocomplete="new-password"
                   required />
        </div>

        <div class="col-12">
            <div class="form-text mb-2">
                The password is hashed by the server and is never stored or displayed in plain text.
                @if (hasMobileAccount)
                {
                    <span>Saving will reset the mobile password and activate the account.</span>
                }
                else
                {
                    <span>Saving will create and activate a Player login for the Android app.</span>
                }
            </div>

            <button type="submit"
                    class="btn btn-pv"
                    @(Model.Status != PlayerStatus.Active ? "disabled" : null)>
                <i class="bi bi-shield-lock me-1"></i>
                @(hasMobileAccount ? "Reset Password & Activate" : "Create Mobile Access")
            </button>
        </div>
    </form>

    @if (hasMobileAccount)
    {
        <form asp-action="ToggleMobileAccess"
              asp-route-id="@Model.Id"
              method="post"
              class="mt-3">
            <button type="submit"
                    class="btn btn-sm @(mobileAccount!.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                    onclick="return confirm('@(mobileAccount.IsActive ? "Deactivate this player's mobile app access?" : "Activate this player's mobile app access?")');">
                <i class="bi @(mobileAccount.IsActive ? "bi-person-lock" : "bi-person-check") me-1"></i>
                @(mobileAccount.IsActive ? "Deactivate Mobile Access" : "Activate Mobile Access")
            </button>
        </form>
    }
</div>
