@model Player

<div class="modal-header">
    <h5 class="modal-title fw-bold">Edit Player</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="Edit"
      method="post"
      class="js-ajax-form"
      onsubmit="
          if (this.dataset.submitting === 'true') {
              event.preventDefault();
              event.stopPropagation();
              return false;
          }

          this.dataset.submitting = 'true';
          this.setAttribute('aria-busy', 'true');

          var submitButton = this.querySelector('[data-submit-button]');
          var cancelButton = this.querySelector('[data-cancel-button]');
          var statusMessage = this.querySelector('[data-submit-status]');
          var modalContent = this.closest('.modal-content');
          var closeButton = modalContent ? modalContent.querySelector('.btn-close') : null;

          if (submitButton) {
              submitButton.disabled = true;
              submitButton.textContent = 'Saving Changes...';
          }

          if (cancelButton) cancelButton.disabled = true;
          if (closeButton) closeButton.disabled = true;
          if (statusMessage) statusMessage.classList.remove('d-none');
      ">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Position" class="form-label fw-semibold"></label>
                <select asp-for="Position" class="form-select">
                    <option value="Outside Hitter">Outside Hitter</option>
                    <option value="Setter">Setter</option>
                    <option value="Middle Blocker">Middle Blocker</option>
                    <option value="Libero">Libero</option>
                    <option value="Opposite Hitter">Opposite Hitter</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Team" class="form-label fw-semibold"></label>
                <select asp-for="Team" class="form-select">
                    <option value="Team A">Team A</option>
                    <option value="Team B">Team B</option>
                    <option value="Team C">Team C</option>
                    <option value="Team D">Team D</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Age" class="form-label fw-semibold"></label>
                <input asp-for="Age" class="form-control" type="number" />
                <span asp-validation-for="Age" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Matches" class="form-label fw-semibold"></label>
                <input asp-for="Matches" class="form-control" type="number" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-semibold"></label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="mb-0">
            <label asp-for="Disability" class="form-label fw-semibold"></label>
            <select asp-for="Disability" class="form-select">
                <option value="Wheelchair">Wheelchair</option>
                <option value="Limb Difference">Limb Difference</option>
                <option value="Visual Impairment">Visual Impairment</option>
                <option value="Hearing Impairment">Hearing Impairment</option>
                <option value="Other">Other</option>
            </select>
        </div>
    </div>

    <div class="alert alert-info d-none mx-3 mb-0 py-2" data-submit-status role="status">
        <i class="bi bi-hourglass-split me-1"></i>
        Saving the player changes. Please wait and do not submit again.
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-pv" data-submit-button><i class="bi bi-check-lg"></i> Save Changes</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-cancel-button>Cancel</button>
    </div>
</form>
