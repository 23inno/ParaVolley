@model CoachPlayerViewModel
@{
    ViewData["Title"] = "Player";
    var initials = string.Concat(Model.Name.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    var profileDetails = ViewBag.ProfileDetails as SportsManagementMVC.Models.PlayerProfileDetails;
}

<div class="pv-card" style="max-width:650px">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="pv-avatar position-relative overflow-hidden" style="width:64px;height:64px;font-size:1.25rem;">
            <span>@initials</span>
            <img src="/Players/ProfilePhoto/@Model.Id"
                 alt="@Model.Name profile photo"
                 style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
                 onerror="this.style.display='none';" />
        </div>
        <h1 class="h3 mb-0">@Model.Name</h1>
    </div>

    <dl class="row">
        <dt class="col-4">Team</dt>
        <dd class="col-8">@Model.Team</dd>

        <dt class="col-4">Position</dt>
        <dd class="col-8">@Model.Position</dd>

        <dt class="col-4">Joined</dt>
        <dd class="col-8">@(profileDetails?.JoinedDate.ToString("dd MMM yyyy") ?? "Not recorded")</dd>

        <dt class="col-4">Emergency Contact</dt>
        <dd class="col-8">
            @if (profileDetails != null &&
                 (!string.IsNullOrWhiteSpace(profileDetails.EmergencyContactName) ||
                  !string.IsNullOrWhiteSpace(profileDetails.EmergencyContactPhone)))
            {
                <span>@profileDetails.EmergencyContactName</span>
                @if (!string.IsNullOrWhiteSpace(profileDetails.EmergencyContactPhone))
                {
                    <span> — @profileDetails.EmergencyContactPhone</span>
                }
            }
            else
            {
                <span>Not recorded</span>
            }
        </dd>

        <dt class="col-4">Matches</dt>
        <dd class="col-8">@Model.Matches</dd>

        <dt class="col-4">Status</dt>
        <dd class="col-8">@Model.Status</dd>
    </dl>

    <a asp-action="Index" class="btn btn-outline-secondary">Back to roster</a>
</div>
