@using System.Security.Claims
@using SportsManagementMVC.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@{
    var org = await Db.OrganisationSettings.FirstOrDefaultAsync() ?? new OrganisationSettings();
    var appearance = await Db.AppearanceSettings.FirstOrDefaultAsync() ?? new AppearanceSettings();
    var profile = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin")
        ? await Db.UserProfiles.FirstOrDefaultAsync()
        : null;

    var unreadContactMessages = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Admin")
         ? await Db.ContactMessages.CountAsync(m => !m.IsRead)
        : 0;

    var unreadPlayerApplications = User.Identity != null
&& User.Identity.IsAuthenticated
&& User.IsInRole("Admin")
    ? await Db.PlayerRegistrationApplications
        .CountAsync(a => !a.IsRead)
    : 0;

    var orgWords = org.OrganisationName.Split(' ', 2);
    var orgFirstWord = orgWords.Length > 0 ? orgWords[0] : "ParaVolley";
    var orgRest = orgWords.Length > 1 ? orgWords[1] : "";

    var isPublicUser =
    User.Identity == null ||
    !User.Identity.IsAuthenticated;

    var accent = isPublicUser
        ? "#0B6E4F"
        : appearance.AccentColor;

    var accentDark = isPublicUser
        ? "#085d42"
        : ShadeColor(accent, -0.18);
    var themeAttr = isPublicUser
    ? "light"
    : appearance.Theme.ToString().ToLowerInvariant();

    var densityAttr = isPublicUser
        ? "comfortable"
        : appearance.Density.ToString().ToLowerInvariant();

    var accountDisplayName = profile?.FullName ?? User.Identity?.Name ?? "Admin User";
    var accountEmail = profile?.Email ?? User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name ?? "";
    var initials = string.Concat(accountDisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0])).ToUpper();
    if (string.IsNullOrWhiteSpace(initials)) { initials = "AU"; }
    if (initials.Length > 2) { initials = initials.Substring(0, 2); }
}
@functions {
    private string ShadeColor(string hex, double amount)
    {
        try
        {
            hex = hex.TrimStart('#');
            int r = Convert.ToInt32(hex.Substring(0, 2), 16);
            int g = Convert.ToInt32(hex.Substring(2, 2), 16);
            int b = Convert.ToInt32(hex.Substring(4, 2), 16);
            r = (int)Math.Clamp(r + (amount * 255), 0, 255);
            g = (int)Math.Clamp(g + (amount * 255), 0, 255);
            b = (int)Math.Clamp(b + (amount * 255), 0, 255);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
        catch { return hex; }
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="@themeAttr" data-density="@densityAttr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @org.OrganisationName</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Core stylesheet: Admin / Coach + existing application styles -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <!-- Public Portal Redesign -->
        <link rel="stylesheet"
              href="~/css/public-site.css"
              asp-append-version="true" />

        <!-- About page responsive fixes -->
        <link rel="stylesheet"
              href="~/css/about-responsive-fix.css"
              asp-append-version="true" />
    }

    <!-- ParaVolley theme colours -->
    <style>
        :root {
            --pv-green: @accent;
            --pv-green-dark: @accentDark;
            --pv-gold: #FFC72C;
            --pv-yellow: #FFC72C;
            --pv-white: #FFFFFF;
            --pv-black: #000000;
        }
    </style>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var isAdmin = User.IsInRole("Admin");
        var isCoach = User.IsInRole("Coach");
        <aside class="pv-sidebar" id="pvSidebar">
            <script>if (localStorage.getItem('sidebarCollapsed') === 'true') { document.getElementById('pvSidebar').classList.add('collapsed'); }</script>
            <div class="brand">
                <h1>@orgFirstWord</h1><p>@orgRest</p>
                <button type="button" class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Collapse menu"><i class="bi bi-chevron-left"></i></button>
            </div>
            <nav>

                <a class="pv-nav-link @(currentController == "Home" ? "active" : "")"
                   asp-controller="Home"
                   asp-action="@(isAdmin ? "AdminDashboard" : isCoach ? "CoachDashboard" : "Index")"
                   title="Dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                @if (isAdmin || isCoach)
                {
                    <a class="pv-nav-link @(currentController == "Players" ? "active" : "")"
                       asp-controller="Players"
                       asp-action="Index"
                       title="Players">
                        <i class="bi bi-people-fill"></i>
                        <span>Players</span>
                    </a>
                }

                <a class="pv-nav-link @(currentController == "PlayerApplications" ? "active" : "")"
                   asp-controller="PlayerApplications"
                   asp-action="Index"
                   title="Player Applications">

                    <i class="bi bi-person-plus-fill"></i>
                    <span>Player Applications</span>

                    @if (unreadPlayerApplications > 0)
                    {
                        <span class="badge bg-warning text-dark ms-auto">
                            @unreadPlayerApplications
                        </span>
                    }

                </a>

                @if (isAdmin || isCoach)
                {
                    <a class="pv-nav-link @(currentController == "Events" ? "active" : "")"
                       asp-controller="Events"
                       asp-action="Index"
                       title="Events">
                        <i class="bi bi-calendar-event-fill"></i>
                        <span>Events</span>
                    </a>
                }

                @if (isAdmin || isCoach)
                {
                    <a class="pv-nav-link @(currentController == "Matches" ? "active" : "")"
                       asp-controller="Matches"
                       asp-action="Index"
                       title="Matches">
                        <i class="bi bi-trophy-fill"></i>
                        <span>Matches</span>
                    </a>
                }

                @if (isAdmin || isCoach)
                {
                    <a class="pv-nav-link @(currentController == "Attendance" ? "active" : "")"
                       asp-controller="Attendance"
                       asp-action="Index"
                       title="Attendance">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Attendance</span>
                    </a>
                }

                @if (isAdmin || isCoach)
                {
                    <a class="pv-nav-link @(currentController == "Announcements" ? "active" : "")"
                       asp-controller="Announcements"
                       asp-action="Index"
                       title="News">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>News</span>
                    </a>
                }

                @if (isAdmin)
                {
                    <a class="pv-nav-link @(currentController == "ContactMessages" ? "active" : "")"
                       asp-controller="ContactMessages"
                       asp-action="Index"
                       title="Contact Messages">

                        <i class="bi bi-envelope-fill"></i>

                        <span>Contact Messages</span>

                        @if (unreadContactMessages > 0)
                        {
                            <span class="badge bg-warning text-dark ms-auto">
                                @unreadContactMessages
                            </span>
                        }

                    </a>

                    <a class="pv-nav-link @(currentController == "Reports" ? "active" : "")"
                       asp-controller="Reports"
                       asp-action="Index"
                       title="Reports">
                        <i class="bi bi-file-earmark-text-fill"></i>
                        <span>Reports</span>
                    </a>

                    <a class="pv-nav-link @(currentController == "Coaches" ? "active" : "")"
                       asp-controller="Coaches"
                       asp-action="Index"
                       title="Coaches">
                        <i class="bi bi-person-badge-fill"></i>
                        <span>Coaches</span>
                    </a>

                    <a class="pv-nav-link @(currentController == "Settings" ? "active" : "")"
                       asp-controller="Settings"
                       asp-action="Profile"
                       title="Settings">
                        <i class="bi bi-gear-fill"></i>
                        <span>Settings</span>
                    </a>
                }

            </nav>
            <div class="user-box" title="Signed in as @accountDisplayName">
                <div class="user-summary">
                    @if (profile != null && !string.IsNullOrEmpty(profile.AvatarPath)) { <img src="@profile.AvatarPath" class="pv-avatar" alt="@accountDisplayName avatar" title="@accountDisplayName" /> }
                    else { <div class="pv-avatar" title="@accountDisplayName">@initials</div> }
                    <div class="user-info-text"><p class="user-name">@accountDisplayName</p><p class="user-email">@accountEmail</p></div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="sidebar-logout-btn" title="Logout" aria-label="Logout @accountDisplayName">
                <i class="bi bi-box-arrow-right">
                </i>
                <span>Logout</span>
                </button>
                </form>
            </div>
        </aside>
        <button type="button" class="sidebar-backdrop" id="sidebarBackdrop" aria-label="Close menu"></button>
        <main class="pv-content">
            <div class="d-flex align-items-center justify-content-between mb-3 d-lg-none"><button id="sidebarToggle" class="btn btn-outline-secondary btn-sm" type="button" aria-controls="pvSidebar" aria-expanded="false"><i class="bi bi-list"></i> Menu</button></div>
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-auto-dismiss alert-dismissible fade show" role="alert"><i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-circle-fill me-1"></i> @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
            @RenderBody()
        </main>
    }
    else
    {
        <nav class="navbar navbar-expand-lg navbar-dark" style="background:var(--pv-green-dark)">
          <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/paravolley-logo.png"
                         asp-append-version="true"
                         alt="ParaVolley Mpumalanga Logo"
                         class="pv-navbar-logo" />

                    <span>ParaVolley Mpumalanga</span>

                </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
          <span class="navbar-toggler-icon">
          </span>
          </button>
          <div class="collapse navbar-collapse" id="publicNav">
          <div class="navbar-nav ms-auto align-items-lg-center">
          <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Athletes">
                            Athletes
                        </a>

                        <a class="nav-link"
                           asp-controller="Events"
                           asp-action="Index">
                            Events
                        </a>
                        <a class="nav-link" 
                            asp-controller="Matches" 
                            asp-action="Index">Results</a>

                        <a class="nav-link" 
                        asp-controller="Announcements" 
                        asp-action="Index">News</a>

                        <a class="nav-link" 
                            asp-controller="Sponsors" 
                            asp-action="Index">Sponsors</a>

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Join">
                            Join Us
                        </a>

                        <a class="btn btn-warning ms-lg-3"
                           asp-controller="Account"
                           asp-action="Login">
                            Sign In
                        </a>
          </div>
          </div>
          </div>
        </nav>
        @RenderBody()
    }

    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <button type="button"
                id="backToTopBtn"
                class="pv-back-to-top"
                aria-label="Back to top"
                title="Back to top">
            <i class="bi bi-arrow-up"></i>
        </button>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
