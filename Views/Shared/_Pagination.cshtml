@using Microsoft.AspNetCore.WebUtilities
@{
    var currentPage = ViewBag.CurrentPage is int current ? current : 1;
    var totalPages = ViewBag.TotalPages is int total ? total : 1;

    string PageUrl(int targetPage)
    {
        var values = Context.Request.Query.ToDictionary(
            item => item.Key,
            item => (string?)item.Value.ToString());
        values["page"] = targetPage.ToString();
        return QueryHelpers.AddQueryString(
            Context.Request.Path.Value ?? "/",
            values);
    }
}

@if (totalPages > 1)
{
    <nav aria-label="Result pages" class="mt-3">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(currentPage == 1 ? "disabled" : null)">
                <a class="page-link" href="@(currentPage > 1 ? PageUrl(currentPage - 1) : "#")">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @currentPage of @totalPages</span>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : null)">
                <a class="page-link" href="@(currentPage < totalPages ? PageUrl(currentPage + 1) : "#")">Next</a>
            </li>
        </ul>
    </nav>
}
