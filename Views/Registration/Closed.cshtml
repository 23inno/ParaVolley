@model OrganisationSettings
@{
    ViewData["Title"] = "Player Applications Closed";
}

<section class="registration-hero">
    <div class="container">
        <div class="registration-hero-content">
            <span class="registration-hero-label">JOIN PARAVOLLEY MPUMALANGA</span>
            <h1>Player applications are <span>currently closed.</span></h1>
            <p>
                ParaVolley Mpumalanga is not accepting new public player applications at the moment.
                Please check again later or contact the organisation for more information.
            </p>
        </div>
    </div>
</section>

<section class="registration-section">
    <div class="container">
        <div class="registration-form-card mx-auto" style="max-width:760px;">
            <div class="text-center py-4">
                <div class="mb-3" style="font-size:2.5rem;color:#0B6E4F;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h2 class="fw-bold">Applications Closed</h2>
                <p class="text-muted mb-4">
                    New applications have been temporarily disabled by ParaVolley administration.
                </p>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-pv">
                        <i class="bi bi-envelope me-1"></i> Contact Us
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
