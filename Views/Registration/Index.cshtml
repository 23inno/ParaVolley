@{
    ViewData["Title"] = "Join ParaVolley";
}

<section class="registration-hero">
    <div class="container">
        <div class="registration-hero-content">
            <span class="registration-hero-label">JOIN PARAVOLLEY MPUMALANGA</span>
            <h1>Become a <span>ParaVolley Athlete.</span></h1>
            <p>Interested in joining ParaVolley Mpumalanga? Contact the team directly so that your enquiry can be handled safely while the online registration workflow is still being tested.</p>
            <div class="registration-hero-benefits">
                <div><i class="bi bi-check-circle-fill"></i> Inclusive sporting opportunities</div>
                <div><i class="bi bi-check-circle-fill"></i> Athlete development and coaching</div>
                <div><i class="bi bi-check-circle-fill"></i> Training and competition opportunities</div>
            </div>
        </div>
    </div>
</section>

<section class="registration-section">
    <div class="container">
        <div class="registration-layout">
            <div class="registration-info">
                <span class="registration-section-label">PLAYER ENQUIRIES</span>
                <h2>Start Your <span>ParaVolley Journey.</span></h2>
                <div class="registration-heading-line"></div>
                <p>The public online player-registration form is not collecting applications yet. Please email ParaVolley Mpumalanga and the team can guide you through the current registration process.</p>
                <div class="registration-info-list">
                    <div class="registration-info-item"><div class="registration-info-icon"><i class="bi bi-person-fill"></i></div><div><strong>Player Enquiries</strong><span>Ask about joining, training and participation opportunities.</span></div></div>
                    <div class="registration-info-item"><div class="registration-info-icon"><i class="bi bi-trophy-fill"></i></div><div><strong>Sport Information</strong><span>The team can explain available events, coaching and development opportunities.</span></div></div>
                    <div class="registration-info-item"><div class="registration-info-icon"><i class="bi bi-shield-check"></i></div><div><strong>Privacy First</strong><span>Personal and support information is not collected through an unconnected demonstration form.</span></div></div>
                </div>
            </div>

            <div class="registration-form-card">
                <div class="registration-form-section">
                    <div class="registration-form-heading">
                        <div class="registration-form-number">01</div>
                        <div><h3>Contact ParaVolley Mpumalanga</h3><p>Send the team an email to express your interest in joining.</p></div>
                    </div>
                    <p>Use the button below. Your email application will open with a ParaVolley player-enquiry subject already filled in.</p>
                    <a class="registration-submit-btn text-decoration-none" href="mailto:paravolleympumalanga@gmail.com?subject=ParaVolley%20Mpumalanga%20Player%20Enquiry">
                        <i class="bi bi-envelope-fill"></i> Email Player Enquiry
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="registration-login-section">
    <div class="container">
        <div class="registration-login-box">
            <div><span>ALREADY REGISTERED?</span><h2>Already Part of ParaVolley?</h2><p>Existing players and authorised users can access their accounts through the login page.</p></div>
            <a asp-controller="Account" asp-action="Login" class="registration-login-btn">Login <i class="bi bi-box-arrow-in-right"></i></a>
        </div>
    </div>
</section>
