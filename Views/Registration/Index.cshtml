@{
    ViewData["Title"] = "Player Registration";
}

<!-- =========================================
     REGISTRATION HERO
========================================= -->
<section class="registration-hero">

    <div class="container">

        <div class="registration-hero-content">

            <span class="registration-hero-label">
                JOIN PARAVOLLEY MPUMALANGA
            </span>

            <h1>
                Become a
                <span>ParaVolley Athlete.</span>
            </h1>

            <p>
                Complete the registration form below to express your interest
                in joining ParaVolley Mpumalanga as an athlete.
            </p>

            <div class="registration-hero-benefits">

                <div>
                    <i class="bi bi-check-circle-fill"></i>
                    Inclusive sporting opportunities
                </div>

                <div>
                    <i class="bi bi-check-circle-fill"></i>
                    Athlete development and coaching
                </div>

                <div>
                    <i class="bi bi-check-circle-fill"></i>
                    Training and competition opportunities
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     REGISTRATION FORM
========================================= -->
<section class="registration-section">

    <div class="container">

        <div class="registration-layout">

            <!-- LEFT INFO -->
            <div class="registration-info">

                <span class="registration-section-label">
                    PLAYER APPLICATION
                </span>

                <h2>
                    Start Your
                    <span>ParaVolley Journey.</span>
                </h2>

                <div class="registration-heading-line"></div>

                <p>
                    Please provide your details below. This information helps
                    ParaVolley Mpumalanga understand your interests and contact
                    you about suitable training and participation opportunities.
                </p>


                <div class="registration-info-list">

                    <div class="registration-info-item">

                        <div class="registration-info-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div>
                            <strong>Player Information</strong>
                            <span>
                                Tell us who you are and how we can contact you.
                            </span>
                        </div>

                    </div>


                    <div class="registration-info-item">

                        <div class="registration-info-icon">
                            <i class="bi bi-trophy-fill"></i>
                        </div>

                        <div>
                            <strong>Sport Information</strong>
                            <span>
                                Share your experience and preferred playing position.
                            </span>
                        </div>

                    </div>


                    <div class="registration-info-item">

                        <div class="registration-info-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <strong>Safe Participation</strong>
                            <span>
                                Emergency contact information helps us support participants responsibly.
                            </span>
                        </div>

                    </div>

                </div>

            </div>


            <!-- FORM CARD -->
            <div class="registration-form-card">

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="registration-success-message">

                        <i class="bi bi-check-circle-fill"></i>

                        <div>
                            <strong>Registration Submitted</strong>
                            <span>
                                @ViewBag.SuccessMessage
                            </span>
                        </div>

                    </div>
                }


                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="registration-error-message">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        <span>
                            @ViewBag.ErrorMessage
                        </span>

                    </div>
                }


                <form id="playerRegistrationFakeForm">

                 


                    <!-- PERSONAL INFORMATION -->
                    <div class="registration-form-section">

                        <div class="registration-form-heading">

                            <div class="registration-form-number">
                                01
                            </div>

                            <div>
                                <h3>Personal Information</h3>
                                <p>Please enter your personal and contact details.</p>
                            </div>

                        </div>


                        <div class="row g-4">

                            <div class="col-12">

                                <label for="fullName"
                                       class="form-label">
                                    Full Name
                                    <span>*</span>
                                </label>

                                <div class="registration-input-group">
                                    <i class="bi bi-person-fill"></i>

                                    <input type="text"
                                           id="fullName"
                                           name="fullName"
                                           class="form-control"
                                           placeholder="Enter your full name"
                                           required />
                                </div>

                            </div>


                            <div class="col-md-6">

                                <label for="email"
                                       class="form-label">
                                    Email Address
                                    <span>*</span>
                                </label>

                                <div class="registration-input-group">
                                    <i class="bi bi-envelope-fill"></i>

                                    <input type="email"
                                           id="email"
                                           name="email"
                                           class="form-control"
                                           placeholder="name@example.com"
                                           required />
                                </div>

                            </div>


                            <div class="col-md-6">

                                <label for="phone"
                                       class="form-label">
                                    Phone Number
                                </label>

                                <div class="registration-input-group">
                                    <i class="bi bi-telephone-fill"></i>

                                    <input type="tel"
                                           id="phone"
                                           name="phone"
                                           class="form-control"
                                           placeholder="e.g. 071 234 5678" />
                                </div>

                            </div>


                            <div class="col-md-6">

                                <label for="dateOfBirth"
                                       class="form-label">
                                    Date of Birth
                                </label>

                                <div class="registration-input-group">
                                    <i class="bi bi-calendar3"></i>

                                    <input type="date"
                                           id="dateOfBirth"
                                           name="dateOfBirth"
                                           class="form-control" />
                                </div>

                            </div>


                            <div class="col-md-6">

                                <label for="province"
                                       class="form-label">
                                    Province
                                </label>

                                <select id="province"
                                        name="province"
                                        class="form-select">

                                    <option value="">
                                        Select province
                                    </option>

                                    <option>Mpumalanga</option>
                                    <option>Gauteng</option>
                                    <option>Limpopo</option>
                                    <option>KwaZulu-Natal</option>
                                    <option>Free State</option>
                                    <option>North West</option>
                                    <option>Northern Cape</option>
                                    <option>Eastern Cape</option>
                                    <option>Western Cape</option>

                                </select>

                            </div>


                            <div class="col-12">

                                <label for="town"
                                       class="form-label">
                                    Town / City
                                </label>

                                <div class="registration-input-group">
                                    <i class="bi bi-geo-alt-fill"></i>

                                    <input type="text"
                                           id="town"
                                           name="town"
                                           class="form-control"
                                           placeholder="Enter your town or city" />
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- SPORT INFORMATION -->
                    <div class="registration-form-section">

                        <div class="registration-form-heading">

                            <div class="registration-form-number">
                                02
                            </div>

                            <div>
                                <h3>Player Information</h3>
                                <p>Tell us more about your volleyball experience.</p>
                            </div>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label for="experienceLevel"
                                       class="form-label">
                                    Experience Level
                                </label>

                                <select id="experienceLevel"
                                        name="experienceLevel"
                                        class="form-select">

                                    <option value="">
                                        Select experience level
                                    </option>

                                    <option>Beginner</option>
                                    <option>Intermediate</option>
                                    <option>Experienced</option>
                                    <option>Competitive Athlete</option>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label for="preferredPosition"
                                       class="form-label">
                                    Preferred Position
                                </label>

                                <select id="preferredPosition"
                                        name="preferredPosition"
                                        class="form-select">

                                    <option value="">
                                        Select preferred position
                                    </option>

                                    <option>Setter</option>
                                    <option>Outside Hitter</option>
                                    <option>Middle Blocker</option>
                                    <option>Opposite Hitter</option>
                                    <option>Libero</option>
                                    <option>Not Sure Yet</option>

                                </select>

                            </div>


                            <div class="col-12">

                                <label for="classification"
                                       class="form-label">
                                    Classification / Participation Information
                                </label>

                                <input type="text"
                                       id="classification"
                                       name="classification"
                                       class="form-control"
                                       placeholder="Optional information relevant to your participation" />

                                <small class="registration-field-help">
                                    You may leave this blank if you are unsure.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- EMERGENCY CONTACT -->
                    <div class="registration-form-section">

                        <div class="registration-form-heading">

                            <div class="registration-form-number">
                                03
                            </div>

                            <div>
                                <h3>Emergency Contact</h3>
                                <p>Provide someone we can contact if necessary.</p>
                            </div>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label for="emergencyContactName"
                                       class="form-label">
                                    Contact Name
                                </label>

                                <input type="text"
                                       id="emergencyContactName"
                                       name="emergencyContactName"
                                       class="form-control"
                                       placeholder="Emergency contact name" />

                            </div>


                            <div class="col-md-6">

                                <label for="emergencyContactPhone"
                                       class="form-label">
                                    Contact Number
                                </label>

                                <input type="tel"
                                       id="emergencyContactPhone"
                                       name="emergencyContactPhone"
                                       class="form-control"
                                       placeholder="Emergency contact number" />

                            </div>


                            <div class="col-12">

                                <label for="medicalNotes"
                                       class="form-label">
                                    Additional Support Information
                                </label>

                                <textarea id="medicalNotes"
                                          name="medicalNotes"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Optional information that may help us support your participation"></textarea>

                            </div>

                        </div>

                    </div>


                    <!-- CONSENT -->
                    <div class="registration-consent">

                        <input class="form-check-input"
                               type="checkbox"
                               id="consent"
                               name="consent"
                               value="true"
                               required />

                        <label for="consent">

                            I confirm that the information I have provided is
                            correct and I agree that ParaVolley Mpumalanga may
                            contact me regarding my registration.

                        </label>

                    </div>


                    <button type="submit"
                            class="registration-submit-btn">

                        <i class="bi bi-send-fill"></i>
                        Submit Player Registration

                    </button>

                </form>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     EXISTING PLAYER
========================================= -->
<section class="registration-login-section">

    <div class="container">

        <div class="registration-login-box">

            <div>

                <span>
                    ALREADY REGISTERED?
                </span>

                <h2>
                    Already Part of ParaVolley?
                </h2>

                <p>
                    Existing players and authorised users will be able to
                    access their accounts through the login page.
                </p>

            </div>

            <a asp-controller="Account"
               asp-action="Login"
               class="registration-login-btn">

                Login
                <i class="bi bi-box-arrow-in-right"></i>

            </a>

        </div>

    </div>

</section>