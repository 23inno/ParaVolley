@model Match

<div class="modal-header">
    <h5 class="modal-title fw-bold">Create Match</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="Create"
      method="post"
      class="js-ajax-form"
      onsubmit="
          if (this.dataset.submitting === 'true') {
              event.preventDefault();
              event.stopPropagation();
              return false;
          }

          this.dataset.submitting = 'true';
          this.setAttribute('aria-busy', 'true');

          var submitButton = this.querySelector('[data-submit-button]');
          var cancelButton = this.querySelector('[data-cancel-button]');
          var statusMessage = this.querySelector('[data-submit-status]');
          var modalContent = this.closest('.modal-content');
          var closeButton = modalContent ? modalContent.querySelector('.btn-close') : null;

          if (submitButton) {
              submitButton.disabled = true;
              submitButton.textContent = 'Saving Match...';
          }

          if (cancelButton) cancelButton.disabled = true;
          if (closeButton) closeButton.disabled = true;
          if (statusMessage) statusMessage.classList.remove('d-none');
      ">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TeamA" class="form-label fw-semibold"></label>
                <input asp-for="TeamA" class="form-control" value="ParaVolley Mpumalanga" />
                <span asp-validation-for="TeamA" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TeamB" class="form-label fw-semibold"></label>
                <input asp-for="TeamB" class="form-control" placeholder="Opponent team" />
                <span asp-validation-for="TeamB" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Date" class="form-label fw-semibold"></label>
                <input asp-for="Date" class="form-control" type="date" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Time" class="form-label fw-semibold"></label>
                <input asp-for="Time" class="form-control" placeholder="e.g. 14:00" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Venue" class="form-label fw-semibold"></label>
                <input asp-for="Venue" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Tournament" class="form-label fw-semibold"></label>
                <input asp-for="Tournament" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Scheduled">Scheduled</option>
                    <option value="InProgress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="ScoreA" class="form-label fw-semibold"></label>
                <input asp-for="ScoreA" class="form-control" type="number" />
            </div>
            <div class="col-md-4 mb-0">
                <label asp-for="ScoreB" class="form-label fw-semibold"></label>
                <input asp-for="ScoreB" class="form-control" type="number" />
            </div>
        </div>
    </div>

    <div class="alert alert-info d-none mx-3 mb-0 py-2" data-submit-status role="status">
        <i class="bi bi-hourglass-split me-1"></i>
        Saving the match and sending any enabled notifications. Please wait and do not submit again.
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-pv" data-submit-button><i class="bi bi-check-lg"></i> Save Match</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-cancel-button>Cancel</button>
    </div>
</form>
