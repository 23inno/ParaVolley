@model IEnumerable<Match>

@{
    ViewData["Title"] = "Competitions & Matches";

    var isAuthenticated =
        User.Identity != null &&
        User.Identity.IsAuthenticated;

    var totalCount =
        ViewBag.TotalCount is int count
            ? count
            : Model.Count();

    var filteredCount = Model.Count();

    var hasActiveFilters =
        !string.IsNullOrWhiteSpace((string?)ViewBag.SelectedTournament)
        || !string.IsNullOrWhiteSpace((string?)ViewBag.SelectedStatus);

    // Public competition data comes directly from the REAL Match model.
    var upcomingMatches = Model
        .Where(m =>
            m.Status == MatchStatus.Scheduled &&
            m.Date >= DateTime.Today)
        .OrderBy(m => m.Date)
        .ToList();

    var liveMatches = Model
    .Where(m =>
        m.Status == MatchStatus.InProgress &&
        m.Date >= DateTime.Today &&
        m.Date < DateTime.Today.AddDays(1))
    .OrderBy(m => m.Date)
    .ToList();

    var matchResults = Model
        .Where(m => m.Status == MatchStatus.Completed)
        .OrderByDescending(m => m.Date)
        .ToList();

    var publicTournamentCount = Model
        .Where(m => !string.IsNullOrWhiteSpace(m.Tournament))
        .Select(m => m.Tournament)
        .Distinct()
        .Count();
}

@if (!isAuthenticated)
{
    <!-- =====================================================
         PUBLIC COMPETITIONS & MATCHES
         ===================================================== -->

    <section class="competition-page">

        <!-- =================================================
             HERO
             ================================================= -->
        <section class="competition-hero">

            <div class="container">

                <div class="competition-hero-content">

                    <div class="competition-hero-label">

                        <i class="bi bi-trophy-fill"></i>

                        <span>
                            PARAVOLLEY MPUMALANGA
                        </span>

                    </div>


                    <h1>
                        Competitions
                        <span>& Matches.</span>
                    </h1>


                    <p>
                        Follow upcoming tournaments, scheduled matches and
                        competition results across ParaVolley Mpumalanga.
                        Stay connected with the athletes and teams representing
                        our province.
                    </p>


                    <div class="competition-hero-actions">

                        <a asp-controller="Events"
                           asp-action="Index"
                           class="competition-hero-btn competition-hero-btn-primary">

                            <i class="bi bi-calendar-event-fill"></i>

                            View Upcoming Events

                        </a>


                        <a href="#upcoming-matches"
                           class="competition-hero-btn competition-hero-btn-outline">

                            <i class="bi bi-trophy-fill"></i>

                            View Matches

                        </a>

                    </div>

                </div>


                <!-- Hero Stats -->
                <div class="competition-hero-stat-row">

                    <div class="competition-hero-stat">

                        <i class="bi bi-calendar2-event"></i>

                        <div>

                            <strong>
                                @upcomingMatches.Count
                            </strong>

                            <span>
                                Scheduled Matches
                            </span>

                        </div>

                    </div>


                    <div class="competition-hero-stat">

                        <i class="bi bi-broadcast"></i>

                        <div>

                            <strong>
                                @liveMatches.Count
                            </strong>

                            <span>
                                In Progress
                            </span>

                        </div>

                    </div>


                    <div class="competition-hero-stat">

                        <i class="bi bi-trophy"></i>

                        <div>

                            <strong>
                                @publicTournamentCount
                            </strong>

                            <span>
                                Tournaments
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             COMPETITION INTRODUCTION
             ================================================= -->
        <section class="competition-intro">

            <div class="container">

                <div class="competition-section-heading">

                    <span class="competition-label">
                        COMPETITIONS
                    </span>


                    <h2>
                        Creating Opportunities
                        <span>Through Competition.</span>
                    </h2>


                    <div class="competition-line"></div>


                    <p>
                        ParaVolley Mpumalanga creates opportunities for athletes
                        to participate in tournaments, friendly matches,
                        training competitions and other sporting events.
                    </p>

                </div>


                <div class="row g-4 mt-4">

                    <!-- Tournaments -->
                    <div class="col-md-4">

                        <div class="competition-card">

                            <div class="competition-icon">
                                <i class="bi bi-trophy-fill"></i>
                            </div>

                            <span class="competition-card-number">
                                01
                            </span>

                            <h3>
                                Tournaments
                            </h3>

                            <p>
                                Take part in organised tournaments that provide
                                athletes with opportunities to compete, develop
                                their skills and represent ParaVolley Mpumalanga.
                            </p>

                            <a asp-controller="Events"
                               asp-action="Index"
                               class="competition-card-link">

                                View Tournaments

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Matches -->
                    <div class="col-md-4">

                        <div class="competition-card">

                            <div class="competition-icon">
                                <i class="bi bi-dribbble"></i>
                            </div>

                            <span class="competition-card-number">
                                02
                            </span>

                            <h3>
                                Matches
                            </h3>

                            <p>
                                Follow scheduled matches, participating teams,
                                venues, scores and competition results throughout
                                the season.
                            </p>

                            <a href="#upcoming-matches"
                               class="competition-card-link">

                                View Matches

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>


                    <!-- Athlete Participation -->
                    <div class="col-md-4">

                        <div class="competition-card">

                            <div class="competition-icon">
                                <i class="bi bi-person-check-fill"></i>
                            </div>

                            <span class="competition-card-number">
                                03
                            </span>

                            <h3>
                                Athlete Participation
                            </h3>

                            <p>
                                Give athletes meaningful opportunities to compete,
                                gain experience, build confidence and progress
                                through the sporting pathway.
                            </p>

                            <a asp-controller="Home"
                               asp-action="About"
                               asp-fragment="athlete-development"
                               class="competition-card-link">

                                Athlete Development

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             UPCOMING MATCHES
             ================================================= -->
        <section id="upcoming-matches"
                 class="competition-matches-section">

            <div class="container">

                <div class="competition-section-heading">

                    <span class="competition-label">
                        UPCOMING MATCHES
                    </span>

                    <h2>
                        Game Day
                        <span>Starts Here.</span>
                    </h2>

                    <p>
                        Follow upcoming ParaVolley matches, including
                        participating teams, venues, tournament information
                        and match times.
                    </p>

                </div>


                @if (upcomingMatches.Any())
                {
                    <div class="competition-matches-list">

                        @foreach (var match in upcomingMatches)
                        {
                            <article class="competition-match-card">

                                <!-- Date -->
                                <div class="competition-match-date">

                                    <span>
                                        @match.Date.ToString("MMM")
                                    </span>

                                    <strong>
                                        @match.Date.ToString("dd")
                                    </strong>

                                    <small>
                                        @match.Date.ToString("yyyy")
                                    </small>

                                </div>


                                <div class="competition-match-main">

                                    <!-- Top -->
                                    <div class="competition-match-top">

                                        <span class="competition-match-status">

                                            <i class="bi bi-circle-fill"></i>

                                            <span>
                                                Scheduled
                                            </span>

                                        </span>


                                        <span class="competition-match-tournament">

                                            <i class="bi bi-trophy-fill"></i>

                                            @match.Tournament

                                        </span>

                                    </div>


                                    <!-- Teams -->
                                    <div class="competition-match-teams">

                                        <!-- Team A -->
                                        <div class="competition-team">

                                            <span class="competition-team-label">
                                                HOME TEAM
                                            </span>

                                            <div class="competition-team-name">

                                                <div class="competition-team-icon">

                                                    <i class="bi bi-shield-fill"></i>

                                                </div>

                                                <h3>
                                                    @match.TeamA
                                                </h3>

                                            </div>

                                        </div>


                                        <!-- VS -->
                                        <div class="competition-match-vs">

                                            <span>
                                                VS
                                            </span>

                                        </div>


                                        <!-- Team B -->
                                        <div class="competition-team competition-team-right">

                                            <span class="competition-team-label">
                                                AWAY TEAM
                                            </span>

                                            <div class="competition-team-name competition-team-name-right">

                                                <h3>
                                                    @match.TeamB
                                                </h3>

                                                <div class="competition-team-icon">

                                                    <i class="bi bi-shield-fill"></i>

                                                </div>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Match Details -->
                                    <div class="competition-match-details">

                                        <span>

                                            <i class="bi bi-clock-fill"></i>

                                            <strong>
                                                Time
                                            </strong>

                                            @match.Time

                                        </span>


                                        <span>

                                            <i class="bi bi-geo-alt-fill"></i>

                                            <strong>
                                                Venue
                                            </strong>

                                            @match.Venue

                                        </span>


                                        <span>

                                            <i class="bi bi-trophy-fill"></i>

                                            <strong>
                                                Tournament
                                            </strong>

                                            @match.Tournament

                                        </span>

                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <div class="competition-empty-state">

                        <i class="bi bi-calendar-x"></i>

                        <h3>
                            No Upcoming Matches
                        </h3>

                        <p>
                            There are currently no upcoming matches scheduled.
                        </p>

                    </div>
                }

            </div>

        </section>


        <!-- =================================================
             MATCH RESULTS
             ================================================= -->
        <section id="match-results"
                 class="competition-results-section">

            <div class="container">

                <div class="competition-results-heading">

                    <span class="competition-results-label">
                        MATCH HISTORY
                    </span>


                    <h2>
                        Recent Match
                        <span>Results.</span>
                    </h2>


                    <div class="competition-results-line"></div>


                    <p>
                        View previous ParaVolley match results and recent
                        competitive activity from across Mpumalanga.
                    </p>

                </div>


                @if (matchResults.Any())
                {
                    <div class="competition-results-list">

                        @foreach (var match in matchResults)
                        {
                            <article class="competition-result-card">

                                <!-- Result Top -->
                                <div class="competition-result-top">

                                    <div>

                                        <span class="competition-result-tournament">
                                            @match.Tournament
                                        </span>

                                        <div class="competition-result-date">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @match.Date.ToString("dd MMM yyyy")

                                        </div>

                                    </div>


                                    <span class="competition-result-status">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Completed

                                    </span>

                                </div>


                                <!-- Match Result -->
                                <div class="competition-result-match">

                                    <!-- Team A -->
                                    <div class="competition-result-team">

                                        <div class="competition-result-team-icon">

                                            <i class="bi bi-shield-fill"></i>

                                        </div>

                                        <strong>
                                            @match.TeamA
                                        </strong>

                                    </div>


                                    <!-- Score -->
                                    <div class="competition-result-score">

                                        <span>
                                            FINAL
                                        </span>


                                        @if (match.ScoreA.HasValue &&
                                            match.ScoreB.HasValue)
                                        {
                                            <strong>
                                                @match.ScoreA - @match.ScoreB
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong>
                                                -
                                            </strong>
                                        }

                                    </div>


                                    <!-- Team B -->
                                    <div class="competition-result-team competition-result-team-right">

                                        <div class="competition-result-team-icon">

                                            <i class="bi bi-shield-fill"></i>

                                        </div>

                                        <strong>
                                            @match.TeamB
                                        </strong>

                                    </div>

                                </div>


                                <!-- Footer -->
                                <div class="competition-result-footer">

                                    <div>

                                        <i class="bi bi-geo-alt-fill"></i>

                                        @match.Venue

                                    </div>


                                    <div>

                                        <i class="bi bi-clock-fill"></i>

                                        @match.Time

                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <div class="competition-results-empty">

                        <div class="competition-results-empty-icon">

                            <i class="bi bi-trophy-fill"></i>

                        </div>

                        <h3>
                            No Match Results Yet
                        </h3>

                        <p>
                            Completed match results will appear here
                            once they become available.
                        </p>

                    </div>
                }

            </div>

        </section>


        <!-- =================================================
             ATHLETE PARTICIPATION CTA
             ================================================= -->
        <section id="athlete-participation"
                 class="competition-athletes-section">

            <div class="container">

                <div class="competition-section-heading">

                    <span class="competition-label">
                        ATHLETE PARTICIPATION
                    </span>

                    <h2>
                        Our Athletes.
                        <span>Our Strength.</span>
                    </h2>

                    <p>
                        Our athletes are at the heart of ParaVolley Mpumalanga.
                        We create opportunities for players to participate,
                        compete and develop through sport.
                    </p>

                </div>


                <div class="competition-empty-state">

                    <i class="bi bi-people-fill"></i>

                    <h3>
                        Discover ParaVolley Athletes
                    </h3>

                    <p>
                        Learn more about athlete development, participation
                        and opportunities within ParaVolley Mpumalanga.
                    </p>

                    <a asp-controller="Home"
                       asp-action="About"
                       asp-fragment="athlete-development"
                       class="competition-card-link">

                        Athlete Development

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </section>

    </section>
}
else
{

    <div class="row g-3 mb-3">

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-title">Upcoming</span>
                    <div class="icon-box icon-box-green">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                </div>

                <div class="value">@ViewBag.UpcomingCount</div>
                <div class="change">
                    @ViewBag.UpcomingCount scheduled
                </div>
            </div>
        </div>


        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-title">Completed</span>
                    <div class="icon-box icon-box-gold">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>

                <div class="value">@ViewBag.CompletedCount</div>
                <div class="change">Recorded results</div>
            </div>
        </div>


        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-title">Tournaments</span>
                    <div class="icon-box icon-box-blue">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                </div>

                <div class="value">@ViewBag.TournamentsCount</div>
                <div class="change">Recorded</div>
            </div>
        </div>


        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-title">In Progress</span>
                    <div class="icon-box icon-box-purple">
                        <i class="bi bi-clock-fill"></i>
                    </div>
                </div>

                <div class="value">@ViewBag.InProgressCount</div>
                <div class="change">Today</div>
            </div>
        </div>

    </div>

    <div class="pm-header-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h2 class="pm-title">Match Management</h2>
            <p class="pm-subtitle"><span id="visibleCount">@filteredCount</span> of @totalCount matches</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="search-input-wrap m-0">
                <i class="bi bi-search"></i>
                <input type="text" id="liveSearchInput" class="form-control" placeholder="Search by match ID or team..." autocomplete="off" />
            </div>

            <button type="button" id="filterToggleBtn" class="btn btn-filter-toggle @(hasActiveFilters ? "active" : "")">
                <i class="bi bi-funnel"></i> Filter
            </button>

            <a asp-action="Export" id="exportLink" class="btn btn-pm-outline" asp-route-tournament="@ViewBag.SelectedTournament" asp-route-status="@ViewBag.SelectedStatus">
                <i class="bi bi-download"></i> Export
            </a>

            @if (User.IsInRole("Admin")) { <a asp-action="Create" class="btn btn-pm-add-gold js-modal-trigger"><i class="bi bi-plus-lg"></i> Create Match</a> }
        </div>
    </div>

    <div id="filterPanel" class="filter-panel @(hasActiveFilters ? "" : "d-none")">
        <form method="get" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-4">
                    <label class="d-block">Tournament</label>
                    <select name="tournament" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Tournaments</option>
                        @foreach (var t in (List<string>)ViewBag.Tournaments)
                        {
                            <option value="@t" selected="@(ViewBag.SelectedTournament == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <label class="d-block">Status</label>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Status</option>
                        <option value="Scheduled" selected="@(ViewBag.SelectedStatus == "Scheduled")">Scheduled</option>
                        <option value="InProgress" selected="@(ViewBag.SelectedStatus == "InProgress")">In Progress</option>
                        <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <a asp-action="Index" class="filter-reset">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="pm-table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Teams</th>
                    <th>Score</th>
                    <th>Date &amp; Time</th>
                    <th>Venue</th>
                    <th>Tournament</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="matchTableBody">
                @foreach (var m in Model)
                {
                    var statusClass = m.Status switch
                    {
                        MatchStatus.Scheduled => "scheduled",
                        MatchStatus.InProgress => "inprogress",
                        MatchStatus.Completed => "completed",
                        _ => "cancelled"
                    };
                    var statusIcon = m.Status switch
                    {
                        MatchStatus.Scheduled => "bi-clock",
                        MatchStatus.InProgress => "bi-trophy-fill",
                        MatchStatus.Completed => "bi-check-circle-fill",
                        _ => "bi-x-circle-fill"
                    };
                    var statusLabel = m.Status == MatchStatus.InProgress ? "In Progress" : m.Status.ToString();
                    var matchIdLabel = $"M{m.Id:000}";

                    <tr class="match-row" data-matchid="@matchIdLabel.ToLower()" data-teama="@m.TeamA.ToLower()" data-teamb="@m.TeamB.ToLower()">
                        <td><span class="mm-id">@matchIdLabel</span></td>
                        <td>
                            <div class="mm-team-primary">@m.TeamA</div>
                            <div class="mm-team-secondary">vs @m.TeamB</div>
                        </td>
                        <td>
                            @if (m.ScoreA.HasValue && m.ScoreB.HasValue)
                            {
                                <span class="mm-score">@m.ScoreA &ndash; @m.ScoreB</span>
                            }
                            else
                            {
                                <span class="mm-score empty">&mdash;</span>
                            }
                        </td>
                        <td>
                            <div class="mm-cell-icon-row">
                                <i class="bi bi-calendar3"></i>
                                <div>
                                    <div>@m.Date.ToString("d MMM yyyy")</div>
                                    <div class="mm-cell-sub">@m.Time</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="mm-cell-icon-row"><i class="bi bi-geo-alt"></i> <span>@m.Venue</span></div>
                        </td>
                        <td>@m.Tournament</td>
                        <td>
                            <span class="status-pill-icon @statusClass"><i class="bi @statusIcon"></i> @statusLabel</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@m.Id" class="pm-action-icon view js-modal-trigger" title="View"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@m.Id" class="pm-action-icon edit js-modal-trigger" title="Edit"><i class="bi bi-pencil-square"></i></a><a asp-action="Delete" asp-route-id="@m.Id" class="pm-action-icon delete js-modal-trigger" title="Delete"><i class="bi bi-trash"></i></a> }
                        </td>
                    </tr>
                }
                <tr id="noMatchResults" class="@(Model.Any() ? "d-none" : "")">
                    <td colspan="8" class="text-center text-muted py-4">No matches found.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Shared modal used for Create / View / Edit / Delete - content is loaded via AJAX -->
<div class="modal fade" id="matchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="matchModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div>
            </div>
        </div>
    </div>
</div>

<partial name="_Pagination" />

    @section Scripts
    {
        @if (isAuthenticated)
        {
    <script>
        (function () {
            var toggleBtn = document.getElementById('filterToggleBtn');
            var panel = document.getElementById('filterPanel');
            toggleBtn.addEventListener('click', function () {
                panel.classList.toggle('d-none');
                toggleBtn.classList.toggle('active');
            });

            // ===== Instant, prefix-based client-side search (Match ID OR either team) =====
            var searchInput = document.getElementById('liveSearchInput');
            var rows = Array.from(document.querySelectorAll('.match-row'));
            var visibleCountEl = document.getElementById('visibleCount');
            var noResultsRow = document.getElementById('noMatchResults');

            function applySearch() {
                var query = searchInput.value.trim().toLowerCase();
                var visible = 0;

                rows.forEach(function (row) {
                    var matchId = row.getAttribute('data-matchid') || '';
                    var teamA = row.getAttribute('data-teama') || '';
                    var teamB = row.getAttribute('data-teamb') || '';
                    var matches = query === '' ||
                        matchId.startsWith(query) ||
                        teamA.startsWith(query) ||
                        teamB.startsWith(query);
                    row.style.display = matches ? '' : 'none';
                    if (matches) visible++;
                });

                visibleCountEl.textContent = visible;
                noResultsRow.classList.toggle('d-none', visible !== 0);
            }

            searchInput.addEventListener('input', applySearch);

            var exportLink = document.getElementById('exportLink');
            var exportBaseHref = exportLink.getAttribute('href');
            searchInput.addEventListener('input', function () {
                var url = new URL(exportBaseHref, window.location.origin);
                if (searchInput.value.trim()) {
                    url.searchParams.set('search', searchInput.value.trim());
                } else {
                    url.searchParams.delete('search');
                }
                exportLink.setAttribute('href', url.pathname + url.search);
            });

            // ===== Create / View / Edit / Delete as an in-page modal card =====
            var modalEl = document.getElementById('matchModal');
            var modalContent = document.getElementById('matchModalContent');
            var bsModal = new bootstrap.Modal(modalEl);

            function loadIntoModal(url) {
                modalContent.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div></div>';
                bsModal.show();
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) { return res.text(); })
                    .then(function (html) { modalContent.innerHTML = html; })
                    .catch(function () {
                        modalContent.innerHTML = '<div class="modal-body"><div class="alert alert-danger mb-0">Could not load that match. Please try again.</div></div>';
                    });
            }

            document.addEventListener('click', function (e) {
                var link = e.target.closest('.js-modal-trigger');
                if (link) {
                    e.preventDefault();
                    loadIntoModal(link.getAttribute('href'));
                }
            });

            document.addEventListener('submit', function (e) {
                var form = e.target.closest('.js-ajax-form');
                if (!form || !modalContent.contains(form)) return;

                e.preventDefault();
                var formData = new FormData(form);

                fetch(form.getAttribute('action') || window.location.href, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                }).then(function (res) {
                    var contentType = res.headers.get('content-type') || '';
                    if (contentType.indexOf('application/json') !== -1) {
                        return res.json().then(function (data) {
                            if (data.success) {
                                bsModal.hide();
                                window.location.reload();
                            }
                        });
                    } else {
                        return res.text().then(function (html) { modalContent.innerHTML = html; });
                    }
                }).catch(function () {
                    modalContent.innerHTML = '<div class="modal-body"><div class="alert alert-danger mb-0">Something went wrong saving. Please try again.</div></div>';
                });
            });
        })();
            </script>
        }
    }}
