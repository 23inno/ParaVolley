@model Match
@{
    ViewData["Title"] = "Match Details";
}

<div class="topbar">
    <h2 class="page-title">Match Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="pv-card" style="max-width:600px;">
    <h4 class="fw-bold mb-3">@Model.TeamA <span class="text-muted fw-normal">vs</span> @Model.TeamB</h4>
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Tournament</dt>
        <dd class="col-sm-8">@Model.Tournament</dd>

        <dt class="col-sm-4 text-muted">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 text-muted">Date &amp; Time</dt>
        <dd class="col-sm-8">@Model.Date.ToString("MMM d, yyyy") &middot; @Model.Time</dd>

        <dt class="col-sm-4 text-muted">Venue</dt>
        <dd class="col-sm-8">@Model.Venue</dd>

        <dt class="col-sm-4 text-muted">Score</dt>
        <dd class="col-sm-8">
            @if (Model.ScoreA.HasValue && Model.ScoreB.HasValue)
            {
                @($"{Model.ScoreA} - {Model.ScoreB}")
            }
            else
            {
                <span class="text-muted">Not yet played</span>
            }
        </dd>
    </dl>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>
