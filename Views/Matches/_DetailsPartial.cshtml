@model Match

<div class="modal-header">
    <h5 class="modal-title fw-bold">Match Details</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <h4 class="fw-bold mb-3">@Model.TeamA <span class="text-muted fw-normal">vs</span> @Model.TeamB</h4>
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Tournament</dt>
        <dd class="col-sm-8">@Model.Tournament</dd>

        <dt class="col-sm-4 text-muted">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 text-muted">Date &amp; Time</dt>
        <dd class="col-sm-8">@Model.Date.ToString("MMM d, yyyy") &middot; @Model.Time</dd>

        <dt class="col-sm-4 text-muted">Venue</dt>
        <dd class="col-sm-8">@Model.Venue</dd>

        <dt class="col-sm-4 text-muted">Score</dt>
        <dd class="col-sm-8">
            @if (Model.ScoreA.HasValue && Model.ScoreB.HasValue)
            {
                @($"{Model.ScoreA} - {Model.ScoreB}")
            }
            else
            {
                <span class="text-muted">Not yet played</span>
            }
        </dd>
    </dl>
</div>
<div class="modal-footer">
    <a asp-controller="Matches" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv js-modal-trigger"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-controller="Matches" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger js-modal-trigger"><i class="bi bi-trash"></i> Delete</a>
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
</div>
