@model Match

<div class="modal-header">
    <h5 class="modal-title fw-bold">Delete Match</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this match? This cannot be undone.</div>

    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Match</dt>
        <dd class="col-sm-8">@Model.TeamA vs @Model.TeamB</dd>
        <dt class="col-sm-4 text-muted">Date</dt>
        <dd class="col-sm-8">@Model.Date.ToString("MMM d, yyyy")</dd>
        <dt class="col-sm-4 text-muted">Venue</dt>
        <dd class="col-sm-8">@Model.Venue</dd>
    </dl>
</div>
<form asp-action="Delete" method="post" class="js-ajax-form">
    <input type="hidden" asp-for="Id" />
    <div class="modal-footer">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
