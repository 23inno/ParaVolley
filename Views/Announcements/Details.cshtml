@model Announcement
@{
    ViewData["Title"] = Model.Title;
}

<div class="topbar">
    <h2 class="page-title">Announcement</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="pv-card" style="max-width:700px;">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <span class="badge bg-secondary-subtle text-dark">@Model.Category</span>
        @if (Model.IsPinned)
        {
            <span class="badge badge-pinned"><i class="bi bi-pin-angle-fill"></i> Pinned</span>
        }
    </div>
    <h3 class="fw-bold">@Model.Title</h3>
    <div class="text-muted small mb-4">
        By @Model.Author &middot; @Model.Date.ToString("MMMM d, yyyy") &middot; <i class="bi bi-eye"></i> @Model.Views views
    </div>
    <p style="white-space: pre-line;">@Model.Content</p>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>
