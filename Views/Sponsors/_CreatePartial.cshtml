@model Sponsor

<div class="modal-header">
    <h5 class="modal-title fw-bold">Add a New Sponsor</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="Create"
      method="post"
      class="js-ajax-form"
      onsubmit="
          if (this.dataset.submitting === 'true') {
              event.preventDefault();
              event.stopPropagation();
              return false;
          }

          this.dataset.submitting = 'true';
          this.setAttribute('aria-busy', 'true');

          var submitButton = this.querySelector('[data-submit-button]');
          var cancelButton = this.querySelector('[data-cancel-button]');
          var statusMessage = this.querySelector('[data-submit-status]');
          var modalContent = this.closest('.modal-content');
          var closeButton = modalContent ? modalContent.querySelector('.btn-close') : null;

          if (submitButton) {
              submitButton.disabled = true;
              submitButton.textContent = 'Saving Sponsor...';
          }

          if (cancelButton) cancelButton.disabled = true;
          if (closeButton) closeButton.disabled = true;
          if (statusMessage) statusMessage.classList.remove('d-none');
      ">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" placeholder="Sponsor or business name" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-0">
            <label asp-for="Tier" class="form-label fw-semibold"></label>
            <select asp-for="Tier" class="form-select">
                <option value="Gold">Gold Sponsor</option>
                <option value="Silver">Silver Sponsor</option>
                <option value="Bronze">Bronze Sponsor</option>
            </select>
        </div>
    </div>

    <div class="alert alert-info d-none mx-3 mb-0 py-2" data-submit-status role="status">
        <i class="bi bi-hourglass-split me-1"></i>
        Saving the sponsor. Please wait and do not submit again.
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-pv" data-submit-button><i class="bi bi-check-lg"></i> Save Sponsor</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-cancel-button>Cancel</button>
    </div>
</form>
