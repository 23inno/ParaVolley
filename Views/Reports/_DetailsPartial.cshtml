@model Report
@{
    var typePillClass = Model.Type switch
    {
        ReportType.Performance => "rt-performance",
        ReportType.Attendance => "rt-attendance",
        ReportType.Tournament => "rt-tournament",
        ReportType.Training => "rt-training",
        ReportType.Financial => "rt-financial",
        _ => "rt-analysis"
    };
}

<div class="modal-header">
    <h5 class="modal-title fw-bold">Report Details</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <h4 class="fw-bold mb-3">@Model.Title</h4>

    <div class="d-flex gap-2 mb-3">
        <span class="report-type-pill @typePillClass">@Model.Type</span>
        <span class="report-status-pill @(Model.Status == ReportStatus.Published ? "published" : "draft")">@Model.Status</span>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Date</dt>
        <dd class="col-sm-8">@Model.Date.ToString("d MMM yyyy")</dd>

        <dt class="col-sm-4 text-muted">File Size</dt>
        <dd class="col-sm-8">@Model.SizeLabel</dd>

        <dt class="col-sm-4 text-muted">Attached File</dt>
        <dd class="col-sm-8">@(Model.FileName ?? "None (auto-generated summary)")</dd>
    </dl>
</div>
<div class="modal-footer">
    <a asp-controller="Reports" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-pv"><i class="bi bi-download"></i> Download</a>
    <a asp-controller="Reports" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary js-modal-trigger"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-controller="Reports" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger js-modal-trigger"><i class="bi bi-trash"></i> Delete</a>
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
</div>
