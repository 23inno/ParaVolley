@model PlayerRegistrationApplication

@{
    ViewData["Title"] = "Player Application";

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
        OperatingSystem.IsWindows()
            ? "South Africa Standard Time"
            : "Africa/Johannesburg");

    var submittedSa = TimeZoneInfo
        .ConvertTimeFromUtc(Model.SubmittedAtUtc, saTimeZone)
        .ToString("dd MMMM yyyy 'at' HH:mm");

    var dateOfBirth = Model.DateOfBirth.HasValue
        ? Model.DateOfBirth.Value.ToString("dd MMMM yyyy")
        : "Not provided";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center
                gap-3 mb-4">

        <div>

            <a asp-controller="PlayerApplications"
               asp-action="Index"
               class="text-decoration-none text-muted">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Player Applications

            </a>

            <h1 class="fw-bold mt-2 mb-1">
                @Model.FullName
            </h1>

            <p class="text-muted mb-0">
                Submitted @submittedSa
            </p>

        </div>


        <div>

            @if (Model.Status == PlayerApplicationStatus.Pending)
            {
                <span class="badge bg-warning text-dark px-3 py-2">
                    <i class="bi bi-hourglass-split me-1"></i>
                    Pending
                </span>
            }
            else if (Model.Status == PlayerApplicationStatus.Approved)
            {
                <span class="badge bg-success px-3 py-2">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Approved
                </span>
            }
            else
            {
                <span class="badge bg-secondary px-3 py-2">
                    <i class="bi bi-x-circle-fill me-1"></i>
                    Declined
                </span>
            }

        </div>

    </div>

    @if (TempData["ApplicationSuccess"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["ApplicationSuccess"]
        </div>
    }

    @if (TempData["ApplicationError"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ApplicationError"]
        </div>
    }

    <div class="row g-4">

        <!-- PERSONAL INFORMATION -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-person-fill
                                  text-success me-2"></i>

                        Personal Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Full Name
                        </small>

                        <strong>
                            @Model.FullName
                        </strong>
                    </div>


                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Email Address
                        </small>

                        <a href="mailto:@Model.Email"
                           class="text-decoration-none">

                            @Model.Email

                        </a>
                    </div>


                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Phone Number
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                        {
                            <a href="tel:@Model.Phone"
                               class="text-decoration-none">

                                @Model.Phone

                            </a>
                        }
                        else
                        {
                            <span>Not provided</span>
                        }
                    </div>


                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Date of Birth
                        </small>

                        <span>@dateOfBirth</span>
                    </div>


                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Province
                        </small>

                        <span>
                            @(string.IsNullOrWhiteSpace(Model.Province)
                                                        ? "Not provided"
                                                        : Model.Province)
                        </span>
                    </div>


                    <div>
                        <small class="text-muted d-block">
                            Town / City
                        </small>

                        <span>
                            @(string.IsNullOrWhiteSpace(Model.Town)
                                                        ? "Not provided"
                                                        : Model.Town)
                        </span>
                    </div>

                </div>

            </div>

        </div>


        <!-- PLAYER INFORMATION -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-trophy-fill
                                  text-success me-2"></i>

                        Player Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Experience Level
                        </small>

                        <span>
                            @(string.IsNullOrWhiteSpace(Model.ExperienceLevel)
                                                        ? "Not provided"
                                                        : Model.ExperienceLevel)
                        </span>

                    </div>


                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Preferred Position
                        </small>

                        <span>
                            @(string.IsNullOrWhiteSpace(Model.PreferredPosition)
                                                        ? "Not provided"
                                                        : Model.PreferredPosition)
                        </span>

                    </div>


                    <div>

                        <small class="text-muted d-block mb-1">
                            Classification / Participation Information
                        </small>

                        <div class="bg-light rounded p-3">

                            @(string.IsNullOrWhiteSpace(Model.Classification)
                                                        ? "No information provided."
                                                        : Model.Classification)

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- EMERGENCY CONTACT -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-shield-check
                                  text-success me-2"></i>

                        Emergency Contact

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Contact Name
                        </small>

                        <span>
                            @(string.IsNullOrWhiteSpace(
                                                        Model.EmergencyContactName)
                                                        ? "Not provided"
                                                        : Model.EmergencyContactName)
                        </span>

                    </div>


                    <div>

                        <small class="text-muted d-block">
                            Contact Number
                        </small>

                        @if (!string.IsNullOrWhiteSpace(
                                                Model.EmergencyContactPhone))
                        {
                            <a href="tel:@Model.EmergencyContactPhone"
                               class="text-decoration-none">

                                @Model.EmergencyContactPhone

                            </a>
                        }
                        else
                        {
                            <span>Not provided</span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- SUPPORT INFORMATION -->
        <div class="col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-bold mb-0">

                        <i class="bi bi-heart-fill
                                  text-success me-2"></i>

                        Additional Support Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="bg-light rounded p-3">

                        @if (string.IsNullOrWhiteSpace(Model.MedicalNotes))
                        {
                            <span class="text-muted">
                                No additional information provided.
                            </span>
                        }
                        else
                        {
                            <span style="white-space: pre-wrap;">@Model.MedicalNotes</span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    @if (Model.Status == PlayerApplicationStatus.Pending)
    {
        <div class="card border-0 shadow-sm mt-4">

            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-check-fill text-success me-2"></i>
                    Review Application
                </h5>
            </div>

            <div class="card-body">

                <p class="text-muted">
                    Confirm the player's official details before approving
                    this application and adding them to the Players list.
                </p>

                <form asp-controller="PlayerApplications"
                      asp-action="Approve"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Official Position
                            </label>

                            <select name="Position"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select position
                                </option>

                                <option value="Outside Hitter"
                                        selected="@(Model.PreferredPosition == "Outside Hitter")">
                                    Outside Hitter
                                </option>

                                <option value="Setter"
                                        selected="@(Model.PreferredPosition == "Setter")">
                                    Setter
                                </option>

                                <option value="Middle Blocker"
                                        selected="@(Model.PreferredPosition == "Middle Blocker")">
                                    Middle Blocker
                                </option>

                                <option value="Libero"
                                        selected="@(Model.PreferredPosition == "Libero")">
                                    Libero
                                </option>

                                <option value="Opposite Hitter"
                                        selected="@(Model.PreferredPosition == "Opposite Hitter")">
                                    Opposite Hitter
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Team
                            </label>

                            <select name="Team"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select team
                                </option>

                                <option value="Team A">Team A</option>
                                <option value="Team B">Team B</option>
                                <option value="Team C">Team C</option>
                                <option value="Team D">Team D</option>

                            </select>

                        </div>


                    </div>


                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle-fill me-2"></i>
                            Approve & Add Player

                        </button>

                    </div>

                </form>


                <hr class="my-4" />


                <div class="d-flex flex-wrap
                            justify-content-between
                            align-items-center
                            gap-3">

                    <div>
                        <h6 class="fw-bold mb-1">
                            Decline Application
                        </h6>

                        <p class="text-muted mb-0">
                            This will mark the application as declined.
                            It will not delete the application.
                        </p>
                    </div>


                    <button type="button"
                            class="btn btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#declineApplicationModal">

                        <i class="bi bi-x-circle-fill me-2"></i>
                        Decline Application

                    </button>

                </div>

            </div>

        </div>
    }

    <!-- DECLINE APPLICATION CONFIRMATION MODAL -->
    <div class="modal fade"
         id="declineApplicationModal"
         tabindex="-1"
         aria-labelledby="declineApplicationModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="declineApplicationModalLabel">

                        <i class="bi bi-exclamation-triangle-fill
                              text-danger me-2"></i>

                        Decline Player Application

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-2">
                        Are you sure you want to decline
                        <strong>@Model.FullName</strong>'s application?
                    </p>

                    <p class="text-muted mb-0">
                        The application will be marked as declined,
                        but it will not be deleted.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel

                    </button>


                    <form asp-controller="PlayerApplications"
                          asp-action="Decline"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-x-circle-fill me-2"></i>
                            Yes, Decline Application

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <!-- CONTACT APPLICANT -->
    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body
                    d-flex
                    flex-wrap
                    justify-content-between
                    align-items-center
                    gap-3">

            <div>

                <h5 class="fw-bold mb-1">
                    Contact Applicant
                </h5>

                <p class="text-muted mb-0">
                    Contact the applicant if additional
                    information is required.
                </p>

            </div>

            <a href="mailto:@Model.Email?subject=ParaVolley%20Mpumalanga%20Player%20Application"
               class="btn btn-success">

                <i class="bi bi-envelope-fill me-2"></i>
                Email Applicant

            </a>

        </div>

    </div>

</div>