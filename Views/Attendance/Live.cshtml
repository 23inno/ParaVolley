@model LiveAttendanceViewModel
@{
    ViewData["Title"] = "Live Attendance";
    var selectedEventId = Model.SelectedEventId ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="page-title mb-0">Live Attendance</h2>
        </div>
        <p class="text-muted mb-0">Monitor QR check-ins, manage the live session and handle manual attendance.</p>
    </div>

    <div style="min-width:300px;max-width:460px;width:100%;">
        <label for="eventPicker" class="form-label small fw-semibold mb-1">Event</label>
        <select id="eventPicker" class="form-select">
            @if (!Model.Events.Any())
            {
                <option value="">No events available</option>
            }
            else
            {
                @foreach (var eventItem in Model.Events)
                {
                    <option value="@eventItem.Id" selected="@(eventItem.Id == selectedEventId)">
                        @eventItem.Date.ToString("dd MMM yyyy") — @eventItem.Title
                    </option>
                }
            }
        </select>
    </div>
</div>

<form id="antiForgeryForm" class="d-none">
    @Html.AntiForgeryToken()
</form>

@if (Model.SelectedEvent == null)
{
    <div class="pv-card text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <h4 class="mt-3">No event selected</h4>
        <p class="text-muted mb-0">Create or select an event before starting a live attendance session.</p>
    </div>
}
else
{
    <div id="liveFeedback" class="alert d-none mb-3" role="alert"></div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="stat-card live-summary-card">
                <div class="stat-top">
                    <span class="stat-title">Registered</span>
                    <div class="icon-box icon-box-green"><i class="bi bi-person-check-fill"></i></div>
                </div>
                <div class="value" id="registeredCount">0</div>
                <div class="change">Players registered</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card live-summary-card">
                <div class="stat-top">
                    <span class="stat-title">Checked In</span>
                    <div class="icon-box icon-box-green"><i class="bi bi-check2-circle"></i></div>
                </div>
                <div class="value" id="checkedInCount">0</div>
                <div class="change">Present now</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card live-summary-card">
                <div class="stat-top">
                    <span class="stat-title">Not Checked In</span>
                    <div class="icon-box icon-box-gold"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <div class="value" id="remainingCount">0</div>
                <div class="change">Still remaining</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card live-summary-card">
                <div class="stat-top">
                    <span class="stat-title">Attendance Rate</span>
                    <div class="icon-box icon-box-blue"><i class="bi bi-graph-up-arrow"></i></div>
                </div>
                <div class="value" id="attendanceRate">0%</div>
                <div class="change">Live event rate</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-xl-5">
            <div class="pv-card h-100 live-session-card">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">QR Attendance Session</div>
                        <h4 class="mb-1" id="sessionEventTitle">@Model.SelectedEvent.Title</h4>
                        <div class="text-muted small">
                            <i class="bi bi-geo-alt me-1"></i>@Model.SelectedEvent.Location
                            <span class="mx-1">•</span>
                            @Model.SelectedEvent.Date.ToString("dd MMM yyyy") @Model.SelectedEvent.Time
                        </div>
                    </div>
                    <span id="sessionBadge" class="live-session-badge idle">
                        <span class="live-dot"></span> NOT STARTED
                    </span>
                </div>

                <div id="countdownPanel" class="live-countdown-panel mb-3">
                    <div class="small text-muted">Session countdown</div>
                    <div id="sessionCountdown" class="live-countdown">--:--</div>
                    <div id="sessionHint" class="small text-muted">Generate attendance access for today. It stays valid until the end of the day.</div>
                </div>

                <div id="qrPanel" class="live-qr-panel mb-3">
                    <div id="qrCode" class="live-qr-code"></div>
                    <div id="qrPlaceholder" class="text-center text-muted py-4">
                        <i class="bi bi-qr-code fs-1 d-block mb-2"></i>
                        No active QR code
                    </div>
                </div>

                <div class="border rounded-3 bg-light p-3 mb-3 text-center">
                    <div class="small text-muted fw-semibold text-uppercase">
                        Manual check-in code
                    </div>
                    <div id="manualAttendanceCode"
                         class="fs-2 fw-bold text-success"
                         style="letter-spacing:.35rem;">------</div>
                    <div class="small text-muted">
                        Players can type this 6-character code in the mobile app.
                    </div>
                </div>

                <div class="d-grid gap-2 d-sm-flex">
                    <button type="button" id="generateQrBtn" class="btn btn-pv flex-fill">
                        <i class="bi bi-qr-code-scan me-1"></i>
                        <span id="generateQrText">Generate QR</span>
                    </button>
                    <button type="button" id="endSessionBtn" class="btn btn-outline-danger flex-fill" disabled>
                        <i class="bi bi-stop-circle me-1"></i> End Attendance Session
                    </button>
                </div>

            </div>
        </div>

        <div class="col-xl-7">
            <div class="pv-card h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">Live Player Check-ins</h5>
                        <div class="text-muted small">Updates automatically every 3 seconds.</div>
                    </div>
                    <div class="live-search-wrap">
                        <i class="bi bi-search"></i>
                        <input type="search" id="playerSearch" class="form-control" placeholder="Search player..." autocomplete="off" />
                    </div>
                </div>

                <div class="live-tabs mb-3">
                    <button type="button" class="live-tab active" data-tab="checked">
                        Checked In (<span id="checkedTabCount">0</span>)
                    </button>
                    <button type="button" class="live-tab" data-tab="waiting">
                        Waiting (<span id="waitingTabCount">0</span>)
                    </button>
                </div>

                <div id="checkedPanel" class="live-player-panel"></div>
                <div id="waitingPanel" class="live-player-panel d-none"></div>
            </div>
        </div>
    </div>

    <div class="pv-card" id="scanErrorsCard">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <div>
                <h5 class="mb-1">Recent Scan Feedback</h5>
                <div class="text-muted small">Duplicate, expired and unregistered scan attempts from the last 10 minutes.</div>
            </div>
            <i class="bi bi-info-circle text-muted fs-5"></i>
        </div>
        <div id="scanErrorsList" class="text-muted small">No recent scan errors.</div>
    </div>

    <div class="modal fade"
         id="endAttendanceModal"
         tabindex="-1"
         aria-labelledby="endAttendanceModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 end-attendance-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="end-attendance-icon">
                            <i class="bi bi-stop-circle-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-1" id="endAttendanceModalLabel">
                                End attendance session?
                            </h5>
                            <div class="small opacity-75">
                                This action stops all further check-ins.
                            </div>
                        </div>
                    </div>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="mb-3">
                        You are about to end attendance for
                        <strong id="endAttendanceEventName">@Model.SelectedEvent.Title</strong>.
                    </p>

                    <div class="end-attendance-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            The QR code and the 6-character manual code will stop working immediately.
                            <div class="small mt-1">
                                <span id="endAttendanceRemainingCount">0</span>
                                registered player(s) have not checked in yet.
                            </div>
                        </div>
                    </div>

                    <div class="form-check end-attendance-option">
                        <input class="form-check-input"
                               type="checkbox"
                               id="markRemainingAbsent" />
                        <label class="form-check-label" for="markRemainingAbsent">
                            <strong>Mark remaining registered players as absent</strong>
                            <span class="d-block small text-muted mt-1">
                                Leave this unchecked if you only want to close the attendance session.
                            </span>
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-0 px-4 pb-4 pt-0">
                    <button type="button"
                            class="btn btn-light border px-4"
                            data-bs-dismiss="modal">
                        Keep Session Open
                    </button>
                    <button type="button"
                            id="confirmEndSessionBtn"
                            class="btn btn-danger px-4">
                        <i class="bi bi-stop-circle me-1"></i>
                        <span id="confirmEndSessionText">End Session</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .live-summary-card { min-height: 132px; }
    .live-session-card { min-height: 560px; }
    .live-session-badge {
        display:inline-flex;align-items:center;gap:.45rem;
        padding:.38rem .65rem;border-radius:999px;font-size:.76rem;font-weight:800;
        white-space:nowrap;border:1px solid #d9dee3;background:#f8f9fa;color:#6c757d;
    }
    .live-session-badge.live { background:#e8f5ef;color:#08754f;border-color:#bde2d2; }
    .live-session-badge.warning { background:#fff5d6;color:#805e00;border-color:#f3d878; }
    .live-session-badge.ended { background:#f3f4f6;color:#6b7280;border-color:#d9dee3; }
    .live-dot { width:8px;height:8px;border-radius:50%;background:currentColor;display:inline-block; }
    .live-countdown-panel {
        display:flex;align-items:center;justify-content:space-between;gap:1rem;
        border:1px solid var(--pv-border);border-radius:.85rem;padding:.8rem 1rem;background:#f8faf9;
    }
    .live-countdown { font-size:1.35rem;font-weight:800;color:var(--pv-green);font-variant-numeric:tabular-nums; }
    .live-countdown-panel .small:last-child { margin-left:auto;text-align:right;max-width:190px; }
    .live-qr-panel {
        min-height:275px;border:1px dashed #cfd7d3;border-radius:1rem;
        display:flex;align-items:center;justify-content:center;background:#fff;
    }
    .live-qr-code { padding:14px;background:#fff;border-radius:.75rem; }
    .live-qr-code img, .live-qr-code canvas { display:block!important;max-width:220px!important;height:auto!important; }
    .live-search-wrap { position:relative;min-width:240px; }
    .live-search-wrap i { position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#6c757d; }
    .live-search-wrap .form-control { padding-left:2.25rem; }
    .live-tabs { display:flex;gap:.35rem;border-bottom:1px solid #e6e9ec; }
    .live-tab { border:0;background:transparent;padding:.65rem .9rem;font-weight:700;color:#6c757d;border-bottom:3px solid transparent; }
    .live-tab.active { color:var(--pv-green);border-bottom-color:var(--pv-green); }
    .live-player-panel { min-height:300px;max-height:430px;overflow:auto; }
    .live-player-row {
        display:flex;align-items:center;justify-content:space-between;gap:1rem;
        padding:.85rem .25rem;border-bottom:1px solid #eef0f2;transition:background-color .4s ease;
    }
    .live-player-row:last-child { border-bottom:0; }
    .live-player-row.new-checkin { background:#e8f7ef; }
    .live-player-name { font-weight:700;color:#111827; }
    .live-player-meta { color:#6c757d;font-size:.84rem; }
    .live-time { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-weight:700; }
    .live-method-badge { display:inline-block;padding:.2rem .48rem;border-radius:999px;font-size:.72rem;font-weight:700;background:#eef2f1;color:#36534a; }
    .live-method-badge.manual { background:#fff1c2;color:#735600; }
    .live-empty { display:flex;align-items:center;justify-content:center;min-height:260px;color:#8a949e;text-align:center; }
    .scan-error-item { display:flex;gap:.65rem;align-items:flex-start;padding:.55rem 0;border-bottom:1px solid #f0f1f2; }
    .scan-error-item:last-child { border-bottom:0; }
    .end-attendance-modal-header {
        background:linear-gradient(135deg,#b42318,#d92d20);
        color:#fff;
        padding:1.15rem 1.25rem;
    }
    .end-attendance-icon {
        width:46px;height:46px;border-radius:14px;
        display:flex;align-items:center;justify-content:center;
        background:rgba(255,255,255,.16);
        font-size:1.35rem;flex:0 0 auto;
    }
    .end-attendance-warning {
        display:flex;align-items:flex-start;gap:.75rem;
        padding:.9rem 1rem;border-radius:.8rem;
        background:#fff4ed;border:1px solid #ffd6ae;color:#7a2e0e;
    }
    .end-attendance-warning > i { margin-top:.15rem; }
    .end-attendance-option {
        padding:1rem 1rem 1rem 2.6rem;
        border:1px solid #e5e7eb;border-radius:.8rem;background:#f8faf9;
    }
    .end-attendance-option .form-check-input { margin-left:-1.65rem; }
    @@media (max-width: 767.98px) {
        .live-countdown-panel { align-items:flex-start;flex-direction:column; }
        .live-countdown-panel .small:last-child { margin-left:0;text-align:left;max-width:none; }
        .live-search-wrap { width:100%;min-width:0; }
        .live-player-row { align-items:flex-start;flex-direction:column; }
    }
</style>

@if (Model.SelectedEvent != null)
{
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        (function () {
            const eventId = @selectedEventId;
            const antiForgeryToken = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
            const feedback = document.getElementById('liveFeedback');
            const generateBtn = document.getElementById('generateQrBtn');
            const generateText = document.getElementById('generateQrText');
            const endBtn = document.getElementById('endSessionBtn');
            const endModalElement = document.getElementById('endAttendanceModal');
            const endModal = bootstrap.Modal.getOrCreateInstance(endModalElement);
            const confirmEndBtn = document.getElementById('confirmEndSessionBtn');
            const confirmEndText = document.getElementById('confirmEndSessionText');
            const endRemainingCount = document.getElementById('endAttendanceRemainingCount');
            const markAbsent = document.getElementById('markRemainingAbsent');
            const sessionBadge = document.getElementById('sessionBadge');
            const countdownEl = document.getElementById('sessionCountdown');
            const sessionHint = document.getElementById('sessionHint');
            const qrBox = document.getElementById('qrCode');
            const qrPlaceholder = document.getElementById('qrPlaceholder');
            const manualCodeEl = document.getElementById('manualAttendanceCode');
            const searchInput = document.getElementById('playerSearch');
            const checkedPanel = document.getElementById('checkedPanel');
            const waitingPanel = document.getElementById('waitingPanel');
            const errorsList = document.getElementById('scanErrorsList');

            let currentStatus = null;
            let countdownTimer = null;
            let polling = false;
            let initialLoad = true;
            const knownAttendanceIds = new Set();

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function showFeedback(message, type) {
                feedback.className = 'alert alert-' + type + ' mb-3';
                feedback.textContent = message;
                feedback.classList.remove('d-none');
                window.setTimeout(function () {
                    feedback.classList.add('d-none');
                }, 5000);
            }

            async function readJson(response) {
                const contentType = response.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    return await response.json();
                }
                return { message: await response.text() };
            }

            async function post(url, data) {
                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', antiForgeryToken);
                Object.keys(data || {}).forEach(function (key) {
                    body.append(key, data[key]);
                });

                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: body.toString(),
                    credentials: 'same-origin'
                });

                const payload = await readJson(response);
                if (!response.ok) {
                    throw new Error(payload.message || 'The request could not be completed.');
                }
                return payload;
            }

            function tokenKey(sessionId) {
                return 'pv-live-attendance-token-' + sessionId;
            }

            function renderQr(token) {
                qrBox.innerHTML = '';
                manualCodeEl.textContent = token || '------';

                if (!token) {
                    qrBox.classList.add('d-none');
                    qrPlaceholder.classList.remove('d-none');
                    return;
                }

                qrPlaceholder.classList.add('d-none');
                qrBox.classList.remove('d-none');
                new QRCode(qrBox, {
                    text: token,
                    width: 220,
                    height: 220,
                    correctLevel: QRCode.CorrectLevel.M
                });
            }

            function updateCountdown() {
                if (!currentStatus || !currentStatus.session || !currentStatus.session.isLive) {
                    countdownEl.textContent = '--:--';
                    return;
                }

                const expiry = new Date(currentStatus.session.expiresAtUtc).getTime();
                const remainingMs = expiry - Date.now();

                if (remainingMs <= 0) {
                    countdownEl.textContent = '00:00';
                    sessionBadge.className = 'live-session-badge ended';
                    sessionBadge.innerHTML = '<span class="live-dot"></span> EXPIRED';
                    sessionHint.textContent = 'Attendance access has expired. Generate a new code to continue check-ins.';
                    endBtn.disabled = true;
                    generateText.textContent = 'Generate New QR';
                    renderQr(null);
                    return;
                }

                const totalSeconds = Math.ceil(remainingMs / 1000);
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                countdownEl.textContent =
                    String(hours).padStart(2, '0') + ':' +
                    String(minutes).padStart(2, '0') + ':' +
                    String(seconds).padStart(2, '0');

                if (totalSeconds <= 120) {
                    sessionBadge.className = 'live-session-badge warning';
                    sessionBadge.innerHTML = '<span class="live-dot"></span> LIVE';
                    sessionHint.textContent = 'Attendance access expires at the end of today.';
                } else {
                    sessionBadge.className = 'live-session-badge live';
                    sessionBadge.innerHTML = '<span class="live-dot"></span> LIVE';
                    sessionHint.textContent = 'Players can scan the QR code or type the 6-character code until the end of today.';
                }
            }

            function renderSession(session) {
                if (!session) {
                    sessionBadge.className = 'live-session-badge idle';
                    sessionBadge.innerHTML = '<span class="live-dot"></span> NOT STARTED';
                    sessionHint.textContent = 'Generate attendance access that stays valid until the end of today.';
                    generateText.textContent = 'Generate QR';
                    endBtn.disabled = true;
                    renderQr(null);
                    return;
                }

                if (session.isLive) {
                    generateText.textContent = 'Generate New QR';
                    endBtn.disabled = false;

                    const storedToken = sessionStorage.getItem(tokenKey(session.id));
                    renderQr(storedToken);

                    if (!storedToken) {
                        sessionHint.textContent = 'This session is live, but its QR was created in another browser or before a refresh. Generate a new QR to display one here.';
                    }
                } else {
                    sessionBadge.className = 'live-session-badge ended';
                    sessionBadge.innerHTML = '<span class="live-dot"></span> ' + (session.isRevoked ? 'ENDED' : 'EXPIRED');
                    sessionHint.textContent = session.isRevoked
                        ? 'This attendance session has ended.'
                        : 'Attendance access expired. Generate a new code to continue check-ins.';
                    generateText.textContent = 'Generate New QR';
                    endBtn.disabled = true;
                    renderQr(null);
                }
            }

            function playerMatches(name, team) {
                const q = (searchInput.value || '').trim().toLowerCase();
                if (!q) return true;
                return (name || '').toLowerCase().includes(q) || (team || '').toLowerCase().includes(q);
            }

            function renderPlayers(data) {
                const checked = data.checkedIn || [];
                const waiting = data.waiting || [];
                document.getElementById('checkedTabCount').textContent = checked.length;
                document.getElementById('waitingTabCount').textContent = waiting.length;

                const newIds = [];
                if (!initialLoad) {
                    checked.forEach(function (row) {
                        if (!knownAttendanceIds.has(row.id)) newIds.push(row.id);
                    });
                }

                checkedPanel.innerHTML = '';
                const visibleChecked = checked.filter(row => playerMatches(row.playerName, row.team));
                if (visibleChecked.length === 0) {
                    checkedPanel.innerHTML = '<div class="live-empty"><div><i class="bi bi-person-check fs-2 d-block mb-2"></i>No checked-in players match this view.</div></div>';
                } else {
                    visibleChecked.forEach(function (row) {
                        const item = document.createElement('div');
                        item.className = 'live-player-row' + (newIds.includes(row.id) ? ' new-checkin' : '');
                        const methodClass = row.method === 'Manual' ? ' manual' : '';
                        item.innerHTML =
                            '<div>' +
                                '<div class="live-player-name">' + escapeHtml(row.playerName) + '</div>' +
                                '<div class="live-player-meta">' + escapeHtml(row.team || 'No team') + '</div>' +
                            '</div>' +
                            '<div class="text-sm-end">' +
                                '<div class="live-time"><i class="bi bi-clock me-1"></i>' + escapeHtml(row.checkedInTime) + '</div>' +
                                '<span class="live-method-badge' + methodClass + '">' + escapeHtml(row.method) + '</span>' +
                            '</div>';
                        checkedPanel.appendChild(item);
                    });
                }

                waitingPanel.innerHTML = '';
                const visibleWaiting = waiting.filter(row => playerMatches(row.playerName, row.team));
                if (visibleWaiting.length === 0) {
                    waitingPanel.innerHTML = '<div class="live-empty"><div><i class="bi bi-check2-all fs-2 d-block mb-2"></i>No waiting players match this view.</div></div>';
                } else {
                    visibleWaiting.forEach(function (row) {
                        const item = document.createElement('div');
                        item.className = 'live-player-row';
                        const statusText = row.isMarkedAbsent ? '<span class="badge text-bg-secondary">Marked absent</span>' : '<span class="text-muted small">Waiting to scan</span>';
                        item.innerHTML =
                            '<div>' +
                                '<div class="live-player-name">' + escapeHtml(row.playerName) + '</div>' +
                                '<div class="live-player-meta">' + escapeHtml(row.team || 'No team') + ' · ' + statusText + '</div>' +
                            '</div>' +
                            '<button type="button" class="btn btn-sm btn-outline-success manual-checkin-btn" data-player-id="' + row.playerId + '">' +
                                '<i class="bi bi-person-check me-1"></i> Manual Check-in' +
                            '</button>';
                        waitingPanel.appendChild(item);
                    });
                }

                checked.forEach(row => knownAttendanceIds.add(row.id));
                initialLoad = false;

                document.querySelectorAll('.manual-checkin-btn').forEach(function (button) {
                    button.addEventListener('click', async function () {
                        const playerId = button.getAttribute('data-player-id');
                        button.disabled = true;
                        try {
                            const result = await post('/Attendance/Live/Manual', { eventId: eventId, playerId: playerId });
                            showFeedback(result.message, 'success');
                            await loadStatus();
                        } catch (error) {
                            showFeedback(error.message, 'danger');
                        } finally {
                            button.disabled = false;
                        }
                    });
                });

                if (newIds.length > 0) {
                    window.setTimeout(function () {
                        document.querySelectorAll('.live-player-row.new-checkin').forEach(row => row.classList.remove('new-checkin'));
                    }, 3000);
                }
            }

            function renderFailures(failures) {
                failures = failures || [];
                if (failures.length === 0) {
                    errorsList.innerHTML = '<span class="text-muted">No recent scan errors.</span>';
                    return;
                }

                errorsList.innerHTML = failures.map(function (item) {
                    return '<div class="scan-error-item">' +
                        '<i class="bi bi-exclamation-circle text-warning"></i>' +
                        '<div><strong>' + escapeHtml(item.attemptedAt) + '</strong> · ' + escapeHtml(item.message) + '</div>' +
                    '</div>';
                }).join('');
            }

            function renderStatus(data) {
                currentStatus = data;
                document.getElementById('registeredCount').textContent = data.summary.registered;
                document.getElementById('checkedInCount').textContent = data.summary.checkedIn;
                document.getElementById('remainingCount').textContent = data.summary.remaining;
                document.getElementById('attendanceRate').textContent = data.summary.attendanceRate + '%';
                document.getElementById('sessionEventTitle').textContent = data.eventItem.title;
                renderSession(data.session);
                renderPlayers(data);
                renderFailures(data.recentFailures);
                updateCountdown();
            }

            async function loadStatus() {
                if (polling) return;
                polling = true;
                try {
                    const response = await fetch('/Attendance/Live/Status?eventId=' + encodeURIComponent(eventId), {
                        credentials: 'same-origin',
                        cache: 'no-store'
                    });
                    const payload = await readJson(response);
                    if (!response.ok) throw new Error(payload.message || 'Could not refresh live attendance.');
                    renderStatus(payload);
                } catch (error) {
                    console.warn(error);
                } finally {
                    polling = false;
                }
            }

            generateBtn.addEventListener('click', async function () {
                generateBtn.disabled = true;
                try {
                    const result = await post('/Attendance/Live/Session', { eventId: eventId });
                    sessionStorage.setItem(tokenKey(result.sessionId), result.token);
                    showFeedback(result.message, 'success');
                    await loadStatus();
                } catch (error) {
                    showFeedback(error.message, 'danger');
                } finally {
                    generateBtn.disabled = false;
                }
            });

            endBtn.addEventListener('click', function () {
                if (!currentStatus || !currentStatus.session) return;

                const remaining =
                    currentStatus.summary && Number.isFinite(currentStatus.summary.remaining)
                        ? currentStatus.summary.remaining
                        : 0;

                endRemainingCount.textContent = remaining;
                markAbsent.checked = false;
                endModal.show();
            });

            confirmEndBtn.addEventListener('click', async function () {
                if (!currentStatus || !currentStatus.session) {
                    endModal.hide();
                    return;
                }

                const sessionId = currentStatus.session.id;
                const shouldMarkAbsent = markAbsent.checked;

                confirmEndBtn.disabled = true;
                confirmEndText.textContent = 'Ending...';

                try {
                    const result = await post(
                        '/Attendance/Live/Session/' + sessionId + '/End',
                        {
                            markRemainingAbsent:
                                shouldMarkAbsent ? 'true' : 'false'
                        });

                    sessionStorage.removeItem(tokenKey(sessionId));
                    endModal.hide();
                    showFeedback(result.message, 'success');
                    markAbsent.checked = false;
                    await loadStatus();
                } catch (error) {
                    showFeedback(error.message, 'danger');
                } finally {
                    confirmEndBtn.disabled = false;
                    confirmEndText.textContent = 'End Session';
                }
            });

            endModalElement.addEventListener('hidden.bs.modal', function () {
                markAbsent.checked = false;
                confirmEndBtn.disabled = false;
                confirmEndText.textContent = 'End Session';
            });

            document.querySelectorAll('.live-tab').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('.live-tab').forEach(item => item.classList.remove('active'));
                    tab.classList.add('active');
                    const isChecked = tab.getAttribute('data-tab') === 'checked';
                    checkedPanel.classList.toggle('d-none', !isChecked);
                    waitingPanel.classList.toggle('d-none', isChecked);
                });
            });

            searchInput.addEventListener('input', function () {
                if (currentStatus) renderPlayers(currentStatus);
            });

            const eventPicker = document.getElementById('eventPicker');
            eventPicker.addEventListener('change', function () {
                if (eventPicker.value) {
                    window.location.href = '/Attendance/Live?eventId=' + encodeURIComponent(eventPicker.value);
                }
            });

            countdownTimer = window.setInterval(updateCountdown, 1000);
            loadStatus();
            window.setInterval(loadStatus, 3000);
        })();
    </script>
}
