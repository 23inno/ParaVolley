@model Attendance

<div class="modal fade" id="recordAttendanceModal" tabindex="-1" aria-labelledby="recordAttendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form action="/Attendance/Inline/Record" method="post" class="modal-content border-0 shadow">
            @Html.AntiForgeryToken()

            <div class="modal-header px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold" id="recordAttendanceModalLabel">Record Attendance</h5>
                    <div class="text-muted small mt-1">Add an individual player attendance record.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body px-4 py-4">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="modalPlayerId">Player</label>
                        @Html.DropDownList(
                            "PlayerId",
                            (SelectList)ViewBag.PlayerId,
                            "Select a player",
                            new
                            {
                                @class = "form-select",
                                id = "modalPlayerId",
                                required = "required"
                            })
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="modalEventId">Event</label>
                        @Html.DropDownList(
                            "EventId",
                            (SelectList)ViewBag.EventId,
                            "Select an event",
                            new
                            {
                                @class = "form-select",
                                id = "modalEventId",
                                required = "required"
                            })
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="modalAttendanceDate">Date</label>
                        <input asp-for="Date" id="modalAttendanceDate" class="form-control" type="date" required />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" for="modalAttendanceStatus">Status</label>
                        <select asp-for="Status" id="modalAttendanceStatus" class="form-select" required>
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer px-4 py-3">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-pv px-4">
                    <i class="bi bi-check-lg me-1"></i> Save Record
                </button>
            </div>
        </form>
    </div>
</div>
