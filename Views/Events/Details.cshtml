@model Event
@{
    ViewData["Title"] = "Event Details";
    var canManageEvents = User.IsInRole("Admin") || User.IsInRole("Coach");
    var registrations = ViewBag.EventRegistrations as List<EventRegistration> ?? new List<EventRegistration>();
    var activeRegistrations = registrations
        .Where(r => r.Status == EventRegistrationStatus.Registered)
        .ToList();
}

<div class="topbar">
    <h2 class="page-title">Event Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="pv-card" style="max-width:900px;">
    <h4 class="fw-bold mb-3">@Model.Title</h4>
    <p class="text-muted">@Model.Description</p>

    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Type</dt>
        <dd class="col-sm-8">@Model.Type</dd>

        <dt class="col-sm-4 text-muted">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 text-muted">Date &amp; Time</dt>
        <dd class="col-sm-8">@Model.Date.ToString("MMM d, yyyy") &middot; @Model.Time</dd>

        <dt class="col-sm-4 text-muted">Location</dt>
        <dd class="col-sm-8">@Model.Location</dd>

        <dt class="col-sm-4 text-muted">Participants</dt>
        <dd class="col-sm-8">@Model.Participants</dd>
    </dl>

    @if (canManageEvents)
    {
        <div class="mt-4 pt-4 border-top">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Player Registrations</h5>
                    <div class="text-muted small">Players who registered for this event in the mobile app.</div>
                </div>
                <span class="badge bg-success fs-6">@activeRegistrations.Count registered</span>
            </div>

            @if (!registrations.Any())
            {
                <div class="alert alert-light border mb-0">
                    <i class="bi bi-people me-2"></i>No players have registered for this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Email</th>
                                <th>Team</th>
                                <th>Registered</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var registration in registrations)
                            {
                                <tr>
                                    <td class="fw-semibold">@registration.Player.Name</td>
                                    <td>@registration.Player.Email</td>
                                    <td>@registration.Player.Team</td>
                                    <td>@registration.RegisteredAtUtc.AddHours(2).ToString("dd MMM yyyy HH:mm") SAST</td>
                                    <td>
                                        @if (registration.Status == EventRegistrationStatus.Registered)
                                        {
                                            <span class="badge bg-success">Registered</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Cancelled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        @if (User.IsInRole("Admin") || (User.IsInRole("Coach") && Model.Type == EventType.Practice))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
        }
    </div>
</div>
