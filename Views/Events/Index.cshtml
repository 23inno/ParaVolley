@model IEnumerable<Event>
@{
    ViewData["Title"] = "Events";
    var totalCount = (int)ViewBag.TotalCount;
    var filteredCount = Model.Count();
    var hasActiveFilters = !string.IsNullOrWhiteSpace((string?)ViewBag.SelectedType)
        || !string.IsNullOrWhiteSpace((string?)ViewBag.SelectedStatus);
}

<div class="pm-header-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h2 class="pm-title">Event Management</h2>
            <p class="pm-subtitle"><span id="visibleCount">@filteredCount</span> of @totalCount events</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="search-input-wrap m-0">
                <i class="bi bi-search"></i>
                <input type="text" id="liveSearchInput" class="form-control" placeholder="Search by event name or location..." autocomplete="off" />
            </div>

            <button type="button" id="filterToggleBtn" class="btn btn-filter-toggle @(hasActiveFilters ? "active" : "")">
                <i class="bi bi-funnel"></i> Filter
            </button>

            <a asp-action="Export" id="exportLink" class="btn btn-pm-outline" asp-route-type="@ViewBag.SelectedType" asp-route-status="@ViewBag.SelectedStatus">
                <i class="bi bi-download"></i> Export
            </a>

            <a asp-action="Create" class="btn btn-pm-add js-modal-trigger"><i class="bi bi-plus-lg"></i> Add Event</a>
        </div>
    </div>

    <div id="filterPanel" class="filter-panel @(hasActiveFilters ? "" : "d-none")">
        <form method="get" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label class="d-block">Type</label>
                    <select name="type" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Types</option>
                        <option value="Tournament" selected="@(ViewBag.SelectedType == "Tournament")">Tournament</option>
                        <option value="Practice" selected="@(ViewBag.SelectedType == "Practice")">Practice</option>
                        <option value="Match" selected="@(ViewBag.SelectedType == "Match")">Match</option>
                        <option value="Workshop" selected="@(ViewBag.SelectedType == "Workshop")">Workshop</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="d-block">Status</label>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Status</option>
                        <option value="Upcoming" selected="@(ViewBag.SelectedStatus == "Upcoming")">Upcoming</option>
                        <option value="InProgress" selected="@(ViewBag.SelectedStatus == "InProgress")">In Progress</option>
                        <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <a asp-action="Index" class="filter-reset">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row g-3" id="eventsGrid">
    @foreach (var ev in Model)
    {
        var typePillClass = ev.Type switch
        {
            EventType.Tournament => "em-type-tournament",
            EventType.Practice => "em-type-practice",
            EventType.Match => "em-type-match",
            _ => "em-type-workshop"
        };
        var borderClass = ev.Type switch
        {
            EventType.Tournament => "border-tournament",
            EventType.Practice => "border-practice",
            EventType.Match => "border-match",
            _ => "border-workshop"
        };
        var statusPillClass = ev.Status switch
        {
            EventStatus.Upcoming => "em-status-upcoming",
            EventStatus.InProgress => "em-status-inprogress",
            EventStatus.Completed => "em-status-completed",
            _ => "em-status-cancelled"
        };
        var statusLabel = ev.Status == EventStatus.InProgress ? "In Progress" : ev.Status.ToString();

        <div class="col-md-6 col-lg-4 event-card-col" data-title="@ev.Title.ToLower()" data-location="@ev.Location.ToLower()">
            <div class="em-card @borderClass">
                <div class="em-card-top">
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="em-pill @typePillClass">@ev.Type</span>
                        <span class="em-pill @statusPillClass">@statusLabel</span>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <a asp-action="Edit" asp-route-id="@ev.Id" class="pm-action-icon edit js-modal-trigger" title="Edit"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Delete" asp-route-id="@ev.Id" class="pm-action-icon delete js-modal-trigger" title="Delete"><i class="bi bi-trash"></i></a>
                    </div>
                </div>

                <div class="em-card-title">@ev.Title</div>

                <div class="em-card-meta"><i class="bi bi-calendar3"></i> @ev.Date.ToString("d MMM yyyy") at @ev.Time</div>
                <div class="em-card-meta"><i class="bi bi-geo-alt"></i> @ev.Location</div>
                <div class="em-card-meta mb-3"><i class="bi bi-people"></i> @ev.Participants Participants</div>

                <a asp-action="Details" asp-route-id="@ev.Id" class="btn-view-details js-modal-trigger"><i class="bi bi-eye"></i> View Details</a>
            </div>
        </div>
    }
</div>
<div class="col-12 d-none" id="noResultsMessage"><div class="pv-card text-center text-muted py-4">No events found.</div></div>

<!-- Shared modal used for View / Edit / Delete - content is loaded via AJAX -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="eventModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var toggleBtn = document.getElementById('filterToggleBtn');
            var panel = document.getElementById('filterPanel');
            toggleBtn.addEventListener('click', function () {
                panel.classList.toggle('d-none');
                toggleBtn.classList.toggle('active');
            });

            // ===== Instant, prefix-based client-side search (name OR location) =====
            var searchInput = document.getElementById('liveSearchInput');
            var cards = Array.from(document.querySelectorAll('.event-card-col'));
            var visibleCountEl = document.getElementById('visibleCount');
            var noResultsMessage = document.getElementById('noResultsMessage');

            function applySearch() {
                var query = searchInput.value.trim().toLowerCase();
                var visible = 0;

                cards.forEach(function (card) {
                    var title = card.getAttribute('data-title') || '';
                    var location = card.getAttribute('data-location') || '';
                    var matches = query === '' || title.startsWith(query) || location.startsWith(query);
                    card.style.display = matches ? '' : 'none';
                    if (matches) visible++;
                });

                visibleCountEl.textContent = visible;
                noResultsMessage.classList.toggle('d-none', visible !== 0 || cards.length === 0);
            }

            searchInput.addEventListener('input', applySearch);

            var exportLink = document.getElementById('exportLink');
            var exportBaseHref = exportLink.getAttribute('href');
            searchInput.addEventListener('input', function () {
                var url = new URL(exportBaseHref, window.location.origin);
                if (searchInput.value.trim()) {
                    url.searchParams.set('search', searchInput.value.trim());
                } else {
                    url.searchParams.delete('search');
                }
                exportLink.setAttribute('href', url.pathname + url.search);
            });

            // ===== View / Edit / Delete as an in-page modal card =====
            var modalEl = document.getElementById('eventModal');
            var modalContent = document.getElementById('eventModalContent');
            var bsModal = new bootstrap.Modal(modalEl);

            function loadIntoModal(url) {
                modalContent.innerHTML = '<div class="modal-body text-center py-5"><div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div></div>';
                bsModal.show();
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) { return res.text(); })
                    .then(function (html) { modalContent.innerHTML = html; })
                    .catch(function () {
                        modalContent.innerHTML = '<div class="modal-body"><div class="alert alert-danger mb-0">Could not load that event. Please try again.</div></div>';
                    });
            }

            document.addEventListener('click', function (e) {
                var link = e.target.closest('.js-modal-trigger');
                if (link) {
                    e.preventDefault();
                    loadIntoModal(link.getAttribute('href'));
                }
            });

            document.addEventListener('submit', function (e) {
                var form = e.target.closest('.js-ajax-form');
                if (!form || !modalContent.contains(form)) return;

                e.preventDefault();
                var formData = new FormData(form);

                fetch(form.getAttribute('action') || window.location.href, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                }).then(function (res) {
                    var contentType = res.headers.get('content-type') || '';
                    if (contentType.indexOf('application/json') !== -1) {
                        return res.json().then(function (data) {
                            if (data.success) {
                                bsModal.hide();
                                window.location.reload();
                            }
                        });
                    } else {
                        return res.text().then(function (html) { modalContent.innerHTML = html; });
                    }
                }).catch(function () {
                    modalContent.innerHTML = '<div class="modal-body"><div class="alert alert-danger mb-0">Something went wrong saving. Please try again.</div></div>';
                });
            });
        })();
    </script>
}
