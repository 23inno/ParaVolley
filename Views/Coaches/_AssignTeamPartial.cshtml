@model Coach

@{
    var teams =
        ViewBag.Teams as List<string>
        ?? new List<string>();
}

<div class="coach-modal-card">

    <div class="coach-card-header">

        <div class="d-flex align-items-center gap-3">

            <div class="coach-card-icon">
                <i class="bi bi-person-fill-add"></i>
            </div>

            <div>
                <h4 class="mb-1">
                    Assign Coach
                </h4>

                <p class="mb-0">
                    Choose the team this coach should manage.
                </p>
            </div>

        </div>


        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>

    </div>


    <form asp-action="AssignTeam"
          method="post"
          class="js-ajax-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.Id" />


        <div class="coach-card-body">

            <div class="coach-profile-summary">

                @if (!string.IsNullOrEmpty(Model.AvatarPath))
                {
                    <img src="@Model.AvatarPath"
                         alt="@Model.Name"
                         class="coach-avatar coach-assign-avatar" />
                }
                else
                {
                    var initials =
                    string.Concat(
                    Model.Name
                    .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries)
                    .Select(name => name[0]))
                    .ToUpper();

                    if (initials.Length > 2)
                    {
                        initials =
                        initials.Substring(0, 2);
                    }

                    <div class="coach-avatar coach-assign-avatar">
                        @initials
                    </div>
                }


                <div>

                    <h5 class="mb-1 fw-bold">
                        @Model.Name
                    </h5>

                    <div class="text-muted">
                        @Model.Specialty
                    </div>

                </div>

            </div>


            <div class="coach-form-section mb-0">

                <h6 class="coach-section-title">
                    <i class="bi bi-people"></i>
                    Team Assignment
                </h6>


                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Current Team
                    </label>

                    <div>

                        @if (!string.IsNullOrWhiteSpace(
                                                Model.AssignedTeam))
                        {
                            <span class="team-pill">
                                @Model.AssignedTeam
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Currently unassigned
                            </span>
                        }

                    </div>

                </div>


                <div>

                    <label for="assignedTeam"
                           class="form-label fw-semibold">

                        Assign to Team

                    </label>


                    <select name="assignedTeam"
                            id="assignedTeam"
                            class="form-select">

                        <option value="">
                            Unassigned
                        </option>

                        @foreach (var teamName in teams)
                        {
                            <option value="@teamName"
                                    selected="@(Model.AssignedTeam == teamName)">
                                @teamName
                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>


        <div class="coach-card-footer">

            <button type="button"
                    class="btn btn-outline-secondary"
                    data-bs-dismiss="modal">

                Cancel

            </button>


            <button type="submit"
                    class="btn btn-pv">

                <i class="bi bi-check-lg"></i>
                Save Assignment

            </button>

        </div>

    </form>

</div>