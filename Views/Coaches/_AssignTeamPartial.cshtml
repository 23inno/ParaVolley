@model Coach

<div class="modal-header">
    <h5 class="modal-title fw-bold">Assign Team</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        @if (!string.IsNullOrEmpty(Model.AvatarPath))
        {
            <img src="@Model.AvatarPath" alt="@Model.Name" class="coach-avatar" style="width:52px;height:52px;font-size:1.1rem;object-fit:cover;" />
        }
        else
        {
            <div class="coach-avatar" style="width:52px;height:52px;font-size:1.1rem;">
                @(string.Concat(Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0])).ToUpper())
            </div>
        }
        <div>
            <h5 class="fw-bold mb-0">@Model.Name</h5>
            <div class="text-muted small">@Model.Specialty</div>
        </div>
    </div>

    <form asp-action="AssignTeam" method="post" class="js-ajax-form">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-2">
            <label class="form-label fw-semibold">Current Team</label>
            <p class="mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.AssignedTeam))
                {
                    <span class="team-pill">@Model.AssignedTeam</span>
                }
                else
                {
                    <span class="text-muted">Unassigned</span>
                }
            </p>
        </div>

        <div class="mb-0">
            <label for="assignedTeam" class="form-label fw-semibold">Assign to Team</label>
            <select name="assignedTeam" id="assignedTeam" class="form-select">
                <option value="">Unassigned</option>
                <option value="Team A" selected="@(Model.AssignedTeam == "Team A")">Team A</option>
                <option value="Team B" selected="@(Model.AssignedTeam == "Team B")">Team B</option>
                <option value="Team C" selected="@(Model.AssignedTeam == "Team C")">Team C</option>
                <option value="Team D" selected="@(Model.AssignedTeam == "Team D")">Team D</option>
            </select>
        </div>

        <div class="modal-footer px-0 pb-0 mt-4">
            <button type="submit" class="btn btn-pv"><i class="bi bi-check-lg"></i> Save Assignment</button>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
    </form>
</div>
