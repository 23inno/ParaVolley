@model Coach

@{
    var teams =
        ViewBag.Teams as List<string>
        ?? new List<string>();
}

<div class="coach-modal-card">

    <div class="coach-card-header">
        <div>
            <div class="coach-card-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div>
                <h4 class="mb-1">Add New Coach</h4>
                <p class="mb-0">
                    Add a coach to the ParaVolley management system.
                </p>
            </div>
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>
    </div>


    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data"
          class="js-ajax-form">

        @Html.AntiForgeryToken()

        <div class="coach-card-body">

            <div asp-validation-summary="All"
                 class="alert alert-danger validation-summary-valid"
                 role="alert">
            </div>


            <!-- Profile Photo -->
            <div class="coach-form-section">

                <h6 class="coach-section-title">
                    <i class="bi bi-image"></i>
                    Profile Photo
                </h6>

                <div class="d-flex align-items-center gap-3">

                    <div class="avatar-upload-preview"
                         id="coachAvatarPreview">
                        <span>?</span>
                    </div>

                    <div>
                        <div class="fw-semibold">
                            Coach photo
                        </div>

                        <div class="text-muted small mb-2">
                            JPG, PNG or WebP · Maximum 2 MB
                        </div>

                        <label for="coachPhotoInput"
                               class="btn btn-outline-secondary btn-sm mb-0"
                               style="cursor:pointer;">

                            <i class="bi bi-upload"></i>
                            Choose Photo
                        </label>

                        <input type="file"
                               name="photo"
                               id="coachPhotoInput"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="d-none" />
                    </div>

                </div>

            </div>


            <!-- Personal Details -->
            <div class="coach-form-section">

                <h6 class="coach-section-title">
                    <i class="bi bi-person"></i>
                    Personal Details
                </h6>

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           id="coachNameInput"
                           placeholder="Enter coach full name"
                           required />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               placeholder="coach@example.com"
                               required />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="e.g. 071 234 5678"
                               required />

                        <span asp-validation-for="Phone"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Assignment -->
            <div class="coach-form-section">

                <h6 class="coach-section-title">
                    <i class="bi bi-people"></i>
                    Team Assignment
                </h6>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="AssignedTeam"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="AssignedTeam"
                                class="form-select">

                            <option value="">
                                Unassigned
                            </option>

                            @foreach (var teamName in teams)
                            {
                                <option value="@teamName">
                                    @teamName
                                </option>
                            }

                        </select>

                        <span asp-validation-for="AssignedTeam"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Status"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Available">
                                Available
                            </option>

                            <option value="OnLeave">
                                On Leave
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Coaching Information -->
            <div class="coach-form-section mb-0">

                <h6 class="coach-section-title">
                    <i class="bi bi-award"></i>
                    Coaching Information
                </h6>


                <div class="mb-3">

                    <label asp-for="Specialty"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Specialty"
                           class="form-control"
                           placeholder="e.g. Technical Skills" />

                    <span asp-validation-for="Specialty"
                          class="text-danger small">
                    </span>

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3 mb-md-0">

                        <label asp-for="Experience"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Experience"
                               class="form-control"
                               placeholder="e.g. 8 years" />

                        <span asp-validation-for="Experience"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Certifications"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Certifications"
                               class="form-control"
                               placeholder="e.g. Level 3 Certified" />

                        <span asp-validation-for="Certifications"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="coach-card-footer">

            <button type="button"
                    class="btn btn-outline-secondary"
                    data-bs-dismiss="modal">

                Cancel

            </button>

            <button type="submit"
                    class="btn btn-pv">

                <i class="bi bi-person-plus"></i>
                Add Coach

            </button>

        </div>

    </form>

</div>


<script>
    (function () {

        var photoInput =
            document.getElementById('coachPhotoInput');

        var preview =
            document.getElementById('coachAvatarPreview');

        var nameInput =
            document.getElementById('coachNameInput');


        function updateInitials() {

            if (!nameInput || !preview) {
                return;
            }

            var parts =
                nameInput.value
                    .trim()
                    .split(/\s+/)
                    .filter(Boolean);

            var initials =
                parts
                    .map(function (part) {
                        return part[0];
                    })
                    .join('')
                    .toUpperCase()
                    .substring(0, 2);

            preview.innerHTML =
                '<span>' +
                (initials || '?') +
                '</span>';
        }


        if (nameInput) {

            nameInput.addEventListener(
                'input',
                function () {

                    if (!photoInput ||
                        !photoInput.files ||
                        !photoInput.files[0]) {

                        updateInitials();
                    }
                });
        }


        if (photoInput) {

            photoInput.addEventListener(
                'change',
                function () {

                    if (photoInput.files &&
                        photoInput.files[0]) {

                        var reader =
                            new FileReader();

                        reader.onload =
                            function (event) {

                                preview.innerHTML =
                                    '<img src="' +
                                    event.target.result +
                                    '" alt="Coach photo preview" />';
                            };

                        reader.readAsDataURL(
                            photoInput.files[0]);
                    }
                });
        }


        updateInitials();

    })();
</script>