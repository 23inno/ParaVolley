@model Coach

<div class="modal-header">
    <h5 class="modal-title fw-bold">Add Coach</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="js-ajax-form">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="avatar-upload-preview" id="coachAvatarPreview"><span>?</span></div>
            <div>
                <div class="fw-bold">Profile Photo</div>
                <div class="text-muted small mb-2">JPG, PNG or WebP</div>
                <label for="coachPhotoInput" class="btn btn-outline-secondary btn-sm mb-0" style="cursor:pointer;">
                    <i class="bi bi-upload"></i> Choose Photo
                </label>
                <input type="file" name="photo" id="coachPhotoInput" accept=".jpg,.jpeg,.png,.webp" class="d-none" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" id="coachNameInput" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Phone" class="form-label fw-semibold"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="AssignedTeam" class="form-label fw-semibold"></label>
                <select asp-for="AssignedTeam" class="form-select">
                    <option value="">Unassigned</option>
                    <option value="Team A">Team A</option>
                    <option value="Team B">Team B</option>
                    <option value="Team C">Team C</option>
                    <option value="Team D">Team D</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Available">Available</option>
                    <option value="OnLeave">On Leave</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Specialty" class="form-label fw-semibold"></label>
            <input asp-for="Specialty" class="form-control" placeholder="e.g. Attack Strategy" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Experience" class="form-label fw-semibold"></label>
                <input asp-for="Experience" class="form-control" placeholder="e.g. 8 years" />
            </div>
            <div class="col-md-6 mb-0">
                <label asp-for="Certifications" class="form-label fw-semibold"></label>
                <input asp-for="Certifications" class="form-control" placeholder="e.g. Level 3 Certified" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-pv"><i class="bi bi-check-lg"></i> Save Coach</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>

<script>
    (function () {
        var photoInput = document.getElementById('coachPhotoInput');
        var preview = document.getElementById('coachAvatarPreview');
        var nameInput = document.getElementById('coachNameInput');

        function updateInitials() {
            var parts = nameInput.value.trim().split(/\s+/).filter(Boolean);
            var initials = parts.map(function (p) { return p[0]; }).join('').toUpperCase().substring(0, 2);
            preview.innerHTML = '<span>' + (initials || '?') + '</span>';
        }

        nameInput.addEventListener('input', function () {
            if (!photoInput.files || !photoInput.files[0]) updateInitials();
        });

        photoInput.addEventListener('change', function () {
            if (photoInput.files && photoInput.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Preview" />';
                };
                reader.readAsDataURL(photoInput.files[0]);
            }
        });

        updateInitials();
    })();
</script>
