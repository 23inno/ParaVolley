@model IEnumerable<Coach>
@{
    ViewData["Title"] = "Coaches";
    var totalCount = (int)ViewBag.TotalCount;
    var filteredCount = (int)ViewBag.FilteredCount;
    var hasActiveFilters = !string.IsNullOrWhiteSpace((string?)ViewBag.SelectedTeam)
        || !string.IsNullOrWhiteSpace((string?)ViewBag.SelectedStatus);

    var teams =
ViewBag.Teams as List<string>
?? new List<string>();
}

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-title">Total Coaches</span>
                <div class="icon-box icon-box-green"><i class="bi bi-person-gear"></i></div>
            </div>
            <div class="value">@ViewBag.TotalCount</div>
            <div class="change">Professional staff</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-title">Active Coaches</span>
                <div class="icon-box icon-box-gold"><i class="bi bi-check-circle-fill"></i></div>
            </div>
            <div class="value">@ViewBag.ActiveCount</div>
            <div class="change">Currently coaching</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-title">Teams Assigned</span>
                <div class="icon-box icon-box-blue"><i class="bi bi-people-fill"></i></div>
            </div>
            <div class="value">@ViewBag.TeamsAssignedCount</div>
            <div class="change">Team coverage</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-top">
                <span class="stat-title">Available</span>
                <div class="icon-box icon-box-purple"><i class="bi bi-person-plus-fill"></i></div>
            </div>
            <div class="value">@ViewBag.AvailableCount</div>
            <div class="change">Ready to assign</div>
        </div>
    </div>
</div>

<div class="pm-header-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h2 class="pm-title">Coach Management</h2>
            <p class="pm-subtitle"><span id="visibleCount">@filteredCount</span> of @totalCount coaches</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <form method="get"
                  id="searchForm"
                  class="search-input-wrap m-0">

                <input type="hidden"
                       name="team"
                       value="@ViewBag.SelectedTeam" />

                <input type="hidden"
                       name="status"
                       value="@ViewBag.SelectedStatus" />

                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search coaches..."
                       autocomplete="off" />
            </form>

            <button type="button" id="filterToggleBtn" class="btn btn-filter-toggle @(hasActiveFilters ? "active" : "")">
                <i class="bi bi-funnel"></i> Filter
            </button>

            <a asp-action="Export"
               class="btn btn-pm-outline"
               asp-route-search="@ViewBag.Search"
               asp-route-team="@ViewBag.SelectedTeam"
               asp-route-status="@ViewBag.SelectedStatus">
                <i class="bi bi-download"></i> Export
            </a>

            <a asp-action="Create"
               class="btn btn-pm-add-gold js-modal-trigger">

                <i class="bi bi-plus-lg"></i>
                Add Coach

            </a>
        </div>
    </div>

    <div id="filterPanel" class="filter-panel @(hasActiveFilters ? "" : "d-none")">
        <form method="get" id="filterForm">
            <input type="hidden"
                   name="search"
                   value="@ViewBag.Search" />

            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label class="d-block">Team</label>
                    <select name="team"
                            class="form-select"
                            onchange="document.getElementById('filterForm').submit()">

                        <option value="">All Teams</option>

                        @foreach (var teamName in teams)
                        {
                            <option value="@teamName"
                                    selected="@(ViewBag.SelectedTeam == teamName)">
                                @teamName
                            </option>
                        }

                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="d-block">Status</label>
                    <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Status</option>
                        <option value="Active" selected="@(ViewBag.SelectedStatus == "Active")">Active</option>
                        <option value="Available" selected="@(ViewBag.SelectedStatus == "Available")">Available</option>
                        <option value="OnLeave" selected="@(ViewBag.SelectedStatus == "OnLeave")">On Leave</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <a asp-action="Index" class="filter-reset">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="pm-table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Coach</th>
                    <th>Contact</th>
                    <th>Specialty</th>
                    <th>Team</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coach in Model)
                {
                    var initials = string.Concat(coach.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Select(n => n[0])).ToUpper();
                    if (initials.Length > 2) { initials = initials.Substring(0, 2); }

                    var statusClass = coach.Status == CoachStatus.Active ? "active" : "inactive";

                    <tr class="coach-row" data-name="@coach.Name.ToLower()" data-specialty="@coach.Specialty.ToLower()">
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(coach.AvatarPath))
                                {
                                    <img src="@coach.AvatarPath" alt="@coach.Name" class="coach-avatar" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="coach-avatar">@initials</div>
                                }
                                <div>
                                    <div class="pm-player-name">@coach.Name</div>
                                    <div class="coach-cert-sub"><i class="bi bi-patch-check"></i> @coach.Certifications</div>
                                </div>
                            </div>
                        </td>
                        <td class="contact-cell">
                            <div><i class="bi bi-telephone"></i> @coach.Phone</div>
                            <div><i class="bi bi-envelope"></i> @coach.Email</div>
                        </td>
                        <td>
                            <div class="pm-player-name">@coach.Specialty</div>
                            <div class="coach-cert-sub">@coach.Experience experience</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(coach.AssignedTeam))
                            {
                                <span class="team-pill">@coach.AssignedTeam</span>
                            }
                            else
                            {
                                <span class="text-muted small">Unassigned</span>
                            }
                        </td>
                        <td>
                            <span class="status-pill @statusClass">@coach.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@coach.Id" class="pm-action-icon view js-modal-trigger" title="View"><i class="bi bi-eye"></i></a>
                            <a asp-action="AssignTeam"
                               asp-route-id="@coach.Id"
                               class="pm-action-icon assign js-modal-trigger"
                               title="Assign Team">

                                <i class="bi bi-person-fill-add"></i>

                            </a>
                            <a asp-action="Edit" asp-route-id="@coach.Id" class="pm-action-icon edit js-modal-trigger" title="Edit"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@coach.Id" class="pm-action-icon delete js-modal-trigger" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No coaches found.</td></tr>
                }
                <tr id="noCoachResults" class="d-none">
                    <td colspan="6" class="text-center text-muted py-4">No coaches found.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Shared modal used for Add Coach / View / Edit / Delete / Assign Team -->
<div class="modal fade" id="coachModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="coachModalContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-success" role="status"><span class="visually-hidden">Loading...</span></div>
            </div>
        </div>
    </div>
</div>

<partial name="_Pagination" />

@section Scripts {
    <script>
        (function () {

            // =========================================================
            // COACH MODAL
            // Add Coach / View / Edit / Delete / Assign Team
            // =========================================================

            var modalEl =
                document.getElementById('coachModal');

            var modalContent =
                document.getElementById('coachModalContent');

            var coachModal = null;

            if (modalEl && modalContent) {
                coachModal =
                    bootstrap.Modal.getOrCreateInstance(modalEl);
            }


            function showLoading() {
                modalContent.innerHTML =
                    '<div class="modal-body text-center py-5">' +
                    '<div class="spinner-border text-success" role="status">' +
                    '<span class="visually-hidden">Loading...</span>' +
                    '</div>' +
                    '</div>';
            }


            function showModalError(message) {
                modalContent.innerHTML =
                    '<div class="modal-body">' +
                    '<div class="alert alert-danger mb-0">' +
                    message +
                    '</div>' +
                    '</div>';
            }


            async function loadCoachModal(url) {

                if (!modalEl ||
                    !modalContent ||
                    !coachModal) {
                    return;
                }

                showLoading();

                coachModal.show();

                try {

                    var response =
                        await fetch(url, {
                            method: 'GET',
                            headers: {
                                'X-Requested-With':
                                    'XMLHttpRequest'
                            }
                        });


                    if (!response.ok) {
                        throw new Error(
                            'Unable to load coach form.');
                    }


                    var html =
                        await response.text();


                    modalContent.innerHTML =
                        html;

                }
                catch (error) {

                    console.error(error);

                    showModalError(
                        'Could not load the coach form. Please try again.');
                }
            }


            // Intercept all coach modal links
            document.addEventListener(
                'click',
                function (event) {

                    var link =
                        event.target.closest(
                            '.js-modal-trigger');

                    if (!link) {
                        return;
                    }

                    event.preventDefault();
                    event.stopPropagation();

                    var url =
                        link.getAttribute('href');

                    if (!url) {
                        return;
                    }

                    loadCoachModal(url);
                });


            // Handle all forms loaded inside the modal
            document.addEventListener(
                'submit',
                async function (event) {

                    var form =
                        event.target.closest(
                            '.js-ajax-form');

                    if (!form ||
                        !modalContent ||
                        !modalContent.contains(form)) {
                        return;
                    }


                    event.preventDefault();


                    var submitButton =
                        form.querySelector(
                            'button[type="submit"]');

                    var originalButtonHtml =
                        submitButton
                            ? submitButton.innerHTML
                            : '';


                    if (submitButton) {
                        submitButton.disabled = true;

                        submitButton.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-2"></span>' +
                            'Saving...';
                    }


                    try {

                        var formData =
                            new FormData(form);


                        var response =
                            await fetch(
                                form.getAttribute('action')
                                    || window.location.href,
                                {
                                    method: 'POST',

                                    headers: {
                                        'X-Requested-With':
                                            'XMLHttpRequest'
                                    },

                                    body: formData
                                });


                        var contentType =
                            response.headers.get(
                                'content-type') || '';


                        // Successful create/edit/delete/assign
                        if (contentType.includes(
                            'application/json')) {

                            var data =
                                await response.json();


                            if (data.success) {

                                coachModal.hide();

                                window.location.reload();

                                return;
                            }
                        }


                        // Validation failed:
                        // server returned the partial again
                        var html =
                            await response.text();


                        modalContent.innerHTML =
                            html;

                    }
                    catch (error) {

                        console.error(error);

                        showModalError(
                            'Something went wrong while saving. Please try again.');
                    }
                    finally {

                        if (submitButton &&
                            document.body.contains(
                                submitButton)) {

                            submitButton.disabled =
                                false;

                            submitButton.innerHTML =
                                originalButtonHtml;
                        }
                    }
                });


            // =========================================================
            // FILTER PANEL
            // =========================================================

            var toggleBtn =
                document.getElementById(
                    'filterToggleBtn');

            var filterPanel =
                document.getElementById(
                    'filterPanel');


            if (toggleBtn && filterPanel) {

                toggleBtn.addEventListener(
                    'click',
                    function () {

                        filterPanel.classList.toggle(
                            'd-none');

                        toggleBtn.classList.toggle(
                            'active');
                    });
            }


            // =========================================================
            // SERVER-SIDE COACH SEARCH
            // =========================================================

            var searchForm =
                document.getElementById(
                    'searchForm');

            var searchInput =
                document.querySelector(
                    '#searchForm input[name="search"]');

            var searchTimer;


            if (searchForm && searchInput) {

                searchInput.addEventListener(
                    'input',
                    function () {

                        clearTimeout(
                            searchTimer);


                        searchTimer =
                            setTimeout(
                                function () {

                                    searchForm.submit();

                                },
                                1200);
                    });
            }

        })();
    </script>
}