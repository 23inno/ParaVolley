@model Coach
@{
    ViewData["Title"] = "Coach Profile";
}

<div class="topbar">
    <h2 class="page-title">Coach Profile</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="pv-card" style="max-width:600px;">
    <h4 class="fw-bold mb-3">@Model.Name</h4>
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Specialty</dt>
        <dd class="col-sm-8">@Model.Specialty</dd>

        <dt class="col-sm-4 text-muted">Assigned Team</dt>
        <dd class="col-sm-8">@(Model.AssignedTeam ?? "—")</dd>

        <dt class="col-sm-4 text-muted">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 text-muted">Experience</dt>
        <dd class="col-sm-8">@Model.Experience</dd>

        <dt class="col-sm-4 text-muted">Certifications</dt>
        <dd class="col-sm-8">@Model.Certifications</dd>

        <dt class="col-sm-4 text-muted">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4 text-muted">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>
    </dl>

    <div class="mt-4 pt-3 border-top d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-pv"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>
