@model Coach

<div class="modal-header">
    <h5 class="modal-title fw-bold">Edit Coach</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="js-ajax-form">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="avatar-upload-preview" id="coachAvatarPreview">
                @if (!string.IsNullOrEmpty(Model.AvatarPath))
                {
                    <img src="@Model.AvatarPath" alt="Preview" id="coachAvatarImg" />
                }
                else
                {
                    <span id="coachAvatarInitials">@(string.Concat(Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0])).ToUpper())</span>
                }
            </div>
            <div>
                <div class="fw-bold">Profile Photo</div>
                <div class="text-muted small mb-2">JPG, PNG or WebP</div>
                <div class="d-flex gap-2">
                    <label for="coachPhotoInput" class="btn btn-outline-secondary btn-sm mb-0" style="cursor:pointer;">
                        <i class="bi bi-upload"></i> Change Photo
                    </label>
                    @if (!string.IsNullOrEmpty(Model.AvatarPath))
                    {
                        <button type="button" id="removePhotoBtn" class="btn btn-outline-danger btn-sm">Remove</button>
                    }
                </div>
                <input type="file" name="photo" id="coachPhotoInput" accept=".jpg,.jpeg,.png,.webp" class="d-none" />
                <input type="hidden" name="removePhoto" id="removePhotoInput" value="false" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" id="coachNameInput" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Phone" class="form-label fw-semibold"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="AssignedTeam" class="form-label fw-semibold"></label>
                <select asp-for="AssignedTeam" class="form-select">
                    <option value="">Unassigned</option>
                    <option value="Team A">Team A</option>
                    <option value="Team B">Team B</option>
                    <option value="Team C">Team C</option>
                    <option value="Team D">Team D</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Available">Available</option>
                    <option value="OnLeave">On Leave</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Specialty" class="form-label fw-semibold"></label>
            <input asp-for="Specialty" class="form-control" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Experience" class="form-label fw-semibold"></label>
                <input asp-for="Experience" class="form-control" />
            </div>
            <div class="col-md-6 mb-0">
                <label asp-for="Certifications" class="form-label fw-semibold"></label>
                <input asp-for="Certifications" class="form-control" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-pv"><i class="bi bi-check-lg"></i> Save Changes</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>

<script>
    (function () {
        var photoInput = document.getElementById('coachPhotoInput');
        var preview = document.getElementById('coachAvatarPreview');
        var removeBtn = document.getElementById('removePhotoBtn');
        var removeInput = document.getElementById('removePhotoInput');

        photoInput.addEventListener('change', function () {
            if (photoInput.files && photoInput.files[0]) {
                removeInput.value = 'false';
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.innerHTML = '<img src="' + e.target.result + '" alt="Preview" />';
                };
                reader.readAsDataURL(photoInput.files[0]);
            }
        });

        if (removeBtn) {
            removeBtn.addEventListener('click', function () {
                removeInput.value = 'true';
                photoInput.value = '';
                var parts = document.getElementById('coachNameInput').value.trim().split(/\s+/).filter(Boolean);
                var initials = parts.map(function (p) { return p[0]; }).join('').toUpperCase().substring(0, 2);
                preview.innerHTML = '<span>' + (initials || '?') + '</span>';
                removeBtn.remove();
            });
        }
    })();
</script>
