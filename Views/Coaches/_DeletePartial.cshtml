@model Coach

<div class="modal-header">
    <h5 class="modal-title fw-bold">Delete Coach</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this coach? This cannot be undone.</div>

    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>
        <dt class="col-sm-4 text-muted">Specialty</dt>
        <dd class="col-sm-8">@Model.Specialty</dd>
        <dt class="col-sm-4 text-muted">Assigned Team</dt>
        <dd class="col-sm-8">@(Model.AssignedTeam ?? "—")</dd>
    </dl>
</div>
<form asp-action="Delete" method="post" class="js-ajax-form">
    <input type="hidden" asp-for="Id" />
    <div class="modal-footer">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
