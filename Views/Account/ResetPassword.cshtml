@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card" style="max-width:520px; min-height:auto;">
        <div class="login-right" style="flex:1 1 100%;">
            <div class="login-welcome-title">Set a New Password</div>
            <p class="login-welcome-sub">Choose a new password for your account.</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />

                <label asp-for="NewPassword" class="login-field-label"></label>
                <div class="login-input-wrap">
                    <i class="bi bi-lock field-icon"></i>
                    <input asp-for="NewPassword" class="form-control" placeholder="At least 8 characters" />
                </div>

                <label asp-for="ConfirmPassword" class="login-field-label"></label>
                <div class="login-input-wrap">
                    <i class="bi bi-lock field-icon"></i>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat new password" />
                </div>

                <button type="submit" class="btn-sign-in mt-2">Reset Password <i class="bi bi-arrow-right"></i></button>
            </form>
        </div>
    </div>
</div>
