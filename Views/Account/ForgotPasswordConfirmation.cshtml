@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card"
         style="max-width:560px; min-height:auto;">
        <div class="login-right text-center"
             style="flex:1 1 100%;">

            <div class="login-logo-badge mx-auto"
                 style="background:var(--pv-green);">
                <i class="bi bi-envelope-check-fill text-white"></i>
            </div>

            <div class="login-welcome-title mt-3">
                Reset Link Requested
            </div>

            <div class="alert alert-success text-start mt-3"
                 role="status">
                <div class="d-flex gap-2">
                    <i class="bi bi-check-circle-fill mt-1"></i>
                    <div>
                        <strong>Check your email.</strong>
                        <div class="mt-1">
                            @ViewBag.Message
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border text-start">
                <div class="small">
                    <strong>Didn't see it?</strong>
                    <div class="text-muted mt-1">
                        Check your Spam or Junk folder and allow a few minutes
                        for email delivery.
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                <a asp-action="ForgotPassword"
                   class="btn btn-outline-secondary">
                    Send Another Link
                </a>

                <a asp-action="Login"
                   class="btn-sign-in d-inline-flex justify-content-center"
                   style="width:auto; padding-left:1.5rem; padding-right:1.5rem;">
                    Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
