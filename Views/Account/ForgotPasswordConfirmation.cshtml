@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card" style="max-width:520px; min-height:auto;">
        <div class="login-right text-center" style="flex:1 1 100%;">
            <div class="login-logo-badge mx-auto" style="background:var(--pv-green);">
                <i class="bi bi-envelope-check-fill text-white"></i>
            </div>
            <div class="login-welcome-title mt-3">Check Your Email</div>
            <p class="login-welcome-sub">@ViewBag.Message</p>

            @if (ViewBag.DemoResetUrl != null)
            {
                <div class="alert alert-warning text-start small">
                    <strong>Demo mode:</strong> no SMTP server is configured for this app (see <code>appsettings.json</code> &gt; <code>EmailSettings</code>), so here's the reset link directly instead of emailing it:
                    <br />
                    <a href="@ViewBag.DemoResetUrl">@ViewBag.DemoResetUrl</a>
                </div>
            }

            <a asp-action="Login" class="btn-sign-in d-inline-flex justify-content-center mt-3" style="width:auto; padding-left:1.5rem; padding-right:1.5rem;">Back to Sign In</a>
        </div>
    </div>
</div>
