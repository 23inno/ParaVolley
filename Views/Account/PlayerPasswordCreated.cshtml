@{
    ViewData["Title"] = "Player App Password Created";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card" style="max-width:560px; min-height:auto;">
        <div class="login-right text-center" style="flex:1 1 100%;">
            <div class="login-logo-badge mx-auto"
                 style="background:var(--pv-green);">
                <i class="bi bi-check-circle-fill text-white"></i>
            </div>

            <div class="login-welcome-title mt-3">
                Your Player App Password Is Ready
            </div>

            <p class="login-welcome-sub">
                Your ParaVolley Player App login has been activated successfully.
            </p>

            <div class="alert alert-success text-start">
                <div class="mb-2">
                    <strong>Login email:</strong>
                    @ViewBag.PlayerEmail
                </div>
                <div>
                    Open the ParaVolley Android app and sign in using
                    this email address and the password you just created.
                </div>
            </div>

            <p class="text-muted small mb-0">
                If you forget your password later, use
                <strong>Forgot Password</strong> on the Player App login screen.
            </p>
        </div>
    </div>
</div>
