@{
    var isCoach = string.Equals(
        ViewBag.SetupRole as string,
        "Coach",
        StringComparison.OrdinalIgnoreCase);

    var accountLabel = isCoach ? "Coach Portal" : "Player App";

    ViewData["Title"] = $"{accountLabel} Password Created";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card" style="max-width:560px; min-height:auto;">
        <div class="login-right text-center" style="flex:1 1 100%;">
            <div class="login-logo-badge mx-auto"
                 style="background:var(--pv-green);">
                <i class="bi bi-check-circle-fill text-white"></i>
            </div>

            <div class="login-welcome-title mt-3">
                Your @accountLabel Password Is Ready
            </div>

            <p class="login-welcome-sub">
                Your ParaVolley @accountLabel login has been activated successfully.
            </p>

            <div class="alert alert-success text-start">
                <div class="mb-2">
                    <strong>Login:</strong>
                    @ViewBag.LoginIdentifier
                </div>
                <div>
                    Sign in using the phone number or email above and the password you just created.
                </div>
            </div>

            <p class="text-muted small mb-0">
                If you use a phone-only account and forget your password,
                ask a ParaVolley administrator to resend a secure reset link
                on WhatsApp. If your account has an email address, you can
                also use <strong>Forgot Password</strong>.
            </p>
        </div>
    </div>
</div>
