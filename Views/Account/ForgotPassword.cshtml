@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card" style="max-width:520px; min-height:auto;">
        <div class="login-right" style="flex:1 1 100%;">
            <div class="login-welcome-title">Forgot Password?</div>
            <p class="login-welcome-sub">Enter your account email and we'll send you a link to reset your password.</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["Error"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  id="forgotPasswordForm">
                <label class="login-field-label">Email Address</label>
                <div class="login-input-wrap">
                    <i class="bi bi-envelope field-icon"></i>
                    <input type="email"
                           name="email"
                           id="forgotPasswordEmail"
                           class="form-control"
                           placeholder="name@example.com"
                           autocomplete="email"
                           required />
                </div>

                <div id="forgotPasswordSending"
                     class="alert alert-info d-none mt-3 mb-2"
                     role="status"
                     aria-live="polite">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spinner-border spinner-border-sm"
                              aria-hidden="true"></span>
                        <span>
                            Sending your reset link. This can take a few seconds...
                        </span>
                    </div>
                </div>

                <button type="submit"
                        id="forgotPasswordSubmit"
                        class="btn-sign-in mt-2">
                    <span id="forgotPasswordSubmitText">Send Reset Link</span>
                    <i class="bi bi-arrow-right"
                       id="forgotPasswordSubmitIcon"></i>
                </button>
            </form>

            <div class="login-divider">or</div>
            <p class="login-help-text mb-0"><a asp-action="Login">Back to Sign In</a></p>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form =
                document.getElementById('forgotPasswordForm');

            var submitButton =
                document.getElementById('forgotPasswordSubmit');

            var submitText =
                document.getElementById('forgotPasswordSubmitText');

            var submitIcon =
                document.getElementById('forgotPasswordSubmitIcon');

            var sendingMessage =
                document.getElementById('forgotPasswordSending');

            if (!form ||
                !submitButton ||
                !submitText ||
                !sendingMessage) {
                return;
            }

            form.addEventListener('submit', function () {
                if (!form.checkValidity()) {
                    return;
                }

                submitButton.disabled = true;
                submitButton.setAttribute('aria-disabled', 'true');
                submitText.textContent = 'Sending Reset Link...';

                if (submitIcon) {
                    submitIcon.className =
                        'spinner-border spinner-border-sm ms-2';
                }

                sendingMessage.classList.remove('d-none');
            });
        });
    </script>
}
