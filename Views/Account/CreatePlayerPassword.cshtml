@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Create Player App Password";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card" style="max-width:560px; min-height:auto;">
        <div class="login-right" style="flex:1 1 100%;">
            <div class="login-logo-badge mx-auto"
                 style="background:var(--pv-green);">
                <i class="bi bi-shield-lock-fill text-white"></i>
            </div>

            <div class="login-welcome-title text-center mt-3">
                Create Your Player App Password
            </div>

            <p class="login-welcome-sub text-center">
                Your ParaVolley player registration has been approved.
                Create a password to activate access to the Android Player App.
            </p>

            @if (ViewBag.SetupError != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewBag.SetupError
                </div>

                <div class="text-center">
                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="btn-sign-in d-inline-flex justify-content-center"
                       style="width:auto; padding-left:1.5rem; padding-right:1.5rem;">
                        Request a New Password Link
                    </a>
                </div>
            }
            else
            {
                @if (ViewBag.PlayerEmail != null)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Player App login email:
                        <strong>@ViewBag.PlayerEmail</strong>
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <form asp-controller="Account"
                      asp-action="CreatePlayerPassword"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Token" />

                    <label asp-for="NewPassword"
                           class="login-field-label">
                    </label>

                    <div class="login-input-wrap">
                        <i class="bi bi-lock field-icon"></i>
                        <input asp-for="NewPassword"
                               class="form-control"
                               placeholder="At least 8 characters"
                               autocomplete="new-password" />
                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger small">
                    </span>

                    <label asp-for="ConfirmPassword"
                           class="login-field-label">
                    </label>

                    <div class="login-input-wrap">
                        <i class="bi bi-lock-fill field-icon"></i>
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Repeat your password"
                               autocomplete="new-password" />
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger small">
                    </span>

                    <button type="submit"
                            class="btn-sign-in mt-3">
                        Create Player App Password
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <p class="text-muted small mt-3 mb-0">
                    After creating your password, open the ParaVolley Player App
                    and sign in with your email address and this password.
                </p>
            }
        </div>
    </div>
</div>
