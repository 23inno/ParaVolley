@model LoginViewModel
@using SportsManagementMVC.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";

    var org = await Db.OrganisationSettings.FirstOrDefaultAsync()
              ?? new OrganisationSettings();

    var adminProfile = await Db.UserProfiles.FirstOrDefaultAsync();

    var orgWords = org.OrganisationName.Split(' ', 2);
    var orgFirstWord = orgWords.Length > 0
        ? orgWords[0]
        : "ParaVolley";

    var orgRest = orgWords.Length > 1
        ? orgWords[1]
        : "Mpumalanga";

    var adminEmail =
        adminProfile?.Email
        ?? "paravolleympumalanga@gmail.com";
}


<section class="pv-login-page">

    <!-- Decorative background shapes -->
    <div class="pv-login-bg-shape pv-login-bg-shape-one"></div>
    <div class="pv-login-bg-shape pv-login-bg-shape-two"></div>


    <div class="container">

        <div class="pv-login-wrapper">


            <!-- =========================================
                 LEFT BRAND PANEL
            ========================================== -->
            <div class="pv-login-brand">

                <div class="pv-login-brand-content">


                    <!-- Logo -->
                    <div class="pv-login-logo-box">

                        @if (!string.IsNullOrWhiteSpace(org.LogoPath))
                        {
                            <img src="@org.LogoPath"
                                 alt="@org.OrganisationName Logo"
                                 class="pv-login-logo" />
                        }
                        else
                        {
                            <img src="~/images/paravolley-logo.png"
                                 asp-append-version="true"
                                 alt="ParaVolley Mpumalanga Logo"
                                 class="pv-login-logo" />
                        }

                    </div>


                    <!-- Organisation -->
                    <div class="pv-login-brand-name">

                        <h2>
                            @orgFirstWord
                        </h2>

                        <span>
                            @orgRest
                        </span>

                    </div>


                    <p class="pv-login-brand-description">

                        Empowering athletes, building champions.
                        Your inclusive ParaVolley platform for sport,
                        development and competitive excellence.

                    </p>


                    <!-- Features -->
                    <div class="pv-login-features">

                        <div class="pv-login-feature">
                            <span></span>
                            Athlete &amp; Player Development
                        </div>

                        <div class="pv-login-feature">
                            <span></span>
                            Match Scheduling &amp; Results
                        </div>

                        <div class="pv-login-feature">
                            <span></span>
                            Events &amp; Training Opportunities
                        </div>

                        <div class="pv-login-feature">
                            <span></span>
                            News &amp; Announcements
                        </div>

                    </div>


                    <div class="pv-login-brand-footer">

                        &copy; @DateTime.Now.Year @org.OrganisationName.
                        All rights reserved.

                    </div>

                </div>

            </div>



            <!-- =========================================
                 RIGHT LOGIN PANEL
            ========================================== -->
            <div class="pv-login-form-panel">

                <div class="pv-login-form-content">


                    <!-- Heading -->
                    <div class="pv-login-heading">

                        <span class="pv-login-small-label">
                            PARAVOLLEY MPUMALANGA
                        </span>

                        <h1>
                            Welcome Back
                        </h1>

                        <p>
                            Sign in to access your ParaVolley account.
                        </p>

                    </div>



                    <!-- =================================
                         REAL VALIDATION SUMMARY
                    ================================== -->
                    <div asp-validation-summary="ModelOnly"
                         class="pv-login-message pv-login-error"
                         role="alert">
                    </div>



                    <!-- =================================
                         REAL LOGIN FORM
                    ================================== -->
                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Preserve return URL -->
                        <input type="hidden"
                               asp-for="ReturnUrl" />


                        <!-- EMAIL -->
                        <div class="pv-login-field">

                            <label asp-for="Email">
                                Email Address
                            </label>

                            <div class="pv-login-input">

                                <i class="bi bi-envelope"></i>

                                <input asp-for="Email"
                                       type="email"
                                       placeholder="name@example.com"
                                       autocomplete="username"
                                       required />

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>



                        <!-- PASSWORD -->
                        <div class="pv-login-field">

                            <label asp-for="Password">
                                Password
                            </label>

                            <div class="pv-login-input pv-password-input">

                                <i class="bi bi-lock"></i>

                                <input asp-for="Password"
                                       id="loginPassword"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       required />

                                <button type="button"
                                        id="togglePasswordBtn"
                                        class="pv-password-toggle"
                                        aria-label="Show password">

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>



                        <!-- OPTIONS -->
                        <div class="pv-login-options">

                            <div class="pv-login-remember">

                                <input asp-for="RememberMe"
                                       class="form-check-input" />

                                <label asp-for="RememberMe">
                                    Remember me
                                </label>

                            </div>


                            <a asp-controller="Account"
                               asp-action="ForgotPassword"
                               class="pv-login-forgot">

                                Forgot Password?

                            </a>

                        </div>



                        <!-- SIGN IN -->
                        <button type="submit"
                                class="pv-login-submit">

                            <span>
                                Sign In
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>



                    <!-- =================================
                         HELP
                    ================================== -->
                    <div class="pv-login-divider">

                        <span></span>

                        <small>
                            Need help?
                        </small>

                        <span></span>

                    </div>


                    <div class="pv-login-support">

                        <p>
                            Contact ParaVolley Mpumalanga for account assistance.
                        </p>

                        <a href="mailto:paravolleympumalanga@gmail.com">

                            <i class="bi bi-envelope-fill"></i>

                            paravolleympumalanga@gmail.com

                        </a>

                    </div>



                    <!-- =================================
                         JOIN US
                    ================================== -->
                    <div class="pv-login-register">

                        <p>
                            Not registered as an athlete yet?
                        </p>

                        <a asp-controller="Home"
                           asp-action="Join">

                            <i class="bi bi-person-plus-fill"></i>

                            Register / Join Us

                        </a>

                    </div>



                    <!-- =================================
                         LEGAL / SUPPORT LINKS
                    ================================== -->
                    <div class="login-footer-links mt-4">

                        <a asp-controller="Account"
                           asp-action="Privacy">
                            Privacy Policy
                        </a>

                        &nbsp;&middot;&nbsp;

                        <a asp-controller="Account"
                           asp-action="Terms">
                            Terms of Service
                        </a>

                        &nbsp;&middot;&nbsp;

                        <a asp-controller="Account"
                           asp-action="Support">
                            Support
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



@section Scripts
{
    <!-- Keep ASP.NET Core client-side validation -->
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            var toggleButton =
                document.getElementById('togglePasswordBtn');

            var passwordInput =
                document.getElementById('loginPassword');

            if (!toggleButton || !passwordInput) {
                return;
            }

            toggleButton.addEventListener('click', function () {

                var icon = this.querySelector('i');

                if (passwordInput.type === 'password') {

                    passwordInput.type = 'text';

                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');

                    this.setAttribute(
                        'aria-label',
                        'Hide password'
                    );

                }
                else {

                    passwordInput.type = 'password';

                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');

                    this.setAttribute(
                        'aria-label',
                        'Show password'
                    );

                }

            });

        });

    </script>
}